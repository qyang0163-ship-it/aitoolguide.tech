---
import Layout from '../../layouts/Layout.astro';
const chips = (await import('../../data/chips.json')).default;
const categories = ['全部', 'MCU', 'AI芯片', '电源', '无线', '模拟'];
const levels = ['全部', 'P2P', '功能替代'];
const priceRanges = ['全部', '<¥10', '¥10-50', '>¥50'];
---
<Layout title="芯片替代库 | 国产替代指南" description="筛选国产替代芯片，支持按类别、替代级别、价格区间筛选。">
<div class="max-w-7xl mx-auto px-4 py-8">
<nav class="breadcrumb mb-4"><a href="/">首页</a> / <span>芯片库</span></nav>
<h1 class="text-3xl font-bold text-slate-900 mb-2">芯片替代库</h1>
<p class="text-slate-500 mb-6">{chips.length} 款国产替代方案</p>
<!-- 类别快速导航 -->
<div class="flex flex-wrap gap-2 mb-6">
{categories.map((cat, i) => (
<button class={`px-4 py-2 rounded-lg text-sm font-medium transition-colors ${i===0?'bg-[#0F4C81] text-white':'bg-slate-100 text-slate-600 hover:bg-slate-200'}`}>{cat}</button>
))}
</div>
<!-- 搜索与筛选 -->
<div class="bg-white rounded-xl p-4 mb-6 border border-slate-100">
<div class="relative mb-4">
<svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
<input type="text" id="searchInput" placeholder="输入型号搜索，如 STM32F103C8T6" class="w-full pl-12 pr-4 py-3 rounded-lg bg-slate-50 border-0 focus:outline-none focus:ring-2 focus:ring-[#0F4C81]/20">
</div>
<div class="flex flex-wrap gap-4 text-sm">
<div class="flex items-center gap-2">
<span class="text-slate-500">替代级别</span>
<select class="bg-slate-50 rounded-lg px-3 py-2 border-0 focus:outline-none focus:ring-2 focus:ring-[#0F4C81]/20">
{levels.map(l => <option>{l}</option>)}
</select>
</div>
<div class="flex items-center gap-2">
<span class="text-slate-500">价格区间</span>
<select class="bg-slate-50 rounded-lg px-3 py-2 border-0 focus:outline-none focus:ring-2 focus:ring-[#0F4C81]/20">
{priceRanges.map(p => <option>{p}</option>)}
</select>
</div>
<div class="flex items-center gap-2 text-slate-500">
<span>找到</span>
<span class="font-bold text-[#0F4C81]">{chips.length}</span>
<span>款芯片</span>
</div>
</div>
</div>
<!-- 芯片卡片矩阵 -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
{chips.map(chip => (
<a href={`/chip/${chip.id}`} class="bg-white rounded-xl p-5 hover:shadow-lg transition-shadow border border-slate-100">
<div class="flex justify-between items-start mb-3">
<div class="w-10 h-10 rounded-lg bg-gradient-to-br from-[#0F4C81] to-[#2B6CB0] flex items-center justify-center text-white font-bold text-sm">
{chip.manufacturer.slice(0,2)}
</div>
<span class={`text-xs px-2 py-1 rounded-full ${chip.substituteLevel==='pin2pin'?'bg-green-100 text-green-700':'bg-blue-100 text-blue-700'}`}>
{chip.substituteLevel==='pin2pin'?'P2P':'功能替代'}
</span>
</div>
<h3 class="font-bold text-lg text-slate-800 mb-1">{chip.name}</h3>
<p class="text-sm text-slate-500 mb-2">{chip.manufacturer}</p>
<p class="text-xs text-slate-400 mb-3">替代 {chip.originalEquivalent}</p>
<div class="flex justify-between items-center">
<span class="text-[#E48736] font-bold text-lg">{chip.price}</span>
</div>
</a>
))}
</div>
</div>
</Layout>