---
import Layout from '../../layouts/Layout.astro';
const chips = (await import('../../data/chips.json')).default;
---
<Layout title="国产芯片替代库 | 20+款P2P兼容芯片参数对比" description="收录20+款国产替代芯片，涵盖MCU、电源、接口等品类，提供引脚兼容比对、技术手册下载。" keywords="国产替代,芯片选型,P2P兼容,STM32替代,国产MCU">
<div class="max-w-7xl mx-auto px-4 py-8">
<nav class="breadcrumb mb-6"><a href="/">首页</a> / <span>芯片库</span></nav>
<div class="mb-10">
<h1 class="text-4xl font-bold text-slate-900 mb-4">国产芯片替代库</h1>
<p class="text-slate-600 text-lg">收录{chips.length}款国产替代芯片，涵盖MCU、电源、接口、传感器等品类。</p>
</div>
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
<div class="card text-center"><p class="text-3xl font-bold text-[#0F4C81]">{chips.length}</p><p class="text-slate-500 text-sm">收录芯片</p></div>
<div class="card text-center"><p class="text-3xl font-bold text-[#0F4C81]">{chips.filter(c => c.processNode === '成熟制程').length}</p><p class="text-slate-500 text-sm">成熟制程</p></div>
<div class="card text-center"><p class="text-3xl font-bold text-[#0F4C81]">{chips.filter(c => c.substituteLevel === 'pin2pin').length}</p><p class="text-slate-500 text-sm">P2P兼容</p></div>
<div class="card text-center"><p class="text-3xl font-bold text-[#E48736]">100%</p><p class="text-slate-500 text-sm">免费手册</p></div>
</div>
<div class="mb-8">
<input type="text" placeholder="搜索芯片型号、替代目标、厂商..." class="search-input w-full" />
</div>
<div class="flex gap-3 mb-8 flex-wrap">
<button class="px-4 py-2 bg-[#0F4C81] text-white rounded-full text-sm font-medium">全部</button>
<button class="px-4 py-2 bg-white border border-slate-200 text-slate-600 rounded-full text-sm">MCU</button>
<button class="px-4 py-2 bg-white border border-slate-200 text-slate-600 rounded-full text-sm">电源</button>
<button class="px-4 py-2 bg-white border border-slate-200 text-slate-600 rounded-full text-sm">模拟</button>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
{chips.map(chip => (
<a href={`/chip/${chip.id}`} class="card block hover:shadow-lg transition-shadow">
<div class="flex justify-between items-start mb-3">
<div>
<h2 class="text-xl font-bold text-slate-800">{chip.name}</h2>
<p class="text-sm text-slate-500">替代 {chip.originalEquivalent}</p>
</div>
<span class="badge badge-green">{chip.substituteLevel === 'pin2pin' ? 'P2P' : '功能'}</span>
</div>
<div class="flex gap-2 mb-4 flex-wrap">
{Object.entries(chip.specs).slice(0,3).map(([k,v]) => (
<span class="text-xs text-slate-600 bg-slate-50 border border-slate-100 px-2 py-1 rounded">{k}: {v}</span>
))}
</div>
<div class="flex justify-between items-center pt-4 border-t border-slate-100">
<span class="text-[#E48736] font-bold text-lg">{chip.price}</span>
<span class="text-slate-400 text-sm">{chip.manufacturer}</span>
</div>
<div class="mt-3 text-xs text-slate-400">制程: {chip.processNode}</div>
</a>
))}
</div>
<div class="mt-12 text-center">
<p class="text-slate-500 mb-4">没有找到需要的芯片？</p>
<a href="/contact" class="btn-primary">提交替代需求</a>
</div>
</div>
</Layout>