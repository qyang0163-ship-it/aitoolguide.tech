---
import Layout from '../../layouts/Layout.astro';
const chips = (await import('../../data/chips.json')).default;
// 为芯片推断类别
const chipsWithCategory = chips.map(c => {
  const name = c.name.toLowerCase();
  const specs = JSON.stringify(c.specs).toLowerCase();
  let category = 'MCU';
  if (name.includes('esp') || name.includes('bl') || name.includes('beken') || specs.includes('wi-fi') || specs.includes('蓝牙')) {
    category = '无线';
  } else if (name.includes('sgm') || name.includes('ht') || specs.includes('ldo') || specs.includes('dc-dc') || specs.includes('降压')) {
    category = '电源';
  } else if (specs.includes('afe') || specs.includes('mux') || specs.includes('开关')) {
    category = '模拟';
  }
  // 解析价格数值
  const priceNum = parseFloat(c.price.replace('¥', ''));
  return { ...c, category, priceNum };
});
const q = Astro.url.searchParams.get('search')||'';
---
<Layout title="国产芯片替代库 | 筛选与搜索" description="所有国产替代芯片列表，支持类别、替代级别、价格区间筛选">
<div class="max-w-7xl mx-auto px-4 py-8">
<h1 class="text-4xl font-bold mb-2">芯片替代库</h1><p class="text-slate-600 mb-4">共 {chips.length} 款</p>

<!-- 搜索与筛选栏 -->
<div class="card mb-6">
  <div class="flex flex-col md:flex-row gap-4">
    <input type="text" id="searchInput" placeholder="搜索型号..." class="search-input flex-1" value={q}>
    <select id="categoryFilter" class="px-4 py-2 border border-slate-200 rounded-lg text-sm">
      <option value="all">全部类别</option>
      <option value="MCU">MCU</option>
      <option value="电源">电源</option>
      <option value="无线">无线</option>
      <option value="模拟">模拟</option>
    </select>
    <select id="levelFilter" class="px-4 py-2 border border-slate-200 rounded-lg text-sm">
      <option value="all">全部级别</option>
      <option value="pin2pin">Pin2Pin</option>
      <option value="functional">功能替代</option>
    </select>
    <select id="priceFilter" class="px-4 py-2 border border-slate-200 rounded-lg text-sm">
      <option value="all">全部价格</option>
      <option value="under2">&lt;2元</option>
      <option value="2to10">2-10元</option>
      <option value="over10">&gt;10元</option>
    </select>
  </div>
  <p class="text-xs text-slate-400 mt-3">显示 <span id="showCount">{chips.length}</span> / {chips.length} 款芯片</p>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="chipGrid">
{chipsWithCategory.map(chip => (
  <a href={`/chip/${chip.id}`} class="card block chip-card" data-category={chip.category} data-level={chip.substituteLevel} data-price={chip.priceNum}>
    <div class="flex justify-between">
      <h2 class="font-bold text-lg">{chip.name}</h2>
      <span class="badge badge-blue">{chip.substituteLevel==='pin2pin'?'P2P':'功能'}</span>
    </div>
    <p class="text-sm text-slate-500">替代 {chip.originalEquivalent}</p>
    <div class="mt-2 flex gap-2">
      <span class="text-xs bg-slate-100 px-2 py-0.5 rounded">{chip.category}</span>
      <span class="text-xs bg-slate-100 px-2 py-0.5 rounded">{chip.processNode}</span>
    </div>
    <div class="mt-3 flex justify-between">
      <span class="text-[#E48736] font-bold">{chip.price}</span>
      <span class="text-xs text-slate-400">{chip.manufacturer}</span>
    </div>
  </a>
))}
</div>

<div id="noResults" class="hidden text-center py-12">
  <p class="text-slate-500">没有找到符合条件的芯片</p>
  <button onclick="resetFilters()" class="btn-secondary mt-4">重置筛选</button>
</div>
</div>

<script is:inline>
  const chipsData = {chipsWithCategory};
  const searchInput = document.getElementById('searchInput');
  const categoryFilter = document.getElementById('categoryFilter');
  const levelFilter = document.getElementById('levelFilter');
  const priceFilter = document.getElementById('priceFilter');
  const chipGrid = document.getElementById('chipGrid');
  const showCount = document.getElementById('showCount');
  const noResults = document.getElementById('noResults');
  
  function filterChips() {
    const searchTerm = searchInput.value.toLowerCase();
    const category = categoryFilter.value;
    const level = levelFilter.value;
    const price = priceFilter.value;
    
    const cards = chipGrid.querySelectorAll('.chip-card');
    let visibleCount = 0;
    
    cards.forEach(card => {
      const cardCategory = card.dataset.category;
      const cardLevel = card.dataset.level;
      const cardPrice = parseFloat(card.dataset.price);
      const cardText = card.textContent.toLowerCase();
      
      const matchesSearch = cardText.includes(searchTerm);
      const matchesCategory = category === 'all' || cardCategory === category;
      const matchesLevel = level === 'all' || cardLevel === level;
      let matchesPrice = true;
      if (price === 'under2') matchesPrice = cardPrice < 2;
      else if (price === '2to10') matchesPrice = cardPrice >= 2 && cardPrice <= 10;
      else if (price === 'over10') matchesPrice = cardPrice > 10;
      
      if (matchesSearch && matchesCategory && matchesLevel && matchesPrice) {
        card.style.display = 'block';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });
    
    showCount.textContent = visibleCount;
    noResults.classList.toggle('hidden', visibleCount > 0);
  }
  
  function resetFilters() {
    searchInput.value = '';
    categoryFilter.value = 'all';
    levelFilter.value = 'all';
    priceFilter.value = 'all';
    filterChips();
  }
  
  searchInput.addEventListener('input', filterChips);
  categoryFilter.addEventListener('change', filterChips);
  levelFilter.addEventListener('change', filterChips);
  priceFilter.addEventListener('change', filterChips);
  
  // 初始化
  filterChips();
</script>
</Layout>