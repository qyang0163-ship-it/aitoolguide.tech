---
import Layout from '../../layouts/Layout.astro';
const chips = (await import('../../data/chips.json')).default;
const q = Astro.url.searchParams.get('search')||'';
---
<Layout title="芯片替代库" description="筛选国产替代芯片">
<div class="max-w-7xl mx-auto px-4 py-8">
<h1 class="text-4xl font-bold mb-2">芯片库</h1>
<p class="text-slate-600 mb-4">{chips.length} 款</p>
<div class="flex flex-wrap gap-4 mb-6">
 <input type="text" placeholder="搜索型号..." class="search-input" value={q} oninput="window.location.search='?search='+this.value">
 <select id="cat" class="border rounded px-4 py-2" onchange="filter()"><option value="all">全部类别</option><option>MCU</option><option>电源</option><option>无线</option><option>模拟</option></select>
 <select id="lev" class="border rounded px-4 py-2" onchange="filter()"><option value="all">全部级别</option><option value="pin2pin">P2P</option><option value="functional">功能</option></select>
 <select id="prc" class="border rounded px-4 py-2" onchange="filter()"><option value="all">全部价格</option><option value="0-2">&lt;¥2</option><option value="2-10">¥2-10</option><option value="10+">&gt;¥10</option></select>
</div>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="grid">
 {chips.map(chip=>(<a href={`/chip/${chip.id}`} class="card chip-card" data-cat={chip.specs['内核']?.includes('Cortex')?'MCU':chip.specs['类型']?.includes('DC-DC')?'电源':chip.specs['Wi-Fi']?'无线':'模拟'} data-lev={chip.substituteLevel} data-prc={parseFloat(chip.price.replace('¥',''))}><div class="flex justify-between"><h2 class="font-bold">{chip.name}</h2><span class="badge badge-blue">{chip.substituteLevel==='pin2pin'?'P2P':'功能'}</span></div><p class="text-sm">替代 {chip.originalEquivalent}</p><div class="mt-3 flex justify-between"><span class="text-[#E48736] font-bold">{chip.price}</span><span class="text-xs text-slate-400">{chip.manufacturer}</span></div></a>))}
</div>
</div>
<script>
function filter(){
 const c=document.getElementById('cat').value,l=document.getElementById('lev').value,p=document.getElementById('prc').value;
 document.querySelectorAll('.chip-card').forEach(el=>{
 let show=true;
 if(c!=='all'&&el.dataset.cat!==c)show=false;
 if(l!=='all'&&el.dataset.lev!==l)show=false;
 if(p!=='all'){const v=parseFloat(el.dataset.prc);if(p==='0-2'&&v>=2)show=false;if(p==='2-10'&&(v<2||v>=10))show=false;if(p==='10+'&&v<10)show=false;}
 el.style.display=show?'block':'none';
 })
}
</script>
</Layout>