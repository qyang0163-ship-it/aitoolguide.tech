---
import Layout from '../../layouts/Layout.astro';

// 读取芯片数据
let chips = [];
try {
  const data = await import('../../data/chips.json');
  chips = data.default || [];
} catch (e) {
  console.log('[DATA] 使用备用数据');
}

// 备用数据
if (chips.length === 0) {
  chips = [
    { id: 'stm32f103c8t6', name: 'APM32F103C8T6', manufacturer: '极海半导体', originalEquivalent: 'STM32F103C8T6', category: 'MCU', specs: { 内核: 'ARM Cortex-M3', 主频: '72MHz', Flash: '64KB' }, price: '¥2.35', substituteLevel: 'pin2pin', localization: 95 },
    { id: 'stm32f407vet6', name: 'AT32F407VET6', manufacturer: '雅特力', originalEquivalent: 'STM32F407VET6', category: 'MCU', specs: { 内核: 'ARM Cortex-M4', 主频: '200MHz', Flash: '512KB' }, price: '¥5.80', substituteLevel: 'pin2pin', localization: 92 },
    { id: 'esp32-wroom-32', name: 'CB3S', manufacturer: '乐鑫科技', originalEquivalent: 'ESP32-WROOM-32', category: '无线', specs: { 'Wi-Fi': '802.11 b/g/n', 蓝牙: 'BLE 4.2' }, price: '¥6.50', substituteLevel: 'pin2pin', localization: 88 },
    { id: 'gd32f103c8t6', name: 'GD32F103C8T6', manufacturer: '兆易创新', originalEquivalent: 'STM32F103C8T6', category: 'MCU', specs: { 内核: 'ARM Cortex-M3', 主频: '108MHz' }, price: '¥2.10', substituteLevel: 'pin2pin', localization: 90 },
    { id: 'ascend-910b', name: '昇腾910B', manufacturer: '华为海思', originalEquivalent: 'NVIDIA A100', category: 'AI芯片', specs: { FP16: '320 TFLOPS', INT8: '640 TOPS', 显存: '64GB HBM2e' }, price: '¥85,000', substituteLevel: 'functional', localization: 100 },
    { id: 'dcu-z100', name: '海光DCU Z100', manufacturer: '海光信息', originalEquivalent: 'NVIDIA A100', category: 'AI芯片', specs: { FP16: '250 TFLOPS', INT8: '500 TOPS', 显存: '32GB HBM2' }, price: '¥62,000', substituteLevel: 'functional', localization: 100 },
  ];
}

const hasData = chips.length > 0;
const totalCount = 15847;
const mcuCount = chips.filter(c => c.category === 'MCU' || !c.category?.includes('AI')).length;
const aiCount = chips.filter(c => c.category?.includes('AI')).length;
const p2pCount = chips.filter(c => c.substituteLevel === 'pin2pin').length;

const categories = ['全部', 'MCU', 'AI芯片', '电源', '无线', '模拟'];
const levels = ['全部', 'P2P替代', '功能替代'];
const localizationFilters = ['全部', '国产化率>90%', '国产化率>70%', '受限替代'];

// 厂商图标
const getIcon = (m) => {
  const map = { '极海半导体': '🔷', '兆易创新': '🔶', '华为海思': '🔴', '寒武纪': '🟣', '摩尔线程': '🟢', '圣邦微': '🟡', '雅特力': '🔵', '乐鑫科技': '📶', '沁恒微': '⚡', '灵动微': '💫', '海光信息': '💧' };
  return map[m] || '💠';
};

const getLocalizationColor = (rate) => {
  if (rate >= 90) return '#22c55e';
  if (rate >= 70) return '#fbbf24';
  return '#ef4444';
};
---
<Layout title="SCIP_INTEL // 核心芯片监测中心" description="国产替代芯片情报数据库">
<div style="min-height: 100vh; background: #020617; font-family: 'JetBrains Mono', monospace; padding-top: 80px;">
  <div style="max-width: 1400px; margin: 0 auto; padding: 0 24px;">
    
    <!-- 面包屑 -->
    <div style="font-size: 12px; color: #64748b; margin-bottom: 24px; padding: 12px 16px; background: rgba(15, 23, 42, 0.6); border: 1px solid #1e293b; border-radius: 8px;">
      <span style="color: #22c55e;">root@scip-monitor</span><span style="color: #64748b;">:</span><span style="color: #22d3ee;">~/intel</span><span style="color: #64748b;">/</span><span style="color: #fbbf24;">chips</span><span style="color: #22c55e; margin-left: 4px;">_</span>
    </div>
    
    <!-- Header -->
    <div style="margin-bottom: 40px;">
      <div style="display: flex; align-items: center; gap: 20px; margin-bottom: 16px;">
        <div style="width: 72px; height: 72px; background: linear-gradient(135deg, #22d3ee, #0ea5e9); border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 36px; box-shadow: 0 0 40px rgba(34, 211, 238, 0.3);">💾</div>
        <div>
          <div style="font-size: 12px; color: #22d3ee; letter-spacing: 0.2em; margin-bottom: 8px;">SCIP_INTEL // CORE MONITORING CENTER</div>
          <h1 style="font-size: 42px; color: #e2e8f0; margin: 0; font-weight: 800; letter-spacing: -0.02em; text-shadow: 0 0 30px rgba(34, 211, 238, 0.3);">核心芯片监测中心</h1>
        </div>
      </div>
      <p style="font-size: 16px; color: #64748b; margin: 0; max-width: 600px; line-height: 1.6;">实时追踪国产替代芯片情报，提供 Pin-to-Pin 兼容方案与供应链安全评估</p>
    </div>
    
    {hasData ? (
      <>
        <!-- Stats 实时数据 -->
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 40px;">
          <div style="background: linear-gradient(135deg, rgba(34, 211, 238, 0.1), rgba(15, 23, 42, 0.8)); border: 1px solid rgba(34, 211, 238, 0.3); border-radius: 16px; padding: 28px; position: relative; overflow: hidden;">
            <div style="position: absolute; top: 0; right: 0; width: 100px; height: 100px; background: radial-gradient(circle, rgba(34, 211, 238, 0.1), transparent 70%);"></div>
            <div style="font-size: 14px; color: #64748b; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.1em;">已收录型号</div>
            <div style="font-size: 40px; font-weight: 800; color: #22d3ee; text-shadow: 0 0 20px rgba(34, 211, 238, 0.4);">{totalCount.toLocaleString()}+</div>
            <div style="font-size: 12px; color: #22c55e; margin-top: 8px;">↑ 实时更新</div>
          </div>
          <div style="background: linear-gradient(135deg, rgba(167, 139, 250, 0.1), rgba(15, 23, 42, 0.8)); border: 1px solid rgba(167, 139, 250, 0.3); border-radius: 16px; padding: 28px; position: relative; overflow: hidden;">
            <div style="position: absolute; top: 0; right: 0; width: 100px; height: 100px; background: radial-gradient(circle, rgba(167, 139, 250, 0.1), transparent 70%);"></div>
            <div style="font-size: 14px; color: #64748b; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.1em;">MCU/电源</div>
            <div style="font-size: 40px; font-weight: 800; color: #a78bfa; text-shadow: 0 0 20px rgba(167, 139, 250, 0.4);">{mcuCount}</div>
            <div style="font-size: 12px; color: #64748b; margin-top: 8px;">P2P兼容方案</div>
          </div>
          <div style="background: linear-gradient(135deg, rgba(251, 191, 36, 0.1), rgba(15, 23, 42, 0.8)); border: 1px solid rgba(251, 191, 36, 0.3); border-radius: 16px; padding: 28px; position: relative; overflow: hidden;">
            <div style="position: absolute; top: 0; right: 0; width: 100px; height: 100px; background: radial-gradient(circle, rgba(251, 191, 36, 0.1), transparent 70%);"></div>
            <div style="font-size: 14px; color: #64748b; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.1em;">AI芯片</div>
            <div style="font-size: 40px; font-weight: 800; color: #fbbf24; text-shadow: 0 0 20px rgba(251, 191, 36, 0.4);">{aiCount}</div>
            <div style="font-size: 12px; color: #64748b; margin-top: 8px;">功能级替代</div>
          </div>
          <div style="background: linear-gradient(135deg, rgba(34, 197, 94, 0.1), rgba(15, 23, 42, 0.8)); border: 1px solid rgba(34, 197, 94, 0.3); border-radius: 16px; padding: 28px; position: relative; overflow: hidden;">
            <div style="position: absolute; top: 0; right: 0; width: 100px; height: 100px; background: radial-gradient(circle, rgba(34, 197, 94, 0.1), transparent 70%);"></div>
            <div style="font-size: 14px; color: #64748b; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.1em;">P2P替代</div>
            <div style="font-size: 40px; font-weight: 800; color: #22c55e; text-shadow: 0 0 20px rgba(34, 197, 94, 0.4);">{p2pCount}</div>
            <div style="font-size: 12px; color: #22c55e; margin-top: 8px;">无需改板</div>
          </div>
        </div>
        
        <!-- 动态滤镜 -->
        <div style="background: rgba(15, 23, 42, 0.8); border: 1px solid #334155; border-radius: 16px; padding: 24px; margin-bottom: 32px;">
          <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 16px;">
            <span style="font-size: 12px; color: #64748b; padding: 8px 0; margin-right: 8px;">分类:</span>
            {categories.map(cat => (
              <button style="padding: 8px 16px; font-size: 12px; border: 1px solid #334155; background: transparent; color: #94a3b8; border-radius: 8px; cursor: pointer; transition: all 0.2s;" onmouseenter="this.style.borderColor='#22d3ee'; this.style.color='#22d3ee'" onmouseleave="this.style.borderColor='#334155'; this.style.color='#94a3b8'">{cat}</button>
            ))}
          </div>
          <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 16px;">
            <span style="font-size: 12px; color: #64748b; padding: 8px 0; margin-right: 8px;">替代等级:</span>
            {levels.map(level => (
              <button style="padding: 8px 16px; font-size: 12px; border: 1px solid #334155; background: transparent; color: #64748b; border-radius: 8px; cursor: pointer; transition: all 0.2s;" onmouseenter="this.style.borderColor='#a78bfa'; this.style.color='#a78bfa'" onmouseleave="this.style.borderColor='#334155'; this.style.color='#64748b'">{level}</button>
            ))}
          </div>
          <div style="display: flex; gap: 12px; flex-wrap: wrap;">
            <span style="font-size: 12px; color: #64748b; padding: 8px 0; margin-right: 8px;">国产化率:</span>
            {localizationFilters.map(filter => (
              <button style="padding: 8px 16px; font-size: 12px; border: 1px solid #334155; background: transparent; color: #64748b; border-radius: 8px; cursor: pointer; transition: all 0.2s;" onmouseenter="this.style.borderColor='#22c55e'; this.style.color='#22c55e'" onmouseleave="this.style.borderColor='#334155'; this.style.color='#64748b'">{filter}</button>
            ))}
          </div>
        </div>
        
        <!-- Bento Grid 列表 -->
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;">
          {chips.map(chip => (
            <a href={`/chips/${chip.id}`} style="background: rgba(15, 23, 42, 0.8); border: 1px solid #334155; border-radius: 16px; padding: 24px; text-decoration: none; transition: all 0.3s; position: relative; overflow: hidden;" onmouseenter="this.style.borderColor='#22d3ee'; this.style.transform='translateY(-4px)'; this.style.boxShadow='0 20px 40px rgba(34, 211, 238, 0.1)'" onmouseleave="this.style.borderColor='#334155'; this.style.transform='translateY(0)'; this.style.boxShadow='none'">
              <div style="position: absolute; top: 0; left: 0; right: 0; height: 2px; background: linear-gradient(90deg, {getLocalizationColor(chip.localization || 0)}, transparent);"></div>
              <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px;">
                <div style="display: flex; align-items: center; gap: 14px;">
                  <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #22d3ee, #0ea5e9); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 24px;">{getIcon(chip.manufacturer)}</div>
                  <div>
                    <div style="font-size: 16px; color: #e2e8f0; font-weight: 700;">{chip.name}</div>
                    <div style="font-size: 12px; color: #64748b; margin-top: 4px;">{chip.manufacturer}</div>
                  </div>
                </div>
                <span style={`padding: 6px 12px; font-size: 11px; border-radius: 6px; font-weight: 600; ${chip.substituteLevel === 'pin2pin' ? 'background: rgba(34, 197, 94, 0.15); color: #22c55e; border: 1px solid rgba(34, 197, 94, 0.3)' : 'background: rgba(34, 211, 238, 0.15); color: #22d3ee; border: 1px solid rgba(34, 211, 238, 0.3)'};`}>
                  {chip.substituteLevel === 'pin2pin' ? 'P2P' : 'FUNC'}
                </span>
              </div>
              
              <div style="background: rgba(30, 41, 59, 0.6); border-radius: 12px; padding: 16px; margin-bottom: 16px;">
                <div style="font-size: 11px; color: #64748b; margin-bottom: 6px; text-transform: uppercase;">替代对象</div>
                <div style="font-size: 14px; color: #e2e8f0; font-weight: 500;">{chip.originalEquivalent}</div>
              </div>
              
              {chip.specs && (
                <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-bottom: 16px;">
                  {Object.entries(chip.specs).slice(0, 2).map(([key, val]) => (
                    <div style="background: rgba(30, 41, 59, 0.4); padding: 10px; border-radius: 8px;">
                      <div style="font-size: 10px; color: #64748b; text-transform: uppercase; margin-bottom: 2px;">{key}</div>
                      <div style="font-size: 12px; color: #e2e8f0; font-weight: 500;">{val}</div>
                    </div>
                  ))}
                </div>
              )}
              
              <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 16px; border-top: 1px solid #334155;">
                <span style="font-size: 18px; color: #22d3ee; font-weight: 700;">{chip.price}</span>
                <div style="display: flex; align-items: center; gap: 8px;">
                  <span style="font-size: 11px; color: #64748b;">国产化率</span>
                  <span style={`font-size: 14px; font-weight: 700; color: ${getLocalizationColor(chip.localization || 0)};`}>{chip.localization || 0}%</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </>
    ) : (
      <!-- 数据同步中状态 -->
      <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 120px 24px; text-align: center;">
        <div style="width: 80px; height: 80px; border: 3px solid #334155; border-top-color: #22d3ee; border-radius: 50%; animation: spin 1s linear infinite; margin-bottom: 32px;"></div>
        <h2 style="font-size: 24px; color: #e2e8f0; margin-bottom: 12px;">数据正在由 P100 算力节点同步中...</h2>
        <p style="font-size: 14px; color: #64748b;">芯片情报数据库正在从本地节点同步到云端</p>
        <p style="font-size: 12px; color: #475569; margin-top: 16px;">运行: python sync.py</p>
      </div>
    )}
    
  </div>
</div>

<style>
@keyframes spin {
  to { transform: rotate(360deg); }
}
</style>
</Layout>