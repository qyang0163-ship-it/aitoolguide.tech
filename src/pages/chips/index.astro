---
import Layout from '../../layouts/Layout.astro';
const chips = (await import('../../data/chips.json')).default;
const q = Astro.url.searchParams.get('search')||'';
const filtered = q?chips.filter(c=>c.name.includes(q)||c.originalEquivalent.includes(q)):chips;
---
<Layout title="国产芯片替代库" description="所有国产替代芯片列表">
<div class="max-w-7xl mx-auto px-4 py-8">
<h1 class="text-4xl font-bold mb-2">芯片替代库</h1><p class="text-slate-600 mb-4">共 {chips.length} 款</p>
<input type="text" placeholder="搜索型号..." class="search-input mb-8" value={q} oninput="window.location.search='?search='+this.value">
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
{filtered.map(chip=>(<a href={`/chip/${chip.id}`} class="card block"><div class="flex justify-between"><h2 class="font-bold text-lg">{chip.name}</h2><span class="badge badge-blue">{chip.substituteLevel==='pin2pin'?'P2P':'功能'}</span></div><p class="text-sm text-slate-500">替代 {chip.originalEquivalent}</p><div class="mt-3 flex justify-between"><span class="text-[#E48736] font-bold">{chip.price}</span><span class="text-xs text-slate-400">{chip.manufacturer}</span></div></a>))}
</div></div>
</Layout>