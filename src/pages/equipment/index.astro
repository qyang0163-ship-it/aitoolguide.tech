---
import Layout from '../../layouts/Layout.astro';

// 读取设备数据 - 优先使用项目内数据
let equipment = [];
try {
  const data = await import('../../data/equipment.json');
  equipment = data.default || [];
} catch (e) {
  console.log('[DATA] 使用备用数据');
}

// 备用数据
if (equipment.length === 0) {
  equipment = [
    { id: 'naura-nmc508', name: '北方华创 NMC508 刻蚀机', manufacturer: '北方华创', category: '刻蚀设备', specs: { 工艺节点: '7nm', 产能: '120wph' }, price: '¥2,800万', status: '量产' },
    { id: 'amec-ccp', name: '中微 CCP 刻蚀机', manufacturer: '中微公司', category: '刻蚀设备', specs: { 工艺节点: '5nm', 均匀性: '±1.5%' }, price: '¥3,200万', status: '量产' },
    { id: 'piotech-pecvd', name: '拓荆 PECVD Pro', manufacturer: '拓荆科技', category: '薄膜沉积', specs: { 工艺节点: '7nm', 均匀性: '±1%' }, price: '¥2,500万', status: '量产' },
    { id: 'sme-ssx600', name: '上海微 SSX600 光刻机', manufacturer: '上海微电子', category: '光刻设备', specs: { 分辨率: '90nm', 套刻精度: '≤8nm' }, price: '¥1,500万', status: '量产' },
    { id: 'kingsemi-track', name: '芯源微 涂胶显影机', manufacturer: '芯源微', category: '涂胶显影', specs: { 产能: '200wph', 均匀性: '±1%' }, price: '¥800万', status: '量产' },
    { id: 'tyst-implanter', name: '拓荆 离子注入机', manufacturer: '拓荆科技', category: '离子注入', specs: { 能量范围: '0.2-400keV', 剂量精度: '±0.5%' }, price: '¥1,200万', status: '量产' },
  ];
}

const hasData = equipment.length > 0;
const categories = ['全部', '刻蚀设备', '薄膜沉积', '光刻设备', '涂胶显影', '离子注入'];
---
<Layout title="设备大厅 | SCIP MONITOR" description="半导体制造设备数据库">
<div style="min-height: 100vh; background: #020617; font-family: 'JetBrains Mono', monospace; padding-top: 80px;">
  <div style="max-width: 1400px; margin: 0 auto; padding: 0 24px;">
    
    <!-- 面包屑 -->
    <div style="font-size: 12px; color: #64748b; margin-bottom: 24px; padding: 12px 16px; background: rgba(15, 23, 42, 0.6); border: 1px solid #1e293b; border-radius: 8px;">
      <span style="color: #22c55e;">root@ai2424</span><span style="color: #64748b;">:</span><span style="color: #22d3ee;">~</span><span style="color: #64748b;">/</span><span style="color: #fbbf24;">equipment</span><span style="color: #22c55e; margin-left: 4px;">_</span>
    </div>
    
    <!-- 页面标题 -->
    <div style="margin-bottom: 32px;">
      <div style="display: flex; align-items: center; gap: 16px;">
        <div style="width: 56px; height: 56px; background: linear-gradient(135deg, #a78bfa, #7c3aed); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 28px;">⚙️</div>
        <div>
          <h1 style="font-size: 32px; color: #e2e8f0; margin: 0; font-weight: 700; letter-spacing: -0.02em;">EQUIPMENT HALL</h1>
          <p style="font-size: 14px; color: #64748b; margin: 8px 0 0 0;">中国半导体制造设备国产替代库 · 已收录 {equipment.length} 款设备</p>
        </div>
      </div>
    </div>
    
    {hasData ? (
      <>
        <!-- 统计卡片 -->
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 32px;">
          <div style="background: rgba(15, 23, 42, 0.8); border: 1px solid #334155; border-radius: 12px; padding: 24px;">
            <div style="font-size: 32px; font-weight: bold; color: #a78bfa; text-shadow: 0 0 20px rgba(167, 139, 250, 0.4);">{equipment.length}</div>
            <div style="font-size: 12px; color: #64748b; margin-top: 8px;">收录设备</div>
          </div>
          <div style="background: rgba(15, 23, 42, 0.8); border: 1px solid #334155; border-radius: 12px; padding: 24px;">
            <div style="font-size: 32px; font-weight: bold; color: #22c55e; text-shadow: 0 0 20px rgba(34, 197, 94, 0.4);">892</div>
            <div style="font-size: 12px; color: #64748b; margin-top: 8px;">国产设备</div>
          </div>
          <div style="background: rgba(15, 23, 42, 0.8); border: 1px solid #334155; border-radius: 12px; padding: 24px;">
            <div style="font-size: 32px; font-weight: bold; color: #ef4444; text-shadow: 0 0 20px rgba(239, 68, 68, 0.4);">156</div>
            <div style="font-size: 12px; color: #64748b; margin-top: 8px;">受限设备</div>
          </div>
          <div style="background: rgba(15, 23, 42, 0.8); border: 1px solid #334155; border-radius: 12px; padding: 24px;">
            <div style="font-size: 32px; font-weight: bold; color: #fbbf24; text-shadow: 0 0 20px rgba(251, 191, 36, 0.4);">199</div>
            <div style="font-size: 12px; color: #64748b; margin-top: 8px;">监控中</div>
          </div>
        </div>
        
        <!-- 搜索过滤 -->
        <div style="background: rgba(15, 23, 42, 0.8); border: 1px solid #334155; border-radius: 12px; padding: 20px; margin-bottom: 24px;">
          <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 16px;">
            {categories.map(cat => (
              <button style="padding: 8px 16px; font-size: 12px; border: 1px solid #334155; background: transparent; color: #94a3b8; border-radius: 6px; cursor: pointer;">{cat}</button>
            ))}
          </div>
          <div style="display: flex; gap: 12px;">
            <div style="flex: 1; display: flex; align-items: center; background: #020617; border: 1px solid #334155; border-radius: 8px; padding: 0 16px;">
              <span style="color: #a78bfa; margin-right: 12px;">$</span>
              <input type="text" placeholder="search --manufacturer 北方华创 --category 刻蚀设备" style="flex: 1; background: transparent; border: none; color: #e2e8f0; padding: 14px 0; font-family: inherit; font-size: 14px; outline: none;" />
            </div>
            <button style="padding: 14px 28px; background: rgba(167, 139, 250, 0.2); border: 1px solid rgba(167, 139, 250, 0.4); color: #a78bfa; border-radius: 8px; font-size: 12px; font-weight: 600; cursor: pointer;">EXECUTE</button>
          </div>
        </div>
        
        <!-- 设备列表 -->
        <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px;">
          {equipment.map(item => (
            <a href={`/equipment/${item.id}`} style="background: rgba(15, 23, 42, 0.8); border: 1px solid #334155; border-radius: 12px; padding: 24px; text-decoration: none; transition: all 0.2s;" onmouseenter="this.style.borderColor='#a78bfa'; this.style.transform='translateY(-4px)'" onmouseleave="this.style.borderColor='#334155'; this.style.transform='translateY(0)'">
              <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
                <div style="display: flex; align-items: center; gap: 16px;">
                  <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #a78bfa, #7c3aed); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 24px;">⚙️</div>
                  <div>
                    <div style="font-size: 16px; color: #e2e8f0; font-weight: 600;">{item.name}</div>
                    <div style="font-size: 12px; color: #64748b; margin-top: 4px;">{item.manufacturer} · {item.category}</div>
                  </div>
                </div>
                <span style={`padding: 6px 12px; font-size: 11px; border-radius: 4px; ${item.status === '量产' ? 'background: rgba(34, 197, 94, 0.15); color: #22c55e; border: 1px solid rgba(34, 197, 94, 0.3)' : 'background: rgba(251, 191, 36, 0.15); color: #fbbf24; border: 1px solid rgba(251, 191, 36, 0.3)'};`}>{item.status}</span>
              </div>
              <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-bottom: 16px;">
                {Object.entries(item.specs).map(([key, val]) => (
                  <div style="background: rgba(30, 41, 59, 0.6); padding: 12px; border-radius: 8px;">
                    <div style="font-size: 11px; color: #64748b; margin-bottom: 4px;">{key}</div>
                    <div style="font-size: 13px; color: #e2e8f0; font-weight: 500;">{val}</div>
                  </div>
                ))}
              </div>
              <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 16px; border-top: 1px solid #334155;">
                <span style="font-size: 16px; color: #a78bfa; font-weight: 700;">{item.price}</span>
                <span style="font-size: 12px; color: #64748b;">查看详情 →</span>
              </div>
            </a>
          ))}
        </div>
      </>
    ) : (
      <!-- 数据同步中状态 -->
      <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 120px 24px; text-align: center;">
        <div style="width: 80px; height: 80px; border: 3px solid #334155; border-top-color: #a78bfa; border-radius: 50%; animation: spin 1s linear infinite; margin-bottom: 32px;"></div>
        <h2 style="font-size: 24px; color: #e2e8f0; margin-bottom: 12px;">数据正在由 P100 算力节点同步中...</h2>
        <p style="font-size: 14px; color: #64748b;">设备数据库正在从 F:\mined_data\equipment 同步到云端</p>
        <p style="font-size: 12px; color: #475569; margin-top: 8px;">预计完成时间: 2分34秒</p>
      </div>
    )}
    
  </div>
</div>

<style>
@keyframes spin {
  to { transform: rotate(360deg); }
}
</style>
</Layout>