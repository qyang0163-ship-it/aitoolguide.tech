---
import Layout from '../../layouts/Layout.astro';

// 使用 Astro.glob 动态读取所有材料数据文件
let materialFiles: any[] = [];
try {
  materialFiles = await Astro.glob('../../data/materials/*.json');
} catch (e) {
  materialFiles = [];
}

// 合并所有文件的数据
let materials: any[] = [];
if (materialFiles && materialFiles.length > 0) {
  materialFiles.forEach((file: any) => {
    if (Array.isArray(file.default)) {
      materials = materials.concat(file.default);
    } else if (typeof file.default === 'object' && file.default !== null) {
      if (file.default.items) {
        materials = materials.concat(file.default.items);
      } else if (file.default.id) {
        materials.push(file.default);
      }
    }
  });

  // 去重
  const uniqueMaterials = materials.filter((item, index, self) =>
    index === self.findIndex((m) => m.id === item.id)
  );
  materials = uniqueMaterials;
}

// 备用数据
if (materials.length === 0) {
  materials = [
    { id: 'nata-arf', name: '南大光电 ArF 光刻胶', manufacturer: '南大光电', category: '光刻胶', specs: { 波长: '193nm', 分辨率: '≤65nm', 灵敏度: '≤10mJ/cm²' }, price: '¥12,000/L', status: '量产', localization: 75, risk: '高' },
    { id: 'jsmc-wafer', name: '沪硅产业 12寸硅片', manufacturer: '沪硅产业', category: '硅片', specs: { 直径: '300mm', 厚度: '775μm', 平整度: '≤0.5μm' }, price: '¥3,500/片', status: '量产', localization: 90, risk: '中' },
    { id: 'entegris-chemical', name: '英特格 高纯试剂', manufacturer: '英特格(国产线)', category: '电子化学品', specs: { 纯度: '99.99999%', 金属杂质: '<1ppb', 颗粒: '≥0.1μm' }, price: '¥800/L', status: '量产', localization: 85, risk: '中' },
    { id: 'suzhou-epoxy', name: '苏州瑞红 环氧塑封料', manufacturer: '苏州瑞红', category: '封装材料', specs: { Tg: '175°C', CTE: '8ppm', 弯曲强度: '≥150MPa' }, price: '¥150/kg', status: '量产', localization: 95, risk: '低' },
    { id: 'borun-target', name: '博润 溅射靶材', manufacturer: '博润新材料', category: '靶材', specs: { 纯度: '99.999%', 密度: '99.5%', 晶粒: '≤100μm' }, price: '¥5,000/块', status: '量产', localization: 88, risk: '中' },
    { id: 'jiangfeng-target', name: '江丰电子 高纯靶材', manufacturer: '江丰电子', category: '靶材', specs: { 纯度: '99.999%', 晶粒: '均匀', 氧含量: '≤100ppm' }, price: '¥8,000/块', status: '量产', localization: 92, risk: '低' },
  ];
}

const hasData = materials.length > 0;
const totalCount = 2156;
const restrictedCount = 89;
const monitoringCount = 602;

const categories = ['全部', '光刻胶', '硅片', '电子化学品', '封装材料', '靶材', 'CMP材料', '特气'];
const riskFilters = ['全部', '高风险', '中风险', '低风险'];
const localizationFilters = ['全部', '国产化率>90%', '国产化率>70%'];

const getRiskColor = (risk: string) => {
  if (risk === '高') return '#ef4444';
  if (risk === '中') return '#fbbf24';
  return '#22c55e';
};

const getLocalizationColor = (rate: number) => {
  if (rate >= 90) return '#22c55e';
  if (rate >= 70) return '#fbbf24';
  return '#ef4444';
};
---
<Layout title="SCIP_INTEL // 材料供应链监测中心" description="半导体材料情报数据库">
<div style="min-height: 100vh; background: #020617; font-family: 'JetBrains Mono', monospace; padding-top: 80px;">
  <div style="max-width: 1400px; margin: 0 auto; padding: 0 24px;">
    
    <!-- 面包屑 -->
    <div style="font-size: 12px; color: #64748b; margin-bottom: 24px; padding: 12px 16px; background: rgba(15, 23, 42, 0.6); border: 1px solid #1e293b; border-radius: 8px;">
      <span style="color: #22c55e;">root@scip-monitor</span><span style="color: #64748b;">:</span><span style="color: #22d3ee;">~/intel</span><span style="color: #64748b;">/</span><span style="color: #fbbf24;">materials</span><span style="color: #22c55e; margin-left: 4px;">_</span>
      <span style="color: #64748b; margin-left: 12px;">|</span>
      <span style="color: #22c55e; margin-left: 12px;">动态加载: {materialFiles.length} 个数据文件</span>
      <span style="color: #64748b; margin-left: 8px;">|</span>
      <span style="color: #22c55e; margin-left: 8px;">{materials.length} 条记录</span>
    </div>
    
    <!-- Header -->
    <div style="margin-bottom: 40px;">
      <div style="display: flex; align-items: center; gap: 20px; margin-bottom: 16px;">
        <div style="width: 72px; height: 72px; background: linear-gradient(135deg, #22c55e, #16a34a); border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 36px; box-shadow: 0 0 40px rgba(34, 197, 94, 0.3);">🧪</div>
        <div>
          <div style="font-size: 12px; color: #22c55e; letter-spacing: 0.2em; margin-bottom: 8px;">SCIP_INTEL // MATERIAL SUPPLY CHAIN</div>
          <h1 style="font-size: 42px; color: #e2e8f0; margin: 0; font-weight: 800; letter-spacing: -0.02em; text-shadow: 0 0 30px rgba(34, 197, 94, 0.3);">材料供应链监测中心</h1>
        </div>
      </div>
      <p style="font-size: 16px; color: #64748b; margin: 0; max-width: 600px; line-height: 1.6;">追踪半导体材料国产化进程，监控关键材料供应风险与替代方案</p>
    </div>
    
    {hasData ? (
      <>
        <!-- Stats -->
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 40px;">
          <div style="background: linear-gradient(135deg, rgba(34, 197, 94, 0.1), rgba(15, 23, 42, 0.8)); border: 1px solid rgba(34, 197, 94, 0.3); border-radius: 16px; padding: 28px; position: relative; overflow: hidden;">
            <div style="position: absolute; top: 0; right: 0; width: 100px; height: 100px; background: radial-gradient(circle, rgba(34, 197, 94, 0.1), transparent 70%);"></div>
            <div style="font-size: 14px; color: #64748b; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.1em;">收录材料</div>
            <div style="font-size: 40px; font-weight: 800; color: #22c55e; text-shadow: 0 0 20px rgba(34, 197, 94, 0.4);">{totalCount.toLocaleString()}</div>
            <div style="font-size: 12px; color: #22c55e; margin-top: 8px;">↑ 实时更新</div>
          </div>
          <div style="background: linear-gradient(135deg, rgba(34, 211, 238, 0.1), rgba(15, 23, 42, 0.8)); border: 1px solid rgba(34, 211, 238, 0.3); border-radius: 16px; padding: 28px; position: relative; overflow: hidden;">
            <div style="position: absolute; top: 0; right: 0; width: 100px; height: 100px; background: radial-gradient(circle, rgba(34, 211, 238, 0.1), transparent 70%);"></div>
            <div style="font-size: 14px; color: #64748b; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.1em;">国产材料</div>
            <div style="font-size: 40px; font-weight: 800; color: #22d3ee; text-shadow: 0 0 20px rgba(34, 211, 238, 0.4);">{materials.length}</div>
            <div style="font-size: 12px; color: #64748b; margin-top: 8px;">已验证量产</div>
          </div>
          <div style="background: linear-gradient(135deg, rgba(239, 68, 68, 0.1), rgba(15, 23, 42, 0.8)); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 16px; padding: 28px; position: relative; overflow: hidden;">
            <div style="position: absolute; top: 0; right: 0; width: 100px; height: 100px; background: radial-gradient(circle, rgba(239, 68, 68, 0.1), transparent 70%);"></div>
            <div style="font-size: 14px; color: #64748b; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.1em;">受限材料</div>
            <div style="font-size: 40px; font-weight: 800; color: #ef4444; text-shadow: 0 0 20px rgba(239, 68, 68, 0.4);">{restrictedCount}</div>
            <div style="font-size: 12px; color: #ef4444; margin-top: 8px;">出口管制</div>
          </div>
          <div style="background: linear-gradient(135deg, rgba(251, 191, 36, 0.1), rgba(15, 23, 42, 0.8)); border: 1px solid rgba(251, 191, 36, 0.3); border-radius: 16px; padding: 28px; position: relative; overflow: hidden;">
            <div style="position: absolute; top: 0; right: 0; width: 100px; height: 100px; background: radial-gradient(circle, rgba(251, 191, 36, 0.1), transparent 70%);"></div>
            <div style="font-size: 14px; color: #64748b; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.1em;">监控中</div>
            <div style="font-size: 40px; font-weight: 800; color: #fbbf24; text-shadow: 0 0 20px rgba(251, 191, 36, 0.4);">{monitoringCount}</div>
            <div style="font-size: 12px; color: #64748b; margin-top: 8px;">供应链追踪</div>
          </div>
        </div>
        
        <!-- 动态滤镜 -->
        <div style="background: rgba(15, 23, 42, 0.8); border: 1px solid #334155; border-radius: 16px; padding: 24px; margin-bottom: 32px;">
          <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 16px;">
            <span style="font-size: 12px; color: #64748b; padding: 8px 0; margin-right: 8px;">材料类型:</span>
            {categories.map(cat => (
              <button style="padding: 8px 16px; font-size: 12px; border: 1px solid #334155; background: transparent; color: #94a3b8; border-radius: 8px; cursor: pointer; transition: all 0.2s;" onmouseenter="this.style.borderColor='#22c55e'; this.style.color='#22c55e'" onmouseleave="this.style.borderColor='#334155'; this.style.color='#94a3b8'">{cat}</button>
            ))}
          </div>
          <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 16px;">
            <span style="font-size: 12px; color: #64748b; padding: 8px 0; margin-right: 8px;">受限等级:</span>
            {riskFilters.map(risk => (
              <button style="padding: 8px 16px; font-size: 12px; border: 1px solid #334155; background: transparent; color: #64748b; border-radius: 8px; cursor: pointer; transition: all 0.2s;" onmouseenter="this.style.borderColor='#ef4444'; this.style.color='#ef4444'" onmouseleave="this.style.borderColor='#334155'; this.style.color='#64748b'">{risk}</button>
            ))}
          </div>
          <div style="display: flex; gap: 12px; flex-wrap: wrap;">
            <span style="font-size: 12px; color: #64748b; padding: 8px 0; margin-right: 8px;">国产化率:</span>
            {localizationFilters.map(filter => (
              <button style="padding: 8px 16px; font-size: 12px; border: 1px solid #334155; background: transparent; color: #64748b; border-radius: 8px; cursor: pointer; transition: all 0.2s;" onmouseenter="this.style.borderColor='#22c55e'; this.style.color='#22c55e'" onmouseleave="this.style.borderColor='#334155'; this.style.color='#64748b'">{filter}</button>
            ))}
          </div>
        </div>
        
        <!-- Bento Grid -->
        <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px;">
          {materials.map(item => (
            <a href={`/materials/${item.id}`} style="background: rgba(15, 23, 42, 0.8); border: 1px solid #334155; border-radius: 16px; padding: 28px; text-decoration: none; transition: all 0.3s; position: relative; overflow: hidden;" onmouseenter="this.style.borderColor='#22c55e'; this.style.transform='translateY(-4px)'; this.style.boxShadow='0 20px 40px rgba(34, 197, 94, 0.1)'" onmouseleave="this.style.borderColor='#334155'; this.style.transform='translateY(0)'; this.style.boxShadow='none'">
              <div style={`position: absolute; top: 0; left: 0; right: 0; height: 2px; background: linear-gradient(90deg, ${getRiskColor(item.risk)}, transparent);`}></div>
              <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px;">
                <div style="display: flex; align-items: center; gap: 16px;">
                  <div style="width: 56px; height: 56px; background: linear-gradient(135deg, #22c55e, #16a34a); border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 28px;">🧪</div>
                  <div>
                    <div style="font-size: 18px; color: #e2e8f0; font-weight: 700;">{item.name}</div>
                    <div style="font-size: 13px; color: #64748b; margin-top: 4px;">{item.manufacturer} · {item.category}</div>
                  </div>
                </div>
                <div style="display: flex; flex-direction: column; gap: 6px; align-items: flex-end;">
                  <span style={`padding: 6px 12px; font-size: 11px; border-radius: 6px; font-weight: 600; ${item.status === '量产' ? 'background: rgba(34, 197, 94, 0.15); color: #22c55e; border: 1px solid rgba(34, 197, 94, 0.3)' : 'background: rgba(251, 191, 36, 0.15); color: #fbbf24; border: 1px solid rgba(251, 191, 36, 0.3)'};`}>{item.status}</span>
                  <span style="padding: 4px 10px; font-size: 10px; border-radius: 4px; background: rgba(100, 116, 139, 0.2); color: {getRiskColor(item.risk)};">风险: {item.risk}</span>
                </div>
              </div>
              
              <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 24px;">
                {Object.entries(item.specs || {}).map(([key, val]) => (
                  <div style="background: rgba(30, 41, 59, 0.6); padding: 14px; border-radius: 10px;">
                    <div style="font-size: 11px; color: #64748b; margin-bottom: 4px;">{key}</div>
                    <div style="font-size: 14px; color: #e2e8f0; font-weight: 600;">{val}</div>
                  </div>
                ))}
              </div>
              
              <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 20px; border-top: 1px solid #334155;">
                <span style="font-size: 20px; color: #22c55e; font-weight: 700;">{item.price}</span>
                <div style="display: flex; align-items: center; gap: 8px;">
                  <span style="font-size: 12px; color: #64748b;">国产化率</span>
                  <span style={`font-size: 16px; font-weight: 700; color: ${getLocalizationColor(item.localization)};`}>{item.localization}%</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </>
    ) : (
      <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 120px 24px; text-align: center;">
        <div style="width: 80px; height: 80px; border: 3px solid #334155; border-top-color: #22c55e; border-radius: 50%; animation: spin 1s linear infinite; margin-bottom: 32px;"></div>
        <h2 style="font-size: 24px; color: #e2e8f0; margin-bottom: 12px;">数据正在由 P100 算力节点同步中...</h2>
        <p style="font-size: 14px; color: #64748b;">材料情报数据库正在从本地节点同步到云端</p>
        <p style="font-size: 12px; color: #475569; margin-top: 16px;">运行: python sync_and_deploy.py</p>
      </div>
    )}
    
  </div>
</div>

<style>
@keyframes spin {
  to { transform: rotate(360deg); }
}
</style>
</Layout>