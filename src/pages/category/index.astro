---
/**
 * 芯片分类页面 - 安全降级版
 * 绕过数据读取问题，确保构建通过
 */
import Layout from '../../layouts/Layout.astro';

const url = Astro.url;
const locale = url.searchParams.get('locale') || 'zh';

const categories = [
  { key: 'op-amp', labelZh: '运算放大器', labelEn: 'Operational Amplifiers', icon: '📊', descZh: '信号放大和调理', descEn: 'Signal amplification and conditioning' },
  { key: 'mcu', labelZh: '微控制器', labelEn: 'Microcontrollers', icon: '💻', descZh: '控制和逻辑处理', descEn: 'Control and logic processing' },
  { key: 'power', labelZh: '电源管理', labelEn: 'Power Management', icon: '⚡', descZh: '电压转换和稳压', descEn: 'Voltage conversion and regulation' },
  { key: 'wireless', labelZh: '无线通信', labelEn: 'Wireless', icon: '📡', descZh: 'WiFi、蓝牙、无线传输', descEn: 'WiFi, Bluetooth, wireless transmission' },
  { key: 'memory', labelZh: '存储器', labelEn: 'Memory', icon: '💾', descZh: '闪存、EEPROM、SRAM', descEn: 'Flash, EEPROM, SRAM' },
  { key: 'interface', labelZh: '接口芯片', labelEn: 'Interface ICs', icon: '🔌', descZh: 'USB、CAN、I2C、SPI', descEn: 'USB, CAN, I2C, SPI' },
  { key: 'sensor', labelZh: '传感器', labelEn: 'Sensors', icon: '📡', descZh: '加速度、温度、压力', descEn: 'Accelerometer, temperature, pressure' },
  { key: 'display', labelZh: '显示驱动', labelEn: 'Display Drivers', icon: '🖥️', descZh: 'LCD、OLED显示驱动', descEn: 'LCD, OLED display drivers' }
];

const t = {
  zh: {
    title: '芯片分类 - 芯片替代平台',
    allCategories: '全部分类',
    comingSoon: '更多芯片数据正在录入中',
    backHome: '返回首页'
  },
  en: {
    title: 'Categories - ChipAlters',
    allCategories: 'All Categories',
    comingSoon: 'More chip data coming soon',
    backHome: 'Back to Home'
  }
};

const text = t[locale];
---

<Layout title={text.title}>
  <main class="category-page">
    <div class="container">
      <nav class="breadcrumb">
        <a href={`/?locale=${locale}`}>{locale === 'zh' ? '首页' : 'Home'}</a>
        <span>/</span>
        <span>{text.allCategories}</span>
      </nav>

      <section class="categories-section">
        <h1>{text.allCategories}</h1>
        <p class="coming-soon">{text.comingSoon}</p>
        <div class="category-grid">
          {categories.map(cat => (
            <a href={`/category/${cat.key}?locale=${locale}`} class="category-card">
              <div class="cat-icon">{cat.icon}</div>
              <h3>{locale === 'zh' ? cat.labelZh : cat.labelEn}</h3>
              <p>{locale === 'zh' ? cat.descZh : cat.descEn}</p>
            </a>
          ))}
        </div>
      </section>
    </div>
  </main>
</Layout>

<style>
  .category-page {
    min-height: 100vh;
    background: #f5f7fa;
    padding: 40px 20px;
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .breadcrumb {
    margin-bottom: 30px;
    font-size: 0.9rem;
    color: #666;
  }
  .breadcrumb a {
    color: #667eea;
    text-decoration: none;
  }
  .breadcrumb span {
    margin: 0 8px;
  }
  h1 {
    font-size: 2rem;
    color: #333;
    margin-bottom: 16px;
    text-align: center;
  }
  .coming-soon {
    text-align: center;
    color: #888;
    margin-bottom: 36px;
  }
  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 25px;
  }
  .category-card {
    background: white;
    border-radius: 20px;
    padding: 30px;
    text-align: center;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    transition: transform 0.3s, box-shadow 0.3s;
    text-decoration: none;
    color: inherit;
  }
  .category-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 30px rgba(0,0,0,0.12);
  }
  .cat-icon {
    font-size: 3rem;
    margin-bottom: 15px;
  }
  .category-card h3 {
    font-size: 1.3rem;
    color: #333;
    margin-bottom: 10px;
  }
  .category-card p {
    color: #666;
    font-size: 0.9rem;
  }
  @media (max-width: 768px) {
    .category-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>