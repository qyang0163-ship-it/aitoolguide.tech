  <!-- Client-side Modal Script -->
  <script is:inline>
    (function() {
      const modal = document.getElementById('vipModal');
      const backdrop = document.getElementById('modalBackdrop');
      const panel = document.getElementById('modalPanel');
      const closeBtn = document.getElementById('closeModalBtn');
      const notNowBtn = document.getElementById('notNowBtn');
      const leadForm = document.getElementById('leadForm');
      
      // VIP buttons that trigger modal
      const vipBtns = [
        document.getElementById('vipBtn1'),
        document.getElementById('vipBtn2'),
        document.getElementById('contactOemBtn'),
        ...document.querySelectorAll('.vip-download-btn')
      ];
      
      function openModal() {
        modal.classList.remove('hidden');
        // Trigger animation
        setTimeout(() => {
          backdrop.classList.remove('opacity-0');
          panel.classList.remove('opacity-0', 'scale-95');
          panel.classList.add('opacity-100', 'scale-100');
        }, 10);
        document.body.style.overflow = 'hidden';
      }
      
      function closeModal() {
        backdrop.classList.add('opacity-0');
        panel.classList.remove('opacity-100', 'scale-100');
        panel.classList.add('opacity-0', 'scale-95');
        setTimeout(() => {
          modal.classList.add('hidden');
          document.body.style.overflow = '';
        }, 300);
      }
      
      // Attach click handlers
      vipBtns.forEach(btn => {
        if (btn) btn.addEventListener('click', openModal);
      });
      
      if (closeBtn) closeBtn.addEventListener('click', closeModal);
      if (notNowBtn) notNowBtn.addEventListener('click', closeModal);
      
      // Close on backdrop click
      if (backdrop) {
        backdrop.addEventListener('click', closeModal);
      }
      
      // Close on Escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
          closeModal();
        }
      });
      
      // Form submission
      if (leadForm) {
        leadForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const formData = new FormData(leadForm);
          const data = {
            name: formData.get('name'),
            company: formData.get('company'),
            contact: formData.get('contact'),
            chip: '{id}',
            timestamp: new Date().toISOString()
          };
          
          // Store in localStorage for demo
          const leads = JSON.parse(localStorage.getItem('chipalt_leads') || '[]');
          leads.push(data);
          localStorage.setItem('chipalt_leads', JSON.stringify(leads));
          
          // Show success message
          alert('提交成功！我们的技术专家将在24小时内联系您。');
          closeModal();
          leadForm.reset();
        });
      }
    })();
  </script>
</Layout>
