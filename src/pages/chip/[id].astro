---
import Layout from '../../layouts/Layout.astro';
import chipData from '../../data/chips.json';

export async function getStaticPaths() {
  return chipData.chips.map((chip) => ({
    params: { id: chip.id },
    props: { chip },
  }));
}

const { chip } = Astro.props;
const { id, manufacturer, category, description, package: pkg, specs, alternatives } = chip;

const categoryNames: Record<string, string> = {
  mcu: '微控制器',
  adc: 'ADC/DAC',
  analog: '模拟芯片',
  power: '电源管理',
  interface: '接口芯片',
  sensor: '传感器',
  memory: '存储器',
  logic: '逻辑器件',
  rf: '射频无线'
};

const difficultyConfig: Record<string, { label: string; color: string; bg: string; border: string }> = {
  easy: { label: '简单', color: 'text-emerald-400', bg: 'bg-emerald-500/10', border: 'border-emerald-500/30' },
  medium: { label: '中等', color: 'text-amber-400', bg: 'bg-amber-500/10', border: 'border-amber-500/30' },
  hard: { label: '困难', color: 'text-red-400', bg: 'bg-red-500/10', border: 'border-red-500/30' }
};

const stockColors: Record<string, string> = {
  '充足': 'text-emerald-400',
  '一般': 'text-amber-400',
  '紧张': 'text-red-400'
};

const pageTitle = `${id} 国产替代方案 | P2P兼容芯片替换推荐 - ChipAltDB`;
const pageDescription = `${manufacturer} ${id} 的国产替代方案查询。${alternatives.length}个P2P兼容替代型号，包含兆易创新、沁恒微等国产厂商。替代难度、价格优势、技术手册一键下载。`;
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- VIP Lead Gen Modal -->
  <div id="vipModal" class="fixed inset-0 z-[100] hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <!-- Backdrop with heavy blur -->
    <div class="fixed inset-0 bg-gray-900/80 backdrop-blur-xl transition-opacity opacity-0" id="modalBackdrop"></div>
    
    <div class="fixed inset-0 z-10 overflow-y-auto">
      <div class="flex min-h-full items-center justify-center p-4 text-center sm:p-0">
        <!-- Modal panel -->
        <div class="relative transform overflow-hidden rounded-2xl bg-gray-800 border border-gray-600 text-left shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-lg opacity-0 scale-95" id="modalPanel">
          <!-- Close button -->
          <button id="closeModalBtn" class="absolute right-4 top-4 text-gray-400 hover:text-white transition-colors z-10">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
          
          <!-- Header -->
          <div class="bg-gradient-to-r from-blue-900/50 to-emerald-900/50 px-6 py-6 border-b border-gray-700">
            <div class="flex items-center gap-3 mb-2">
              <div class="w-10 h-10 bg-amber-500 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
              </div>
              <h3 class="text-xl font-bold text-white" id="modal-title">获取原厂级《国产替代评估与测试报告》</h3>
            </div>
            <p class="text-gray-300 text-sm mt-2">
              <span class="text-amber-400 font-medium">⚠️ 该型号替代存在隐蔽坑点</span>，已为您准备完整的引脚差异与底层寄存器兼容性深度报告。
            </p>
          </div>
          
          <!-- Content -->
          <div class="px-6 py-6">
            <!-- QR Code Section -->
            <div class="bg-gray-900/50 rounded-xl border border-gray-700 p-4 mb-6">
              <div class="flex items-start gap-4">
                <!-- QR Placeholder -->
                <div class="w-24 h-24 bg-gray-700 border-2 border-dashed border-gray-500 rounded-lg flex items-center justify-center flex-shrink-0">
                  <div class="text-center">
                    <svg class="w-8 h-8 text-gray-500 mx-auto mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"/>
                    </svg>
                    <span class="text-xs text-gray-500">扫码添加</span>
                  </div>
                </div>
                <div>
                  <h4 class="text-white font-semibold mb-1">扫码添加技术专家企业微信</h4>
                  <p class="text-gray-400 text-sm">获取 {id} 完整替代方案评估报告</p>
                  <div class="flex items-center gap-2 mt-2">
                    <span class="inline-flex items-center gap-1 text-emerald-400 text-xs">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                      </svg>
                      50+ 页深度报告
                    </span>
                    <span class="inline-flex items-center gap-1 text-emerald-400 text-xs">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                      </svg>
                      引脚对比图
                    </span>
                    <span class="inline-flex items-center gap-1 text-emerald-400 text-xs">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                      </svg>
                      寄存器映射表
                    </span>
                  </div>
                </div>
              </div>
            </div>
            
            <!-- Form -->
            <form id="leadForm" class="space-y-4">
              <div>
                <label for="name" class="block text-sm font-medium text-gray-300 mb-1">姓名</label>
                <input type="text" id="name" name="name" required class="w-full bg-gray-900 border border-gray-600 rounded-lg px-4 py-2.5 text-white placeholder-gray-500 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors" placeholder="请输入您的姓名">
              </div>
              <div>
                <label for="company" class="block text-sm font-medium text-gray-300 mb-1">公司</label>
                <input type="text" id="company" name="company" required class="w-full bg-gray-900 border border-gray-600 rounded-lg px-4 py-2.5 text-white placeholder-gray-500 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors" placeholder="请输入公司名称">
              </div>
              <div>
                <label for="contact" class="block text-sm font-medium text-gray-300 mb-1">手机号 / 邮箱</label>
                <input type="text" id="contact" name="contact" required class="w-full bg-gray-900 border border-gray-600 rounded-lg px-4 py-2.5 text-white placeholder-gray-500 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors" placeholder="请输入手机号或邮箱">
              </div>
              <div class="pt-2">
                <button type="submit" class="w-full bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-white font-semibold py-3 rounded-lg transition-all shadow-lg shadow-amber-500/25 flex items-center justify-center gap-2">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                  </svg>
                  立即获取完整报告
                </button>
              </div>
            </form>
            
            <!-- Not now button -->
            <button id="notNowBtn" class="w-full mt-3 text-gray-500 hover:text-gray-300 text-sm font-medium transition-colors">
              暂不需要
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Industrial Header -->
  <header class="sticky top-0 z-50 bg-gray-900/95 backdrop-blur border-b border-gray-700">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <a href="/" class="flex items-center gap-3">
          <div class="w-10 h-10 bg-blue-600 rounded flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/>
            </svg>
          </div>
          <div>
            <h1 class="text-lg font-bold text-white tracking-tight">ChipAltDB</h1>
            <p class="text-xs text-gray-400">国产芯片替代数据库</p>
          </div>
        </a>
        
        <div class="flex-1 max-w-xl mx-8">
          <div class="relative">
            <input 
              type="text" 
              placeholder="输入原厂型号搜索..." 
              class="w-full bg-gray-800 border border-gray-600 rounded-lg pl-10 pr-4 py-2 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
            />
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
          </div>
        </div>

        <button class="bg-emerald-600 hover:bg-emerald-700 text-white text-sm px-4 py-2 rounded-lg font-medium transition-colors flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
          导出数据
        </button>
      </div>
    </div>
  </header>

  <main class="bg-gray-900 min-h-screen">
    <!-- Hero Section -->
    <section class="bg-gray-800 border-b border-gray-700">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-sm text-gray-400 mb-6">
          <a href="/" class="hover:text-white transition-colors">首页</a>
          <span class="text-gray-600">/</span>
          <a href={`/category/${category}`} class="hover:text-white transition-colors">{categoryNames[category]}</a>
          <span class="text-gray-600">/</span>
          <span class="text-white font-medium">{id}</span>
        </nav>

        <!-- Chip Header -->
        <div class="flex items-start justify-between">
          <div>
            <div class="flex items-center gap-4 mb-3">
              <h1 class="text-3xl font-bold text-white font-mono tracking-wide">{id}</h1>
              <span class="text-sm text-gray-300 bg-gray-700 px-3 py-1 rounded-full">{manufacturer}</span>
              <span class="text-sm text-gray-400 bg-gray-700 px-3 py-1 rounded-full font-mono">{pkg}</span>
            </div>
            <p class="text-gray-300 text-lg">{description}</p>
          </div>
          
          <!-- VIP CTA -->
          <div class="flex flex-col gap-3">
            <button id="vipBtn1" class="bg-amber-600 hover:bg-amber-700 text-white px-6 py-3 rounded-lg font-medium transition-colors flex items-center gap-2 shadow-lg shadow-amber-600/20 cursor-pointer">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
              解锁完整参数对比表
            </button>
            <button id="vipBtn2" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-medium transition-colors flex items-center gap-2 cursor-pointer">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
              下载VIP技术手册
            </button>
          </div>
        </div>

        <!-- Original Chip Specs -->
        <div class="mt-8 bg-gray-900/50 rounded-xl border border-gray-700 p-6">
          <h2 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-4">原厂规格参数</h2>
          <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4">
            {Object.entries(specs).map(([key, value]) => (
              <div class="bg-gray-800 rounded-lg p-3 border border-gray-700">
                <p class="text-xs text-gray-500 uppercase mb-1">{key}</p>
                <p class="text-sm font-mono text-white font-medium">{value}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Alternatives Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-2xl font-bold text-white">国产替代方案</h2>
          <p class="text-gray-400 mt-1">找到 {alternatives.length} 个替代型号，其中 {alternatives.filter(a => a.p2pCompatible).length} 个完全P2P兼容</p>
        </div>
        
        <!-- Filter Tags -->
        <div class="flex items-center gap-2">
          <button class="px-4 py-2 bg-emerald-600/20 text-emerald-400 border border-emerald-600/30 rounded-lg text-sm font-medium">全部</button>
          <button class="px-4 py-2 bg-gray-800 text-gray-400 border border-gray-700 rounded-lg text-sm font-medium hover:text-white transition-colors">P2P兼容</button>
          <button class="px-4 py-2 bg-gray-800 text-gray-400 border border-gray-700 rounded-lg text-sm font-medium hover:text-white transition-colors">价格最优</button>
        </div>
      </div>

      <!-- Alternatives Cards -->
      <div class="space-y-6">
        {alternatives.map((alt, index) => {
          const diff = difficultyConfig[alt.difficulty];
          return (
            <div class="bg-gray-800 rounded-xl border border-gray-700 overflow-hidden hover:border-blue-500/50 transition-colors">
              <!-- Card Header -->
              <div class="px-6 py-5 border-b border-gray-700">
                <div class="flex items-start justify-between">
                  <div class="flex items-center gap-6">
                    <div class="text-center">
                      <span class="text-xs text-gray-500 block mb-1">排名</span>
                      <span class="text-2xl font-bold text-white font-mono">#{index + 1}</span>
                    </div>
                    <div>
                      <div class="flex items-center gap-3 mb-2">
                        <h3 class="text-xl font-bold text-white font-mono">{alt.id}</h3>
                        <span class="text-sm text-gray-300 bg-gray-700 px-2 py-0.5 rounded">{alt.manufacturer}</span>
                        {alt.p2pCompatible && (
                          <span class="inline-flex items-center gap-1 text-emerald-400 bg-emerald-500/10 border border-emerald-500/30 px-2 py-0.5 rounded text-xs font-medium">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                            </svg>
                            P2P兼容
                          </span>
                        )}
                      </div>
                      <p class="text-gray-400 text-sm">{alt.description}</p>
                    </div>
                  </div>
                  
                  <div class="flex items-center gap-4">
                    <div class="text-right">
                      <span class="text-xs text-gray-500 block">替代难度</span>
                      <span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded text-sm font-medium border ${diff.bg} ${diff.color} ${diff.border}`}>
                        <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
                        {diff.label}
                      </span>
                    </div>
                    <div class="text-right">
                      <span class="text-xs text-gray-500 block">价格优势</span>
                      <span class="text-emerald-400 font-mono font-bold text-lg">↓{alt.priceAdvantage}</span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Specs Comparison -->
              <div class="px-6 py-4 bg-gray-900/30">
                <div class="flex items-center gap-2 mb-3">
                  <span class="text-xs text-gray-500 uppercase tracking-wider">规格对比</span>
                  <div class="flex-1 h-px bg-gray-700"></div>
                </div>
                <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-3">
                  {Object.entries(alt.specs).map(([key, value]) => {
                    const originalValue = specs[key];
                    const isDifferent = originalValue !== value;
                    return (
                      <div class={`rounded-lg p-3 border ${isDifferent ? 'bg-blue-500/5 border-blue-500/20' : 'bg-gray-800/50 border-gray-700'}`}>
                        <p class="text-xs text-gray-500 uppercase mb-1">{key}</p>
                        <p class={`text-sm font-mono font-medium ${isDifferent ? 'text-blue-400' : 'text-white'}`}>{value}</p>
                        {isDifferent && (
                          <p class="text-xs text-gray-500 mt-1 line-through">{originalValue}</p>
                        )}
                      </div>
                    );
                  })}
                </div>
              </div>

              <!-- Card Footer -->
              <div class="px-6 py-4 bg-gray-800/50 border-t border-gray-700 flex items-center justify-between">
                <div class="flex items-center gap-6 text-sm">
                  <span class="flex items-center gap-2">
                    <span class="text-gray-500">库存状态:</span>
                    <span class={`font-medium ${stockColors[alt.stock] || 'text-gray-400'}`}>{alt.stock}</span>
                  </span>
                  <span class="flex items-center gap-2">
                    <span class="text-gray-500">数据手册:</span>
                    <span class="text-gray-300 font-mono text-xs">{alt.datasheet}</span>
                  </span>
                </div>
                
                <div class="flex items-center gap-3">
                  <button class="vip-download-btn text-sm text-blue-400 hover:text-blue-300 font-medium transition-colors cursor-pointer" data-chip={id}>
                    详细对比
                  </button>
                  <button class="vip-download-btn bg-blue-600 hover:bg-blue-700 text-white text-sm px-4 py-2 rounded-lg font-medium transition-colors flex items-center gap-2 cursor-pointer" data-chip={id}>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                    下载手册
                  </button>
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <!-- OEM Promotion Slot -->
      <div class="mt-12 bg-gradient-to-r from-blue-900/20 to-emerald-900/20 rounded-xl border border-blue-700/30 p-6">
        <div class="flex items-center justify-between">
          <div>
            <h3 class="text-lg font-bold text-white mb-2">国产原厂直供通道</h3>
            <p class="text-gray-400 text-sm">兆易创新、极海半导体、沁恒微等原厂认证代理，批量采购专属优惠</p>
          </div>
          <button id="contactOemBtn" class="bg-amber-600 hover:bg-amber-700 text-white px-6 py-3 rounded-lg font-medium transition-colors cursor-pointer">
            联系原厂销售
          </button>
        </div>
      </div>
    </section>

    <!-- Related Chips -->
    <section class="bg-gray-800 border-t border-gray-700 py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-xl font-bold text-white mb-6">相关替代型号</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {chipData.chips.filter(c => c.category === category && c.id !== id).slice(0, 3).map((related) => (
            <a href={`/chip/${related.id}`} class="bg-gray-900 rounded-lg border border-gray-700 p-4 hover:border-blue-500/50 transition-colors">
              <div class="flex items-center justify-between mb-2">
                <span class="font-mono font-bold text-white">{related.id}</span>
                <span class="text-xs text-gray-400">{related.manufacturer}</span>
              </div>
              <p class="text-sm text-gray-400 mb-3">{related.description}</p>
              <div class="flex items-center gap-2">
                <span class="text-xs text-emerald-400 bg-emerald-500/10 border border-emerald-500/30 px-2 py-0.5 rounded">
                  {related.alternatives.filter(a => a.p2pCompatible).length}个P2P兼容
                </span>
                <span class="text-xs text-gray-500">{related.alternatives.length}个替代方案</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="bg-gray-900 border-t border-gray-800 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 bg-blue-600 rounded flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
