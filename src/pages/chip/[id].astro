---
import Layout from '../../layouts/Layout.astro';
export async function getStaticPaths() {
 const chips = await import('../../data/chips.json');
 return chips.default.map(c=>({params:{id:c.id},props:{chip:c}}));
}
const { chip } = Astro.props;
---
<Layout title={`${chip.name} 国产替代 | P2P兼容 ${chip.originalEquivalent}`} description={`国产替代 ${chip.name} 完美替换 ${chip.originalEquivalent}`}>
<div class="max-w-7xl mx-auto px-4 py-8">
<nav class="breadcrumb mb-6"><a href="/">首页</a> / <a href="/chips">芯片库</a> / {chip.name}</nav>
<div class="flex flex-col md:flex-row justify-between gap-6 mb-10">
<div><h1 class="text-4xl font-bold">{chip.name}</h1><div class="flex gap-2 mt-2"><span class="badge badge-green">国产替代</span><span class="badge badge-blue">P2P兼容</span></div><p class="text-slate-600 mt-2">替代 {chip.originalEquivalent}，{chip.manufacturer}出品。</p></div>
<div class="flex gap-3"><a href="#" class="btn-primary">🔍 解锁完整参数对比</a><a href={chip.datasheetUrl} class="btn-secondary" target="_blank">📄 下载技术手册</a></div>
</div>
<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
<div class="lg:col-span-2 card"><h2 class="text-2xl font-bold mb-4">核心参数</h2><table><tbody>{Object.entries(chip.specs).map(([k,v])=>(<tr><td class="font-medium py-2">{k}</td><td class="py-2">{v}</td></tr>))}</tbody></table></div>
<div class="space-y-6"><div class="card"><h3 class="font-bold">💰 参考价格</h3><p class="text-3xl text-[#E48736] font-bold">{chip.price}</p></div></div>
</div>
<div class="card mt-8"><h2 class="text-2xl font-bold">替代成熟度评估</h2><p class="mt-2"><span class="badge badge-green">{chip.substituteLevel==='pin2pin'?'引脚兼容(Pin2Pin)':'功能替代'}</span></p></div>
</div>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"Product","name":"{chip.name}","description":"国产替代芯片","brand":{"@type":"Brand","name":"{chip.manufacturer}"}}</script>
</Layout>