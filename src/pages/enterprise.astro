---
import Layout from '../layouts/Layout.astro';
const enterprises = (await import('../data/enterprises.json')).default;
---
<Layout title="半导体企业全景 - 500+家核心企业 | 国产替代指南" description="半导体产业链企业全景：设计、制造、封测、设备、材料等500+家核心企业追踪。" keywords="半导体企业,芯片设计,晶圆制造,封测,国产替代">
<div class="max-w-7xl mx-auto px-4 py-8">
<nav class="breadcrumb mb-6"><a href="/">首页</a> / <span>企业</span></nav>
<h1 class="text-4xl font-bold text-slate-900 mb-2">半导体企业全景</h1>
<p class="text-slate-600 mb-8">500+家核心企业 · 持续更新中</p>
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
<div class="card text-center"><div class="text-3xl font-bold text-[#0F4C81]">{enterprises.filter(e=>e.category==='设计').length}</div><div class="text-sm text-slate-500">设计企业</div></div>
<div class="card text-center"><div class="text-3xl font-bold text-[#0F4C81]">{enterprises.filter(e=>e.category==='制造').length}</div><div class="text-sm text-slate-500">制造企业</div></div>
<div class="card text-center"><div class="text-3xl font-bold text-[#0F4C81]">{enterprises.filter(e=>e.category==='设备').length}</div><div class="text-sm text-slate-500">设备企业</div></div>
<div class="card text-center"><div class="text-3xl font-bold text-[#0F4C81]">{enterprises.filter(e=>e.category==='材料').length}</div><div class="text-sm text-slate-500">材料企业</div></div>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
{enterprises.slice(0,12).map(e => (
<div class="card">
<div class="flex justify-between items-start mb-2">
<h2 class="font-bold text-lg">{e.name}</h2>
<span class="badge badge-blue">{e.category}</span>
</div>
<p class="text-sm text-slate-500">{e.level || '正常经营'}</p>
</div>
))}
</div>
</div>
</Layout>