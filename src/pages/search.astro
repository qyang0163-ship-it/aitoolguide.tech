---
/**
 * 搜索结果页面
 */
import Layout from '../layouts/Layout.astro';
import { chipDatabase, searchChips, type ChipReplacement } from '../data/chips/chip-database';

const url = Astro.url;
const query = url.searchParams.get('q') || '';
const locale = url.searchParams.get('locale') || 'zh';

const results = query ? searchChips(query) : [];

const t = {
  zh: {
    title: `搜索: ${query} - 芯片替代平台`,
    results: '搜索结果',
    noResults: '未找到相关芯片替代方案',
    noResultsTip: '尝试搜索其他型号，或浏览以下热门芯片',
    alternatives: '替代方案',
    viewDetails: '查看详情',
    compatibility: '兼容性',
    pinCompatible: '引脚兼容',
    compatible: '兼容',
    similar: '相似',
    priceAdvantage: '价格优势',
    backHome: '返回首页',
    relatedSearches: '相关搜索'
  },
  en: {
    title: `Search: ${query} - ChipAlters`,
    results: 'Search Results',
    noResults: 'No chip alternatives found',
    noResultsTip: 'Try searching other models, or browse popular chips below',
    alternatives: 'Alternatives',
    viewDetails: 'View Details',
    compatibility: 'Compatibility',
    pinCompatible: 'Pin-compatible',
    compatible: 'Compatible',
    similar: 'Similar',
    priceAdvantage: 'Price Advantage',
    backHome: 'Back to Home',
    relatedSearches: 'Related Searches'
  }
};

const text = t[locale];
const popularChips = ['STM32F103', 'LM358', 'ESP8266', 'LM7805', 'W25Q128', 'AT24C256', 'NE555', 'LM393'];

function getCompatibilityText(level: string): string {
  const map = {
    'pin-compatible': text.pinCompatible,
    'compatible': text.compatible,
    'similar': text.similar
  };
  return map[level] || level;
}
---

<Layout title={text.title}>
  <main class="search-page">
    <div class="container">
      <!-- Search Header -->
      <div class="search-header">
        <a href={`/?locale=${locale}`} class="back-link">← {text.backHome}</a>
        <h1>{text.results}: <span class="query">{query}</span></h1>
        <p class="result-count">{results.length} {locale === 'zh' ? '个匹配结果' : 'matches found'}</p>
      </div>

      {results.length > 0 ? (
        <div class="results-list">
          {results.map((chip: ChipReplacement) => (
            <article class="chip-card">
              <!-- Original Chip -->
              <div class="chip-original">
                <div class="chip-header">
                  <span class="brand">{chip.original.brand}</span>
                  <span class="model">{chip.original.model}</span>
                </div>
                <div class="chip-info">
                  <span class="category">{locale === 'zh' ? chip.original.categoryZh : chip.original.category}</span>
                  <span class="package">{chip.original.package}</span>
                </div>
                <p class="description">{locale === 'zh' ? chip.original.descriptionZh : chip.original.description}</p>
                <div class="specs-mini">
                  <span class="spec-item">📊 {Object.values(chip.original.specs)[0]}</span>
                  <span class="spec-item">⚡ {chip.original.price}</span>
                </div>
              </div>

              <!-- Alternatives -->
              <div class="alternatives-section">
                <h3>{text.alternatives} ({chip.alternatives.length})</h3>
                <div class="alt-grid">
                  {chip.alternatives.map((alt, idx) => (
                    <div class="alt-card" style={`animation-delay: ${idx * 100}ms`}>
                      <div class="alt-header">
                        <span class="alt-brand">{alt.brand}</span>
                        <span class="alt-model">{alt.model}</span>
                      </div>
                      <div class="alt-meta">
                        <span class={`compat-badge ${alt.compatibility}`}>
                          {getCompatibilityText(alt.compatibility)}
                        </span>
                        <span class="manufacturer">{alt.manufacturer}</span>
                      </div>
                      <div class="alt-advantages">
                        <p class="advantage-text">{locale === 'zh' ? alt.advantages.zh : alt.advantages.en}</p>
                        <span class="price-badge">{alt.priceAdvantage}</span>
                      </div>
                      <a href={`/chip/${chip.id}?locale=${locale}`} class="view-btn">
                        {text.viewDetails} →
                      </a>
                    </div>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="no-results">
          <div class="no-results-icon">🔍</div>
          <h2>{text.noResults}</h2>
          <p>{text.noResultsTip}</p>
          <div class="related-searches">
            <h3>{text.relatedSearches}:</h3>
            <div class="related-list">
              {popularChips.map(chip => (
                <a href={`/search?q=${chip}&locale=${locale}`} class="related-chip">{chip}</a>
              ))}
            </div>
          </div>
        </div>
      )}
    </div>
  </main>
</Layout>

<style>
  .search-page {
    min-height: 100vh;
    background: #f5f7fa;
    padding: 40px 20px;
  }
  
  .container {
    max-width: 1200px;
    margin: 0 auto;
  }
  
  .search-header {
    margin-bottom: 40px;
  }
  
  .back-link {
    color: #667eea;
    text-decoration: none;
    font-weight: 500;
    margin-bottom: 15px;
    display: inline-block;
  }
  
  .back-link:hover {
    text-decoration: underline;
  }
  
  .search-header h1 {
    font-size: 2rem;
    color: #333;
    margin-bottom: 10px;
  }
  
  .query {
    color: #667eea;
  }
  
  .result-count {
    color: #666;
  }
  
  .chip-card {
    background: white;
    border-radius: 20px;
    padding: 30px;
    margin-bottom: 30px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
  }
  
  .chip-original {
    border-bottom: 2px solid #f0f0f0;
    padding-bottom: 25px;
    margin-bottom: 25px;
  }
  
  .chip-header {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 10px;
  }
  
  .brand {
    background: #667eea;
    color: white;
    padding: 5px 12px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
  }
  
  .model {
    font-size: 1.8rem;
    font-weight: 700;
    color: #333;
  }
  
  .chip-info {
    display: flex;
    gap: 15px;
    margin-bottom: 10px;
  }
  
  .category {
    background: #f0f0f0;
    padding: 4px 12px;
    border-radius: 15px;
    font-size: 0.85rem;
  }
  
  .package {
    background: #e8f4ea;
    color: #2e7d32;
    padding: 4px 12px;
    border-radius: 15px;
    font-size: 0.85rem;
  }
  
  .description {
    color: #666;
    margin-bottom: 15px;
  }
  
  .specs-mini {
    display: flex;
    gap: 20px;
  }
  
  .spec-item {
    font-size: 0.9rem;
    color: #555;
  }
  
  .alternatives-section h3 {
    font-size: 1.2rem;
    margin-bottom: 20px;
    color: #333;
  }
  
  .alt-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }
  
  .alt-card {
    background: #f8f9fa;
    border-radius: 15px;
    padding: 20px;
    border: 2px solid transparent;
    transition: border-color 0.3s, transform 0.3s;
    animation: fadeInUp 0.5s ease-out forwards;
    opacity: 0;
  }
  
  .alt-card:hover {
    border-color: #667eea;
    transform: translateY(-3px);
  }
  
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .alt-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }
  
  .alt-brand {
    background: #4caf50;
    color: white;
    padding: 3px 10px;
    border-radius: 15px;
    font-size: 0.8rem;
    font-weight: 600;
  }
  
  .alt-model {
    font-size: 1.1rem;
    font-weight: 600;
    color: #333;
  }
  
  .alt-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 12px;
  }
  
  .compat-badge {
    padding: 3px 10px;
    border-radius: 10px;
    font-size: 0.75rem;
    font-weight: 600;
  }
  
  .compat-badge.pin-compatible {
    background: #e8f5e9;
    color: #2e7d32;
  }
  
  .compat-badge.compatible {
    background: #fff3e0;
    color: #e65100;
  }
  
  .compat-badge.similar {
    background: #e3f2fd;
    color: #1565c0;
  }
  
  .manufacturer {
    font-size: 0.8rem;
    color: #888;
  }
  
  .alt-advantages {
    margin-bottom: 15px;
  }
  
  .advantage-text {
    font-size: 0.9rem;
    color: #555;
    line-height: 1.5;
    margin-bottom: 10px;
  }
  
  .price-badge {
    display: inline-block;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 0.8rem;
    font-weight: 500;
  }
  
  .view-btn {
    display: inline-block;
    background: #667eea;
    color: white;
    padding: 10px 20px;
    border-radius: 25px;
    text-decoration: none;
    font-weight: 500;
    transition: background 0.3s;
  }
  
  .view-btn:hover {
    background: #5a6fd6;
  }
  
  .no-results {
    text-align: center;
    padding: 80px 20px;
    background: white;
    border-radius: 20px;
  }
  
  .no-results-icon {
    font-size: 4rem;
    margin-bottom: 20px;
  }
  
  .no-results h2 {
    color: #333;
    margin-bottom: 10px;
  }
  
  .no-results > p {
    color: #666;
    margin-bottom: 30px;
  }
  
  .related-searches h3 {
    font-size: 1rem;
    color: #666;
    margin-bottom: 15px;
  }
  
  .related-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }
  
  .related-chip {
    background: #f0f0f0;
    color: #333;
    padding: 10px 20px;
    border-radius: 25px;
    text-decoration: none;
    transition: background 0.3s;
  }
  
  .related-chip:hover {
    background: #667eea;
    color: white;
  }
</style>
