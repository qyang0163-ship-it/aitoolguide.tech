---
import Layout from '../layouts/Layout.astro';
---
<Layout title="美国对华芯片管制时间线" description="关键管制节点">
<div class="max-w-4xl mx-auto px-4 py-8">
<h1 class="text-4xl font-bold mb-8">管制时间线</h1>
<div class="relative border-l-2 border-[#0F4C81] ml-4 space-y-10">
{[{y:"2022.10",t:"BIS首次出台先进计算出口管制"},{y:"2023.08",t:"管制升级，新增实体清单"},{y:"2025.09",t:"23家中企入单，中国反制"},{y:"2025.12",t:"H200附加25%上缴条款"},{y:"2026.01",t:"BIS修订生效+232关税令"},{y:"2026.03-04",t:"芯片安全法案+MATCH+140实体"}].map(e=>(<div class="pl-8 relative"><div class="w-4 h-4 bg-[#0F4C81] rounded-full absolute -left-[9px] top-1"></div><h2 class="text-2xl font-bold">{e.y}</h2><p class="text-slate-600">{e.t}</p></div>))}
</div></div>
</Layout>