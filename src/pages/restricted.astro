---
import Layout from '../layouts/Layout.astro';
const restricted = (await import('../data/restricted.json')).default;
---
<Layout title="核心技术受限项追踪" description="受限项及国产替代进展">
<div class="max-w-7xl mx-auto px-4 py-8">
<h1 class="text-4xl font-bold mb-8">关键技术受限追踪</h1>
<div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
{restricted.map(r=>(<div class="card"><div class="flex justify-between mb-2"><span class="badge badge-blue">{r.category}</span><span class="text-xs font-bold text-red-600">{r.restrictionLevel}</span></div><h2 class="text-xl font-bold">{r.name}</h2><div class="mt-4 flex justify-between"><span class="text-sm">替代: {r.domesticAlt}</span><span class={`text-xs px-2 py-0.5 rounded ${r.maturity==='已量产'?'bg-green-50 text-green-700':'bg-yellow-50 text-yellow-700'}`}>{r.maturity}</span></div></div>))}
</div></div>
</Layout>