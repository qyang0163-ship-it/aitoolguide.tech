---
import Layout from '../layouts/Layout.astro';
const restricted = (await import('../data/restricted.json')).default;
---
<Layout title="受限芯片与设备追踪 | 国产替代方案对照" description="追踪美国对华限制的高端芯片、半导体设备、EDA软件，提供国产替代方案对照。" keywords="受限芯片,出口限制,国产替代,华为昇腾,光刻机,EDA软件,半导体设备">
<div class="max-w-7xl mx-auto px-4 py-8">
<nav class="breadcrumb mb-6"><a href="/">首页</a> / <span>受限追踪</span></nav>
<div class="mb-10">
<h1 class="text-4xl font-bold text-slate-900 mb-4">受限芯片与设备追踪</h1>
<p class="text-slate-600 text-lg">追踪美国对华限制的高端芯片、半导体设备、EDA软件，提供国产替代方案对照。</p>
</div>
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
<div class="card text-center"><p class="text-3xl font-bold text-[#0F4C81]">{restricted.length}</p><p class="text-slate-500 text-sm">受限项</p></div>
<div class="card text-center"><p class="text-3xl font-bold text-[#0F4C81]">{restricted.filter(r => r.category === '光刻').length}</p><p class="text-slate-500 text-sm">光刻设备</p></div>
<div class="card text-center"><p class="text-3xl font-bold text-[#0F4C81]">{restricted.filter(r => r.maturity === '已量产').length}</p><p class="text-slate-500 text-sm">已量产替代</p></div>
<div class="card text-center"><p class="text-3xl font-bold text-[#0F4C81]">{restricted.filter(r => r.maturity === '在研').length}</p><p class="text-slate-500 text-sm">在研替代</p></div>
</div>
<div class="flex gap-3 mb-8 flex-wrap">
<button class="px-4 py-2 bg-[#0F4C81] text-white rounded-full text-sm font-medium">全部</button>
<button class="px-4 py-2 bg-white border border-slate-200 text-slate-600 rounded-full text-sm">光刻</button>
<button class="px-4 py-2 bg-white border border-slate-200 text-slate-600 rounded-full text-sm">刻蚀</button>
<button class="px-4 py-2 bg-white border border-slate-200 text-slate-600 rounded-full text-sm">EDA</button>
<button class="px-4 py-2 bg-white border border-slate-200 text-slate-600 rounded-full text-sm">材料</button>
</div>
<div class="space-y-6">
{restricted.map(item => (
<div class="card">
<div class="flex flex-col lg:flex-row gap-6">
<div class="lg:w-1/2">
<div class="flex items-center gap-2 mb-2">
<span class="badge bg-red-100 text-red-800">{item.category}</span>
<span class="badge bg-slate-100 text-slate-600">{item.restrictionLevel}</span>
</div>
<h2 class="text-xl font-bold text-slate-900 mb-1">{item.name}</h2>
<div class="grid grid-cols-2 gap-4 mb-4">
<div>
<p class="text-xs text-slate-400">限制等级</p>
<p class="font-medium text-slate-700">{item.restrictionLevel}</p>
</div>
</div>
<div class="p-3 bg-red-50 rounded-lg">
<p class="text-xs text-red-600 font-medium mb-1">供应状态</p>
<p class="text-red-700">受限</p>
</div>
</div>
<div class="lg:w-1/2 lg:border-l lg:pl-6">
<h3 class="font-semibold text-slate-800 mb-3 flex items-center gap-2">
<svg class="w-5 h-5 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
国产替代
</h3>
<div class="p-4 bg-green-50 rounded-lg">
<p class="font-bold text-slate-800 text-lg mb-1">{item.domesticAlt}</p>
<p class="text-sm text-slate-600 mb-3">成熟度: {item.maturity}</p>
<div class="progress-bar">
<div class="progress-fill bg-green-500" style={`width: ${item.maturity === '已量产' ? '100%' : item.maturity === '已验证' ? '80%' : item.maturity === '在研' ? '50%' : '20%'}`}></div>
</div>
</div>
</div>
</div>
</div>
))}
</div>
</div>
</Layout>