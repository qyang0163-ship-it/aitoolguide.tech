---
import Layout from '../layouts/Layout.astro';
const equipment = (await import('../data/equipment.json')).default;
const icons = ['🔬','⚡','🎨','📏','⚛️','🔄','🧼','🔥','🎭','🤖','💨','⚡'];
const localization = [5, 45, 35, 25, 15, 40, 60, 55, 20, 10, 30, 25];
---
<Layout title="半导体设备 - 12大类 约1200种产品 | 国产替代指南" description="半导体设备分类导航：光刻、刻蚀、薄膜沉积、量测检测、离子注入、CMP、清洗、热处理、显影track、EFEM、真空泵、射频电源等12大类设备。" keywords="半导体设备,光刻机,刻蚀机,薄膜沉积,国产替代">
<div class="max-w-7xl mx-auto px-4 py-8">
<nav class="breadcrumb mb-6"><a href="/">首页</a> / <span>设备</span></nav>
<h1 class="text-4xl font-bold text-slate-900 mb-2">半导体设备</h1>
<p class="text-slate-600 mb-8">12大类 · 约1200种产品 · 国产化率实时追踪</p>
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
{equipment.map((eq, i) => (
<div class="card hover:shadow-lg transition-shadow">
<div class="flex items-center gap-3 mb-4">
<span class="text-3xl">{icons[i] || '🔧'}</span>
<h2 class="text-xl font-bold text-slate-800">{eq.category}</h2>
</div>
<div class="flex justify-between items-center mb-3">
<span class="text-slate-500 text-sm">国产化率</span>
<span class="font-bold text-[#0F4C81]">{localization[i]}%</span>
</div>
<div class="mb-4">
<span class={`badge ${localization[i] > 50 ? 'bg-green-100 text-green-700' : localization[i] > 30 ? 'bg-yellow-100 text-yellow-700' : 'bg-red-100 text-red-700'}`}>
{localization[i] > 50 ? '替代进展良好' : localization[i] > 30 ? '替代进行中' : '替代起步阶段'}
</span>
</div>
<div class="progress-bar">
<div class="progress-fill" style={`width: ${localization[i]}%; background: ${localization[i] > 50 ? '#22c55e' : localization[i] > 30 ? '#eab308' : '#ef4444'}`}></div>
</div>
<p class="text-xs text-slate-400 mt-2">数据整理中，敬请期待</p>
</div>
))}
</div>
</div>
</Layout>