---
import Layout from '../layouts/Layout.astro';
const policies = (await import('../data/policies.json')).default;
---
<Layout title="美国对华芯片政策库 | 出口管制与实体清单追踪" description="追踪美国对华半导体出口管制政策、实体清单更新、关税措施等关键政策节点。" keywords="出口管制,实体清单,芯片政策,美国制裁,BIS,关税,半导体政策">
<div class="max-w-7xl mx-auto px-4 py-8">
<nav class="breadcrumb mb-6"><a href="/">首页</a> / <span>政策库</span></nav>
<div class="mb-10">
<h1 class="text-4xl font-bold text-slate-900 mb-4">美国对华芯片政策库</h1>
<p class="text-slate-600 text-lg">追踪出口管制、实体清单、关税措施等关键政策节点，了解限制如何层层加码。</p>
</div>
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
<div class="card text-center"><p class="text-3xl font-bold text-[#0F4C81]">{policies.length}</p><p class="text-slate-500 text-sm">政策条目</p></div>
<div class="card text-center"><p class="text-3xl font-bold text-[#0F4C81]">{policies.filter(p => p.impactLevel === 'high').length}</p><p class="text-slate-500 text-sm">高影响</p></div>
<div class="card text-center"><p class="text-3xl font-bold text-[#0F4C81]">{policies.filter(p => p.category === '出口管制').length}</p><p class="text-slate-500 text-sm">出口管制</p></div>
<div class="card text-center"><p class="text-3xl font-bold text-[#0F4C81]">{policies.filter(p => p.category === '实体清单').length}</p><p class="text-slate-500 text-sm">实体清单</p></div>
</div>
<div class="space-y-6">
{policies.map(policy => (
<div class="card">
<div class="flex flex-col md:flex-row md:items-start gap-4">
<div class="md:w-32 flex-shrink-0">
<div class="text-sm font-semibold text-slate-500">{policy.date}</div>
<div class="badge mt-1" class:list={[policy.impactLevel === 'high' ? 'bg-red-100 text-red-800' : policy.impactLevel === 'medium' ? 'bg-yellow-100 text-yellow-800' : 'bg-green-100 text-green-800']}>
{policy.impactLevel === 'high' ? '高影响' : policy.impactLevel === 'medium' ? '中影响' : '低影响'}
</div>
</div>
<div class="flex-1">
<div class="flex items-center gap-2 mb-2">
<span class="badge bg-blue-100 text-blue-800">{policy.category}</span>
</div>
<h2 class="text-xl font-bold text-slate-900 mb-2">{policy.title}</h2>
<p class="text-slate-600 mb-3">{policy.summary}</p>
<div class="grid md:grid-cols-2 gap-4 mt-4 p-4 bg-slate-50 rounded-lg">
<div>
<h4 class="font-semibold text-slate-700 text-sm mb-1">受影响</h4>
<p class="text-slate-600 text-sm">{policy.affected.join(', ')}</p>
</div>
</div>
</div>
</div>
</div>
))}
</div>
</div>
</Layout>