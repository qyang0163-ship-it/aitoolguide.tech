---
import Layout from '../layouts/Layout.astro';
const policies = (await import('../data/policies.json')).default;
---
<Layout title="管制政策数据库" description="出口管制政策汇总">
<div class="max-w-7xl mx-auto px-4 py-8">
<h1 class="text-4xl font-bold mb-8">管制政策与法案数据库</h1>
<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
{policies.map(p=>(<div class="card"><div class="flex justify-between mb-2"><span class="text-xs text-slate-400">{p.date}</span><span class={`badge ${p.impactLevel==='high'?'bg-red-100 text-red-700':'bg-yellow-100 text-yellow-700'}`}>{p.impactLevel==='high'?'高影响':'中影响'}</span></div><h2 class="font-bold text-lg">{p.title}</h2><p class="text-sm text-slate-600">{p.summary}</p></div>))}
</div></div>
</Layout>