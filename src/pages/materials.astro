---
import Layout from '../layouts/Layout.astro';
const materials = (await import('../data/materials.json')).default;
const icons = ['💎','🧪','💨','⚗️','🎯','🧴','🔍','📦','🔗','🏺'];
---
<Layout title="半导体材料 - 10大类 约800种产品 | 国产替代指南" description="半导体材料分类导航：硅片、光刻胶、电子特气、CMP材料、靶材、湿电子化学品、光掩膜、封装基板、引线框架、陶瓷基板等10大类材料。" keywords="半导体材料,硅片,光刻胶,电子特气,国产替代">
<div class="max-w-7xl mx-auto px-4 py-8">
<nav class="breadcrumb mb-6"><a href="/">首页</a> / <span>材料</span></nav>
<h1 class="text-4xl font-bold text-slate-900 mb-2">半导体材料</h1>
<p class="text-slate-600 mb-8">10大类 · 约800种产品 · 替代成熟度实时追踪</p>
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
{materials.map((m, i) => (
<div class="card hover:shadow-lg transition-shadow">
<div class="flex items-center gap-3 mb-4">
<span class="text-3xl">{icons[i] || '📦'}</span>
<h2 class="text-xl font-bold text-slate-800">{m.category}</h2>
</div>
<div class="flex justify-between items-center mb-3">
<span class="text-slate-500 text-sm">产品数量</span>
<span class="font-bold text-[#0F4C81]">{m.items?.length || 0}</span>
</div>
<div class="mb-4">
<span class="badge bg-yellow-100 text-yellow-700">替代成熟度评估中</span>
</div>
<div class="progress-bar">
<div class="progress-fill bg-yellow-400" style="width: 30%"></div>
</div>
<p class="text-xs text-slate-400 mt-2">数据整理中，敬请期待</p>
</div>
))}
</div>
</div>
</Layout>