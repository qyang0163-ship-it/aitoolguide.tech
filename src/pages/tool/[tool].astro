---
import Layout from '../../layouts/Layout.astro';
import { chipsData } from '../../data/chips_db.js';

export function getStaticPaths() {
  return chipsData.map(chip => ({
    params: { tool: chip.id }
  }));
}

const { tool } = Astro.params;
const chip = chipsData.find(c => c.id === tool) || chipsData[0];
---

<Layout title={`${chip.us_chip.name} → ${chip.domestic_alternative.name}`}>
  <div class="hub" style="max-width:960px;margin:0 auto;padding:2rem 1.5rem;">
    <div class="terminal-bar" style="display:flex;align-items:center;gap:0.5rem;padding:0.5rem 1rem;background:#0a0a0a;border:1px solid #1a1a1a;border-radius:6px 6px 0 0;font-size:12px;color:#555;margin-bottom:-1px;">
      <span class="dot" style="width:8px;height:8px;border-radius:50%;display:inline-block;background:#ff5f56;"></span>
      <span class="dot" style="width:8px;height:8px;border-radius:50%;display:inline-block;background:#ffbd2e;"></span>
      <span class="dot" style="width:8px;height:8px;border-radius:50%;display:inline-block;background:#27c93f;"></span>
      <span style="margin-left:0.75rem;letter-spacing:0.1em;">chip-detail@platform:~</span>
    </div>
    <div class="terminal-body" style="background:#0a0a0a;border:1px solid #1a1a1a;border-top:none;border-radius:0 0 6px 6px;padding:2rem;position:relative;overflow:hidden;">
      <div style="position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,#00ff41,transparent);"></div>

      <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap;margin-bottom:1.5rem;padding-bottom:1.5rem;border-bottom:1px solid #1a1a1a;">
        <span style="font-size:10px;color:#555;letter-spacing:0.15em;">[{chip.id}]</span>
        <span class="match-score" style="font-size:12px;padding:0.25rem 0.75rem;border-radius:3px;color:${chip.match_score >= 85 ? '#00ff41' : chip.match_score >= 70 ? '#ffbd2e' : '#ff4444'};border:1px solid ${chip.match_score >= 85 ? '#00ff4133' : chip.match_score >= 70 ? '#ffbd2e33' : '#ff444433'};">匹配度: {chip.match_score}%</span>
        <span style="font-size:11px;color:#555;">{chip.last_updated}</span>
      </div>

      <div class="chip-vs" style="display:flex;align-items:center;justify-content:center;gap:2rem;margin:2rem 0;flex-wrap:wrap;">
        <div class="chip-side us" style="text-align:center;flex:1;min-width:250px;">
          <span style="font-size:11px;color:#ff4444;">⛔ RESTRICTED</span>
          <h2 style="font-size:1.5rem;font-weight:700;color:#ff4444;margin:0.5rem 0;">{chip.us_chip.name}</h2>
          <div style="font-size:12px;color:#555;">{chip.us_chip.vendor} · {chip.us_chip.tier} 级</div>
          <div style="font-size:11px;color:#555;margin-top:0.75rem;padding:0.75rem;background:#000;border:1px solid #1a1a1a;border-radius:4px;text-align:left;">
            {Object.entries(chip.us_chip.specs).map(([k, v]) => (
              <div><span style="color:#ff4444;">{k}:</span> {v}</div>
            ))}
          </div>
          <div style="margin-top:0.75rem;padding:0.75rem;background:#000;border:1px solid #1a1a1a;border-radius:4px;text-align:left;">
            <div style="color:#ff4444;font-size:11px;margin-bottom:0.5rem;">限制条款:</div>
            {chip.us_chip.restrictions.map(r => (
              <div style="color:#555;font-size:11px;">▸ {r}</div>
            ))}
          </div>
          <div style="margin-top:0.5rem;color:#555;font-size:12px;">报价: {chip.us_chip.price_per_unit}</div>
        </div>
        <div style="font-size:14px;font-weight:700;color:#00e5ff;padding:0.25rem 1rem;border:1px solid #00e5ff;border-radius:50%;flex-shrink:0;">VS</div>
        <div class="chip-side cn" style="text-align:center;flex:1;min-width:250px;">
          <span style="font-size:11px;color:#00ff41;">✓ AVAILABLE</span>
          <h2 style="font-size:1.5rem;font-weight:700;color:#00ff41;margin:0.5rem 0;">{chip.domestic_alternative.name}</h2>
          <div style="font-size:12px;color:#555;">{chip.domestic_alternative.vendor} · {chip.domestic_alternative.tier} 级</div>
          <div style="font-size:11px;color:#555;margin-top:0.75rem;padding:0.75rem;background:#000;border:1px solid #1a1a1a;border-radius:4px;text-align:left;">
            {Object.entries(chip.domestic_alternative.specs).map(([k, v]) => (
              <div><span style="color:#00ff41;">{k}:</span> {v}</div>
            ))}
          </div>
          <div style="margin-top:0.75rem;padding:0.75rem;background:#000;border:1px solid #1a1a1a;border-radius:4px;text-align:left;">
            <div style="color:#00ff41;font-size:11px;margin-bottom:0.5rem;">替代优势:</div>
            {chip.domestic_alternative.advantages.map(a => (
              <div style="color:#555;font-size:11px;">▸ {a}</div>
            ))}
          </div>
          <div style="margin-top:0.5rem;color:#00ff41;font-size:12px;">报价: {chip.domestic_alternative.price_per_unit} · {chip.domestic_alternative.availability}</div>
        </div>
      </div>

      <div style="display:flex;gap:0.75rem;margin-top:1.5rem;flex-wrap:wrap;">
        <a href="/" style="font-size:12px;padding:0.5rem 1rem;border:1px solid #1a1a1a;border-radius:4px;text-decoration:none;color:#00ff41;">← 返回总览</a>
        <a href="/api/search?q={chip.us_chip.name}" style="font-size:12px;padding:0.5rem 1rem;border:1px solid #1a1a1a;border-radius:4px;text-decoration:none;color:#00e5ff;">🔗 API 查询</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .terminal-bar .dot{width:8px;height:8px;border-radius:50%;display:inline-block}.dot.red{background:#ff5f56}.dot.yellow{background:#ffbd2e}.dot.green{background:#27c93f}
</style>
