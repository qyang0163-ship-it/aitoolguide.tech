---
import Layout from '../layouts/Layout.astro';
const enterprises = (await import('../data/enterprises.json')).default;
const chips = (await import('../data/chips.json')).default;
const policies = (await import('../data/policies.json')).default;
---
<Layout title="国产芯片替代指南" description="追踪芯片管制，验证国产替代。数据来源：BIS联邦公报、企业公告、海关总署。">
<div class="max-w-4xl mx-auto px-4">
<!-- 搜索区 -->
<section class="pt-12 pb-6">
<div class="relative mb-3">
<svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
<input type="text" placeholder="搜索芯片型号，如STM32F103C8T6" class="w-full pl-9 pr-3 py-2.5 text-sm border border-gray-200 rounded focus:outline-none focus:border-gray-300">
</div>
<div class="flex gap-2">
{['STM32替代','电源芯片','RISC-V','AI芯片'].map(k => (
<button class="px-2.5 py-1 text-xs text-gray-500 bg-gray-50 rounded hover:bg-gray-100">{k}</button>
))}
</div>
</section>
<!-- 分割线 -->
<div class="h-px bg-gray-100"></div>
<!-- 数据指标 -->
<section class="py-6">
<div class="grid grid-cols-4 gap-4 text-center">
<div>
<div class="text-2xl font-bold text-blue-900">{chips.length}</div>
<div class="text-xs text-gray-400 mt-0.5">收录芯片</div>
</div>
<div>
<div class="text-2xl font-bold text-blue-900">{policies.length}</div>
<div class="text-xs text-gray-400 mt-0.5">最新政策</div>
</div>
<div>
<div class="text-2xl font-bold text-blue-900">9</div>
<div class="text-xs text-gray-400 mt-0.5">受限项</div>
</div>
<div>
<div class="text-2xl font-bold text-blue-900">{enterprises.length}</div>
<div class="text-xs text-gray-400 mt-0.5">制裁企业</div>
</div>
</div>
</section>
<!-- 热门芯片 -->
<section class="py-6">
<h2 class="text-xs font-medium text-gray-400 mb-4">热门替代方案</h2>
<div class="grid grid-cols-3 gap-3">
{chips.slice(0,3).map(chip => (
<a href={`/chip/${chip.id}`} class="block py-3 border-b border-gray-50 hover:bg-gray-50">
<div class="flex justify-between items-start">
<div>
<div class="text-sm font-semibold text-gray-900">{chip.name}</div>
<div class="text-xs text-gray-400 mt-0.5">{chip.manufacturer}</div>
<div class="text-xs text-gray-400 mt-1">替代 {chip.originalEquivalent}</div>
</div>
<div class="text-right">
<div class="text-sm font-bold text-orange-500">{chip.price}</div>
<span class={`inline-block mt-1 text-xs px-1.5 py-0.5 rounded ${chip.substituteLevel==='pin2pin'?'bg-green-50 text-green-600':'bg-blue-50 text-blue-600'}`}>
{chip.substituteLevel==='pin2pin'?'P2P':'功能'}
</span>
</div>
</div>
</a>
))}
</div>
</section>
<!-- 最新管制动态 -->
<section class="py-6">
<h2 class="text-xs font-medium text-gray-400 mb-4">最新管制动态</h2>
<div class="space-y-2">
{policies.slice(0,3).map(p => (
<div class="flex items-center gap-3 py-2">
<span class="text-xs text-gray-400 w-16">{p.date}</span>
<span class="flex-1 text-sm text-gray-700">{p.title}</span>
<span class={`text-xs px-1.5 py-0.5 rounded ${p.impactLevel==='high'?'bg-red-50 text-red-600':p.impactLevel==='medium'?'bg-yellow-50 text-yellow-600':'bg-green-50 text-green-600'}`}>
{p.impactLevel==='high'?'高':p.impactLevel==='medium'?'中':'低'}
</span>
</div>
))}
</div>
</section>
</div>
<!-- Footer -->
<footer class="py-6 text-center text-xs text-gray-300">
<p>数据来源：BIS联邦公报·企业公告·海关总署·2026年构造</p>
</footer>
</Layout>