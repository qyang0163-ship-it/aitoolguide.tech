---
import Layout from '../layouts/Layout.astro';
const chips = (await import('../data/chips.json')).default;
const policies = (await import('../data/policies.json')).default;
const restricted = (await import('../data/restricted.json')).default;
---
<Layout title="国产芯片替代指南" description="国产替代芯片数据库">
<section class="text-center py-16 px-4">
 <h1 class="text-5xl font-extrabold mb-4">国产芯片替代<span class="text-[#0F4C81]">智能选型</span></h1>
 <p class="text-xl text-slate-600 mb-4"><span class="font-bold">{chips.length}</span>款国产替代芯片</p>
 <p class="text-sm text-slate-400 mb-8">数据来源：BIS联邦公报、企业公告、海关总署</p>
 <div class="flex justify-center gap-4 flex-wrap mb-8"><a href="/chips" class="btn-primary">浏览芯片库</a><a href="/policy" class="btn-secondary">管制政策</a></div>
 <input type="text" placeholder="输入型号如 STM32F103C8T6" class="search-input" onkeydown="if(event.key==='Enter')window.location.href='/chips?search='+this.value">
</section>
<section class="max-w-7xl mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
 <div class="card text-center"><div class="text-4xl font-bold text-[#0F4C81]">{chips.length}</div><div>国产替代芯片</div></div>
 <div class="card text-center"><div class="text-4xl font-bold text-[#E48736]">{policies.length}</div><div>管制政策</div></div>
 <div class="card text-center"><div class="text-4xl font-bold">{restricted.length}</div><div>受限项</div></div>
</section>
<section class="max-w-7xl mx-auto px-4 mb-16">
 <h2 class="text-3xl font-bold mb-6">热门替代</h2>
 <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
 {chips.slice(0,6).map(chip=>(<a href={`/chip/${chip.id}`} class="card block"><div class="flex justify-between"><h3 class="font-bold">{chip.name}</h3><span class="badge badge-green">P2P</span></div><p class="text-sm">替代 {chip.originalEquivalent}</p><div class="mt-3 flex justify-between"><span class="text-[#E48736] font-bold">{chip.price}</span><span class="text-xs text-slate-400">{chip.manufacturer}</span></div></a>))}
 </div>
</section>
</Layout>