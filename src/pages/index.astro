---
import Layout from '../layouts/Layout.astro';
const chips = (await import('../data/chips.json')).default;
const policies = (await import('../data/policies.json')).default;
const restricted = (await import('../data/restricted.json')).default;
---
<Layout title="国产芯片替代指南 | P2P兼容参数对比与技术手册" description="收录20+款国产替代芯片，提供引脚兼容比对、技术手册下载，追踪美国对华芯片管制政策。" keywords="国产替代,芯片选型,P2P兼容,STM32替代,出口管制">
<div class="max-w-7xl mx-auto px-4 py-8">
<div class="text-center mb-16 py-12">
<h1 class="text-5xl font-extrabold text-slate-900 mb-6">国产芯片替代指南</h1>
<p class="text-xl text-slate-600 max-w-2xl mx-auto mb-8">引脚兼容、性能对比、手册下载——找到最合适的平替方案。应对出口管制，实现供应链自主可控。</p>
<div class="flex justify-center gap-4 flex-wrap">
<a href="/chips" class="btn-primary">浏览芯片库</a>
<a href="/restricted" class="btn-secondary">查看受限追踪</a>
</div>
</div>
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
<div class="card text-center"><p class="text-3xl font-bold text-[#0F4C81]">{chips.length}</p><p class="text-slate-500 text-sm">收录芯片</p></div>
<div class="card text-center"><p class="text-3xl font-bold text-[#0F4C81]">{policies.length}</p><p class="text-slate-500 text-sm">政策条目</p></div>
<div class="card text-center"><p class="text-3xl font-bold text-[#0F4C81]">{restricted.length}</p><p class="text-slate-500 text-sm">受限项</p></div>
<div class="card text-center"><p class="text-3xl font-bold text-[#E48736]">100%</p><p class="text-slate-500 text-sm">免费手册</p></div>
</div>
<div class="mb-12">
<div class="flex justify-between items-center mb-6">
<h2 class="text-2xl font-bold text-slate-800">精选替代方案</h2>
<a href="/chips" class="text-[#0F4C81] hover:underline text-sm font-medium">查看全部 →</a>
</div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
{chips.slice(0,6).map(chip => (
<a href={`/chip/${chip.id}`} class="card block hover:shadow-lg transition-shadow">
<div class="flex justify-between items-start mb-3">
<div>
<h3 class="text-lg font-bold text-slate-800">{chip.name}</h3>
<p class="text-sm text-slate-500">替代 {chip.originalEquivalent}</p>
</div>
<span class="badge badge-green">{chip.substituteLevel === 'pin2pin' ? 'P2P' : '功能'}</span>
</div>
<div class="flex gap-2 mb-4 flex-wrap">
{Object.entries(chip.specs).slice(0,2).map(([k,v]) => (
<span class="text-xs text-slate-600 bg-slate-50 border border-slate-100 px-2 py-1 rounded">{k}: {v}</span>
))}
</div>
<div class="flex justify-between items-center pt-4 border-t border-slate-100">
<span class="text-[#E48736] font-bold">{chip.price}</span>
<span class="text-slate-400 text-sm">{chip.manufacturer}</span>
</div>
</a>
))}
</div>
</div>
<div class="mb-12">
<div class="flex justify-between items-center mb-6">
<h2 class="text-2xl font-bold text-slate-800">最新管制动态</h2>
<a href="/policy" class="text-[#0F4C81] hover:underline text-sm font-medium">查看政策库 →</a>
</div>
<div class="card bg-gradient-to-br from-slate-800 to-slate-900 text-white">
<div class="flex items-start gap-4">
<div class="bg-red-500 rounded-full p-2 flex-shrink-0">
<svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
</div>
<div class="flex-1">
<h3 class="text-xl font-bold mb-2">{policies[0].title}</h3>
<p class="text-slate-300 mb-4">{policies[0].summary}</p>
<div class="flex gap-4 text-sm">
<span class="text-slate-400">发布日期: {policies[0].date}</span>
<span class="text-slate-400">影响: {policies[0].impact}</span>
</div>
</div>
<a href="/policy" class="btn-primary text-sm py-2 px-4 flex-shrink-0">查看详情</a>
</div>
</div>
</div>
<div class="text-center py-12">
<h2 class="text-2xl font-bold text-slate-800 mb-4">需要技术支持？</h2>
<p class="text-slate-600 mb-6 max-w-xl mx-auto">获取样品、技术手册、替代方案咨询，一对一技术支持。</p>
<a href="/contact" class="btn-primary">联系工程师</a>
</div>
</div>
</Layout>