---
import Layout from '../layouts/Layout.astro';
const chips = (await import('../data/chips.json')).default;
const policies = (await import('../data/policies.json')).default;
const enterprises = (await import('../data/enterprises.json')).default;

const stats = [
  { label: '收录芯片', value: chips.length, sub: 'CATALOGED' },
  { label: '管制政策', value: policies.length, sub: 'POLICIES' },
  { label: '受限项', value: 15, sub: 'RESTRICTED' },
  { label: '制裁企业', value: enterprises.length, sub: 'SANCTIONED' },
];

const featuredChips = chips.slice(0, 6);
---
<Layout title="SCIP MONITOR | 半导体产业监控台" description="半导体全产业链替代监控平台">
<nav class="fixed top-0 left-0 right-0 z-50 bg-slate-950/80 backdrop-blur-md border-b border-slate-800">
<div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
<div class="flex items-center gap-3">
<div class="w-8 h-8 bg-gradient-to-br from-cyan-500 to-blue-600 rounded-lg flex items-center justify-center">
<span class="text-white font-bold text-sm">S</span>
</div>
<span class="text-cyan-400 font-bold tracking-wider">SCIP MONITOR</span>
<span class="text-slate-500 text-xs ml-2">v2.0.26</span>
</div>
<div class="flex items-center gap-1">
{['设备','材料','EDA/IP','芯片','企业','政策'].map((item) => (
<a href={`/${item === 'EDA/IP' ? 'eda-ip' : item.toLowerCase()}`} 
   class="px-4 py-2 text-xs font-medium rounded-lg border border-slate-700 text-slate-400 hover:text-cyan-400 hover:border-cyan-500/30 transition-all">
{item}
</a>
))}
</div>
</div>
</nav>

<div class="pt-20 pb-8 min-h-screen">
<div class="max-w-7xl mx-auto px-6">

<section class="mb-8">
<div class="bg-slate-900/50 backdrop-blur-md rounded-2xl border border-slate-800 p-6">
<div class="flex items-center gap-4 mb-4">
<div class="flex items-center gap-2 text-slate-500 text-xs font-mono">
<span>X:45.2</span><span class="text-slate-700">|</span><span>Y:23.8</span><span class="text-slate-700">|</span><span>Z:89.1</span>
</div>
<div class="flex-1 text-center"><span class="text-cyan-400/60 text-xs tracking-widest">SYSTEM READY</span></div>
<div class="flex items-center gap-2 text-slate-500 text-xs font-mono">
<span>CPU:12%</span><span class="text-slate-700">|</span><span>MEM:34%</span>
</div>
</div>
<div class="flex items-center gap-3 bg-slate-950 rounded-xl border border-slate-800 p-1">
<span class="text-cyan-500 font-mono text-sm pl-4">$</span>
<input type="text" placeholder="search --model STM32F103C8T6 --category MCU" class="flex-1 bg-transparent outline-none text-sm font-mono text-cyan-400 placeholder-cyan-600/50 px-3 py-3"/>
<button class="px-6 py-3 bg-cyan-500/20 text-cyan-400 text-xs font-mono rounded-lg border border-cyan-500/30 hover:bg-cyan-500/30 transition-colors">EXECUTE</button>
</div>
<div class="flex justify-center gap-6 mt-4">
{['#STM32替代','#AI芯片','#光刻胶','#实体清单'].map(tag => (
<span class="text-xs text-slate-500 font-mono cursor-pointer hover:text-cyan-400 transition-colors">{tag}</span>
))}
</div>
</div>
</section>

<section class="mb-8">
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
{stats.map((stat) => (
<div class="relative bg-slate-900/50 backdrop-blur-md rounded-2xl border border-slate-800 p-6 overflow-hidden group hover:border-cyan-500/30 transition-all">
<div class="absolute top-0 right-0 w-20 h-20 bg-cyan-500/10 rounded-full blur-2xl group-hover:bg-cyan-500/20 transition-all"></div>
<div class="relative z-10">
<div class="text-4xl font-bold text-cyan-400 drop-shadow-[0_0_8px_rgba(34,211,238,0.8)] mb-1">{stat.value}</div>
<div class="text-slate-400 text-sm mb-1">{stat.label}</div>
<div class="text-xs text-cyan-500/60 font-mono tracking-wider">{stat.sub}</div>
</div>
<div class="absolute bottom-4 right-4 w-2 h-2 rounded-full bg-cyan-500 animate-pulse"></div>
</div>
))}
</div>
</section>

<section class="mb-8">
<div class="flex items-center justify-between mb-4">
<h2 class="text-cyan-400 font-bold flex items-center gap-2">
<span class="w-2 h-2 bg-cyan-400 rounded-full animate-pulse"></span>
热门替代芯片
</h2>
<span class="text-xs text-slate-500 font-mono">LIVE DATA</span>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
{featuredChips.map((chip, i) => (
<div class="bg-slate-900/50 backdrop-blur-md rounded-2xl border border-slate-800 p-5 hover:border-cyan-500/30 transition-all group relative overflow-hidden">
<div class="absolute inset-0 opacity-5">
<svg class="w-full h-full" viewBox="0 0 200 60" preserveAspectRatio="none">
<polyline fill="none" stroke="#06b6d4" stroke-width="0.5" points="0,50 40,40 80,45 120,30 160,35 200,20"/>
</svg>
</div>
<div class="relative z-10">
<div class="flex justify-between items-start mb-3">
<div>
<div class="font-bold text-cyan-400 group-hover:drop-shadow-[0_0_8px_rgba(34,211,238,0.8)] transition-all">{chip.name}</div>
<div class="text-xs text-slate-400 mt-1">{chip.manufacturer}</div>
</div>
<span class={`text-xs px-2 py-0.5 rounded border ${chip.substituteLevel === 'pin2pin' ? 'bg-cyan-500/10 border-cyan-500/30 text-cyan-400' : 'bg-violet-500/10 border-violet-500/30 text-violet-400'}`}>
{chip.substituteLevel === 'pin2pin' ? 'P2P' : 'FUNC'}
</span>
</div>
<div class="flex justify-between items-end">
<div>
<div class="text-xs text-slate-500 mb-1">替代 {chip.originalEquivalent}</div>
<div class="text-lg font-bold text-amber-400">{chip.price}</div>
</div>
<div class="text-right">
<div class="text-xs text-slate-500 mb-1">成熟度</div>
<div class="w-16 h-1 bg-slate-800 rounded-full overflow-hidden">
<div class="h-full bg-gradient-to-r from-cyan-500 to-violet-500" style={`width: ${60 + i * 8}%`}></div>
</div>
</div>
</div>
</div>
</div>
))}
</div>
</section>

<section class="mb-8">
<div class="flex items-center justify-between mb-4">
<h2 class="text-rose-400 font-bold flex items-center gap-2">
<span class="w-2 h-2 bg-rose-400 rounded-full animate-pulse"></span>
管制动态监控
</h2>
<span class="text-xs text-slate-500 font-mono">REAL-TIME</span>
</div>
<div class="bg-slate-900/50 backdrop-blur-md rounded-2xl border border-slate-800">
{policies.slice(0, 4).map((p, i) => (
<div class={`flex items-center gap-4 px-5 py-4 ${i !== 3 ? 'border-b border-slate-800' : ''} hover:bg-slate-800/30 transition-colors cursor-pointer`}>
<div class="w-16 text-xs text-slate-500 font-mono">{p.date}</div>
<div class="flex-1">
<div class="text-sm text-slate-200">{p.title}</div>
</div>
<span class={`text-xs px-2 py-0.5 rounded border ${p.impactLevel === 'high' ? 'bg-rose-500/10 border-rose-500/30 text-rose-400' : p.impactLevel === 'medium' ? 'bg-amber-500/10 border-amber-500/30 text-amber-400' : 'bg-cyan-500/10 border-cyan-500/30 text-cyan-400'}`}>
{p.impactLevel === 'high' ? 'CRITICAL' : p.impactLevel === 'medium' ? 'WARNING' : 'INFO'}
</span>
</div>
))}
</div>
</section>

</div>
</div>

<footer class="border-t border-slate-800 py-6">
<div class="max-w-7xl mx-auto px-6 text-center">
<p class="text-xs text-slate-500 font-mono">
<span class="text-cyan-400">SCIP MONITOR</span> · BIS联邦公报 · 企业公告 · 海关总署 · 2026
</p>
</div>
</footer>
</Layout>