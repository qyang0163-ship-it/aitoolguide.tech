---
import Layout from '../layouts/Layout.astro';
const chips = (await import('../data/chips.json')).default;
const policies = (await import('../data/policies.json')).default;
const enterprises = (await import('../data/enterprises.json')).default;

const navItems = [
  { name: '设备', icon: '⚡', color: 'cyber-blue' },
  { name: '材料', icon: '🔬', color: 'logic-purple' },
  { name: 'EDA/IP', icon: '💻', color: 'chip-gold' },
  { name: '芯片', icon: '🧩', color: 'cyber-blue' },
  { name: '企业', icon: '🏢', color: 'alert-red' },
  { name: '政策', icon: '📋', color: 'cyber-blue' },
];

const stats = [
  { label: '收录芯片', value: chips.length, color: 'cyber-blue' },
  { label: '管制政策', value: policies.length, color: 'alert-red' },
  { label: '受限项', value: 15, color: 'logic-purple' },
  { label: '制裁企业', value: enterprises.length, color: 'chip-gold' },
];

const featuredChips = chips.slice(0, 6);
---
<Layout title="半导体产业监控台 | SCIP MONITOR" description="半导体全产业链替代监控平台，实时追踪芯片管制与国产替代进展。">
<!-- 顶部导航条 -->
<nav class="fixed top-0 left-0 right-0 z-50 bg-slate-950/90 backdrop-blur border-b border-cyber-blue/20">
<div class="max-w-7xl mx-auto px-4 h-14 flex items-center justify-between">
<div class="flex items-center gap-2">
<span class="text-cyber-blue text-lg">◈</span>
<span class="font-bold text-cyber-blue glow-text">SCIP MONITOR</span>
<span class="text-xs text-slate-500 ml-2">v2.0.26</span>
</div>
<div class="flex items-center gap-1">
{navItems.map(item => (
<a href={`/${item.name === 'EDA/IP' ? 'eda-ip' : item.name.toLowerCase()}`} 
   class={`px-3 py-1.5 text-xs rounded border transition-all hover:glow-border
   ${item.color === 'cyber-blue' ? 'border-cyber-blue/30 text-cyber-blue hover:bg-cyber-blue/10' :
     item.color === 'alert-red' ? 'border-alert-red/30 text-alert-red hover:bg-alert-red/10' :
     item.color === 'logic-purple' ? 'border-logic-purple/30 text-logic-purple hover:bg-logic-purple/10' :
     'border-chip-gold/30 text-chip-gold hover:bg-chip-gold/10'}`}>
<span class="mr-1">{item.icon}</span>{item.name}
</a>
))}
</div>
</div>
</nav>

<!-- 主内容区 -->
<div class="pt-20 pb-8">
<div class="max-w-6xl mx-auto px-4">
<!-- Hero & 搜索 -->
<section class="text-center mb-12">
<h1 class="text-3xl font-bold text-cyber-blue glow-text mb-2">半导体产业监控台</h1>
<p class="text-sm text-slate-400 mb-8">SEMICONDUCTOR INDUSTRY CONTROL PLATFORM</p>

<!-- 终端风格搜索框 -->
<div class="max-w-xl mx-auto">
<div class="flex items-center gap-2 bg-slate-900/50 rounded-lg p-1 border border-cyber-blue/30 glow-border">
<span class="text-cyber-blue/60 text-xs pl-3">$</span>
<input type="text" 
       placeholder="search --model STM32F103C8T6 --category MCU" 
       class="flex-1 bg-transparent outline-none text-sm text-cyber-blue terminal-input px-2 py-2"
/>
<button class="px-4 py-2 bg-cyber-blue/20 text-cyber-blue text-xs rounded border border-cyber-blue/50 hover:bg-cyber-blue/30 transition-colors">
EXECUTE
</button>
</div>
<div class="flex justify-center gap-2 mt-3">
{['STM32替代', 'AI芯片', '光刻胶', '实体清单'].map(k => (
<span class="text-xs text-slate-500 cursor-pointer hover:text-cyber-blue transition-colors">#{k}</span>
))}
</div>
</div>
</section>

<!-- 统计面板 -->
<section class="mb-12">
<div class="grid grid-cols-4 gap-4">
{stats.map(stat => (
<div class={`scanline relative bg-slate-900/50 rounded-lg p-4 border border-${stat.color}/30 glow-border`}>
<div class={`text-3xl font-bold text-${stat.color} glow-text`}>{stat.value}</div>
<div class="text-xs text-slate-400 mt-1">{stat.label}</div>
<div class={`absolute top-2 right-2 w-2 h-2 rounded-full bg-${stat.color}/50 animate-pulse`}></div>
</div>
))}
</div>
</section>

<!-- 热门替代芯片 -->
<section class="mb-12">
<div class="flex items-center justify-between mb-6">
<h2 class="text-lg font-bold text-cyber-blue flex items-center gap-2">
<span class="w-2 h-2 bg-cyber-blue rounded-full animate-pulse"></span>
热门替代芯片
</h2>
<span class="text-xs text-slate-500">LIVE DATA</span>
</div>
<div class="grid grid-cols-3 gap-4">
{featuredChips.map((chip, i) => (
<div class="card-glitch bg-slate-900/50 rounded-lg p-4 border border-slate-700/50 hover:border-cyber-blue/30 transition-all cursor-pointer group">
<div class="flex justify-between items-start mb-3">
<div>
<div class="font-bold text-cyber-blue group-hover:glow-text transition-all">{chip.name}</div>
<div class="text-xs text-slate-400 mt-1">{chip.manufacturer}</div>
</div>
<span class={`text-xs px-2 py-0.5 rounded ${chip.substituteLevel === 'pin2pin' ? 'badge-cyber' : 'badge-purple'}`}>
{chip.substituteLevel === 'pin2pin' ? 'P2P' : 'FUNC'}
</span>
</div>
<div class="flex justify-between items-end">
<div>
<div class="text-xs text-slate-500 mb-1">替代 {chip.originalEquivalent}</div>
<div class="text-lg font-bold text-chip-gold">{chip.price}</div>
</div>
<div class="text-right">
<div class="text-xs text-slate-500 mb-1">成熟度</div>
<div class="w-16 h-1 bg-slate-700 rounded-full overflow-hidden">
<div class="h-full bg-gradient-to-r from-cyber-blue to-logic-purple" style={`width: ${60 + i * 10}%`}></div>
</div>
</div>
</div>
<div class="mt-3 pt-3 border-t border-slate-700/30">
<div class="flex items-center gap-2">
<svg class="w-8 h-4 text-cyber-blue/50" viewBox="0 0 32 16">
<polyline fill="none" stroke="currentColor" stroke-width="1" points="0,8 4,6 8,10 12,4 16,8 20,5 24,9 28,7 32,8"/>
</svg>
<span class="text-xs text-slate-500">价格趋势</span>
</div>
</div>
</div>
))}
</div>
</section>

<!-- 最新管制动态 -->
<section class="mb-12">
<div class="flex items-center justify-between mb-6">
<h2 class="text-lg font-bold text-alert-red flex items-center gap-2">
<span class="w-2 h-2 bg-alert-red rounded-full animate-pulse"></span>
管制动态监控
</h2>
<span class="text-xs text-slate-500">REAL-TIME ALERTS</span>
</div>
<div class="bg-slate-900/30 rounded-lg border border-slate-700/50">
{policies.slice(0, 5).map((p, i) => (
<div class={`flex items-center gap-4 px-4 py-3 ${i !== 4 ? 'border-b border-slate-700/30' : ''} hover:bg-slate-800/30 transition-colors cursor-pointer`}>
<div class="w-16 text-xs text-slate-500 font-mono">{p.date}</div>
<div class="flex-1">
<div class="text-sm text-slate-200">{p.title}</div>
<div class="text-xs text-slate-500 mt-0.5">{p.summary.slice(0, 40)}...</div>
</div>
<span class={`text-xs px-2 py-0.5 rounded ${p.impactLevel === 'high' ? 'badge-alert' : p.impactLevel === 'medium' ? 'badge-gold' : 'badge-cyber'}`}>
{p.impactLevel === 'high' ? 'CRITICAL' : p.impactLevel === 'medium' ? 'WARNING' : 'INFO'}
</span>
</div>
))}
</div>
</section>

<!-- 产业链状态 -->
<section class="mb-12">
<h2 class="text-lg font-bold text-logic-purple mb-6 flex items-center gap-2">
<span class="w-2 h-2 bg-logic-purple rounded-full"></span>
产业链替代进度
</h2>
<div class="grid grid-cols-4 gap-4">
{[
  { name: '光刻设备', progress: 15, status: 'CRITICAL' },
  { name: '刻蚀设备', progress: 45, status: 'WARNING' },
  { name: '薄膜沉积', progress: 35, status: 'WARNING' },
  { name: '量测检测', progress: 25, status: 'CRITICAL' },
].map(item => (
<div class="bg-slate-900/50 rounded-lg p-4 border border-slate-700/50">
<div class="flex justify-between items-center mb-2">
<span class="text-sm text-slate-300">{item.name}</span>
<span class={`text-xs ${item.status === 'CRITICAL' ? 'text-alert-red' : 'text-chip-gold'}`}>{item.status}</span>
</div>
<div class="w-full h-2 bg-slate-800 rounded-full overflow-hidden">
<div class="h-full bg-gradient-to-r from-cyber-blue to-logic-purple" style={`width: ${item.progress}%`}></div>
</div>
<div class="text-right text-xs text-cyber-blue mt-1">{item.progress}%</div>
</div>
))}
</div>
</section>
</div>
</div>

<!-- 底部 -->
<footer class="border-t border-slate-800/50 py-6">
<div class="max-w-6xl mx-auto px-4 text-center">
<p class="text-xs text-slate-500">
<span class="text-cyber-blue">SCIP MONITOR</span> · 数据来源: BIS联邦公报 · 企业公告 · 海关总署 · 2026
</p>
</div>
</footer>
</Layout>