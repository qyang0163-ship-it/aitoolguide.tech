---
import Layout from '../layouts/Layout.astro';
const chips = (await import('../data/chips.json')).default;
const policies = (await import('../data/policies.json')).default;
---
<Layout title="国产芯片替代数据库" description="收录27款替代方案，覆盖MCU/AI芯片/电源/无线，数据可追溯至BIS联邦公报与企业公告。">
<div class="max-w-3xl mx-auto px-6 py-16">
<!-- 第一屏：标题与搜索 -->
<section class="text-center mb-16">
<h1 class="text-2xl font-bold text-gray-900 mb-3">国产芯片替代数据库</h1>
<p class="text-sm text-gray-400 mb-8">收录27款替代方案 · 覆盖MCU/AI芯片/电源/无线 · 数据可追溯至BIS联邦公报与企业公告</p>
<div class="flex justify-center">
<div class="flex items-center border border-gray-200 rounded overflow-hidden">
<svg class="w-4 h-4 text-gray-400 ml-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
<input type="text" placeholder="搜索型号..." class="w-64 px-3 py-2 text-sm outline-none">
<button class="px-4 py-2 text-sm text-white bg-orange-500 hover:bg-orange-600">搜索</button>
</div>
</div>
</section>
<!-- 第二屏：数据看板 -->
<section class="py-8 border-t border-gray-100">
<div class="flex justify-center items-center gap-8 text-center">
<div>
<div class="text-3xl font-bold text-blue-900">27</div>
<div class="text-xs text-gray-400 mt-1">芯片数</div>
</div>
<div class="text-gray-200">|</div>
<div>
<div class="text-3xl font-bold text-blue-900">13</div>
<div class="text-xs text-gray-400 mt-1">政策</div>
</div>
<div class="text-gray-200">|</div>
<div>
<div class="text-3xl font-bold text-blue-900">15</div>
<div class="text-xs text-gray-400 mt-1">受限项</div>
</div>
<div class="text-gray-200">|</div>
<div>
<div class="text-3xl font-bold text-blue-900">13</div>
<div class="text-xs text-gray-400 mt-1">制裁企业</div>
</div>
</div>
</section>
<!-- 第三屏：热门替代芯片 -->
<section class="py-8 border-t border-gray-100">
<h2 class="text-sm font-medium text-gray-900 mb-6">热门替代芯片</h2>
<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
<div class="border border-gray-200 rounded p-4 hover:border-gray-300 cursor-pointer">
<div class="flex justify-between items-start mb-2">
<div>
<div class="font-semibold text-gray-900">APM32F103C8T6</div>
<div class="text-xs text-gray-400 mt-0.5">极海半导体</div>
</div>
<div class="text-right">
<span class="text-xs px-1.5 py-0.5 border border-green-200 text-green-600 rounded">P2P</span>
</div>
</div>
<div class="text-orange-500 font-semibold">¥2.35</div>
<div class="text-xs text-gray-400 mt-2">替代 STM32F103C8T6</div>
</div>
<div class="border border-gray-200 rounded p-4 hover:border-gray-300 cursor-pointer">
<div class="flex justify-between items-start mb-2">
<div>
<div class="font-semibold text-gray-900">AT32F407VET6</div>
<div class="text-xs text-gray-400 mt-0.5">雅特力</div>
</div>
<div class="text-right">
<span class="text-xs px-1.5 py-0.5 border border-green-200 text-green-600 rounded">P2P</span>
</div>
</div>
<div class="text-orange-500 font-semibold">¥5.80</div>
<div class="text-xs text-gray-400 mt-2">替代 STM32F407VET6</div>
</div>
<div class="border border-gray-200 rounded p-4 hover:border-gray-300 cursor-pointer">
<div class="flex justify-between items-start mb-2">
<div>
<div class="font-semibold text-gray-900">昇腾910B</div>
<div class="text-xs text-gray-400 mt-0.5">华为海思</div>
</div>
<div class="text-right">
<span class="text-xs px-1.5 py-0.5 border border-blue-200 text-blue-600 rounded">功能</span>
</div>
</div>
<div class="text-orange-500 font-semibold">¥85,000</div>
<div class="text-xs text-gray-400 mt-2">替代 NVIDIA A100</div>
</div>
</div>
</section>
<!-- 第四屏：最新管制动态 -->
<section class="py-8 border-t border-gray-100">
<h2 class="text-sm font-medium text-gray-900 mb-6">最新管制动态</h2>
<div class="space-y-3">
<div class="flex items-center gap-4 py-2 hover:bg-gray-50 cursor-pointer">
<span class="text-xs text-gray-400 w-10">05-07</span>
<span class="flex-1 text-sm text-gray-700">DeepSeek V4全栈适配昇腾</span>
<span class="text-xs px-1.5 py-0.5 bg-red-50 text-red-600 rounded">高</span>
</div>
<div class="flex items-center gap-4 py-2 hover:bg-gray-50 cursor-pointer">
<span class="text-xs text-gray-400 w-10">04-30</span>
<span class="flex-1 text-sm text-gray-700">FCC拟取消互认协议国检测资质</span>
<span class="text-xs px-1.5 py-0.5 bg-yellow-50 text-yellow-600 rounded">中</span>
</div>
<div class="flex items-center gap-4 py-2 hover:bg-gray-50 cursor-pointer">
<span class="text-xs text-gray-400 w-10">04-22</span>
<span class="flex-1 text-sm text-gray-700">MATCH法案外委会全票通过</span>
<span class="text-xs px-1.5 py-0.5 bg-red-50 text-red-600 rounded">高</span>
</div>
</div>
</section>
</div>
<!-- 底部 -->
<footer class="py-8 text-center text-xs text-gray-300 border-t border-gray-100">
<p>AI芯片替代指南 · 数据来源公开可查，仅供参考</p>
</footer>
</Layout>