import Layout from '../layouts/Layout.astro';
---
<Layout title="AI算力引擎 | 本地私有化部署基建站">
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

  <main x-data="{ openModal: false }" class="min-h-screen bg-slate-900 text-gray-100 flex flex-col items-center justify-center p-8 relative">
    
    <div class="max-w-5xl text-center z-10">
      <h1 class="text-5xl font-bold text-white mb-6 tracking-tight">极简本地 AI 私有化部署基建站</h1>
      <p class="text-xl text-gray-400 mb-12">彻底摆脱公有云限制。为您提供从底层硬件选型、BIOS 破解，到大模型一键运行的完整企业级解决方案。</p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12 text-left">
        <div class="bg-slate-800 p-8 rounded-xl border border-slate-700 shadow-lg">
          <h2 class="text-2xl font-semibold text-blue-400 mb-4">💻 极客硬件配置库</h2>
          <ul class="space-y-3 text-gray-300">
            <li>• 低成本高显存方案 (Tesla P100 16GB 避坑指南)</li>
            <li>• 洋垃圾双路主板改造 (X99-T8D 开启 ReBarUEFI)</li>
            <li>• Above 4G Decoding 与显存映射调优</li>
          </ul>
        </div>
        <div class="bg-slate-800 p-8 rounded-xl border border-slate-700 shadow-lg">
          <h2 class="text-2xl font-semibold text-green-400 mb-4">🚀 一键部署资源包</h2>
          <ul class="space-y-3 text-gray-300">
            <li>• Qwen 35B (IQ3_S 3-bit量化) 极速推理配置</li>
            <li>• ollama_models 自定义路径避坑和环境变量设置</li>
            <li>• 解决 CUDA Error: OOM 的终极排错手册</li>
          </ul>
        </div>
      </div>

      <button @click="openModal = true" class="bg-blue-600 hover:bg-blue-500 text-white text-xl font-bold rounded-xl px-10 py-5 shadow-blue-500/20 shadow-lg transition-all">
        立即获取 VIP 极客私有化部署包 (.bat)
      </button>
    </div>

    <div x-show="openModal" style="display: none;" class="fixed inset-0 z-50 flex items-center justify-center">
      <div @click="openModal = false" class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
      
      <div class="bg-slate-800 border border-slate-700 p-8 rounded-2xl shadow-2xl z-10 w-full max-w-md text-center transform transition-all">
        <h3 class="text-2xl font-bold text-white mb-2">获取核心部署包</h3>
        <p class="text-gray-400 mb-6">包含 X99 BIOS 破解固件与 Ollama 一键启动脚本。</p>
        
        <div class="bg-slate-700 w-48 h-48 mx-auto rounded-lg mb-6 flex items-center justify-center border-2 border-dashed border-slate-500">
          <span class="text-slate-400">请替换为您的微信二维码</span>
        </div>
        
        <p class="text-sm text-green-400 mb-6">扫码添加主理人，备注"极客部署"获取。</p>
        
        <button @click="openModal = false" class="text-gray-400 hover:text-white transition-colors">
          暂不需要，关闭窗口
        </button>
      </div>
    </div>

  </main>
</Layout>
