---
/**
 * 芯片替代平台 - ChipAlters
 * 首页 - 中英文双语版本
 */
import Layout from '../layouts/Layout.astro';

const locale = Astro.url.searchParams.get('locale') || 'zh';
const t = {
  zh: {
    title: '芯片替代平台 | 快速查找国产替代芯片',
    subtitle: '输入美国芯片型号，找到可靠的国产替代方案',
    placeholder: '例如: STM32F103, LM358, ESP8266...',
    search: '搜索替代方案',
    popular: '热门搜索',
    categories: '芯片分类',
    features: '为什么选择我们',
    stats: {
      chips: '芯片型号',
      alternatives: '替代方案',
      manufacturers: '国产厂商'
    },
    featureTitles: ['精准匹配', '详细对比', '供货保障'],
    featureDescs: [
      '输入芯片型号，自动匹配最相似的国产替代方案',
      '提供详细参数对比，助您做出最优选择',
      '精选供货稳定的国产芯片厂商'
    ]
  },
  en: {
    title: 'ChipAlters | Find Chinese Chip Alternatives',
    subtitle: 'Enter US chip model number to find reliable Chinese alternatives',
    placeholder: 'e.g: STM32F103, LM358, ESP8266...',
    search: 'Search Alternatives',
    popular: 'Popular Searches',
    categories: 'Categories',
    features: 'Why Choose Us',
    stats: {
      chips: 'Chip Models',
      alternatives: 'Alternatives',
      manufacturers: 'Manufacturers'
    },
    featureTitles: ['Precision Match', 'Detailed Comparison', 'Supply Guarantee'],
    featureDescs: [
      'Enter chip model for auto-matched Chinese alternatives',
      'Detailed specs comparison for optimal decisions',
      'Curated Chinese manufacturers with stable supply'
    ]
  }
};

const text = t[locale];
const popularChips = ['STM32F103', 'LM358', 'ESP8266', 'LM7805', 'W25Q128', 'AT24C256'];
const categories = [
  { key: 'op-amp', labelZh: '运算放大器', labelEn: 'Operational Amplifiers', icon: '📊' },
  { key: 'mcu', labelZh: '微控制器', labelEn: 'Microcontrollers', icon: '💻' },
  { key: 'power', labelZh: '电源管理', labelEn: 'Power Management', icon: '⚡' },
  { key: 'wireless', labelZh: '无线通信', labelEn: 'Wireless', icon: '📡' },
  { key: 'memory', labelZh: '存储器', labelEn: 'Memory', icon: '💾' },
  { key: 'can', labelZh: 'CAN收发器', labelEn: 'CAN Transceivers', icon: '🔌' }
];
---

<Layout title={text.title}>
  <main class="home">
    <!-- Hero Section -->
    <section class="hero">
      <div class="container">
        <h1 class="title">{locale === 'zh' ? '芯片替代平台' : 'ChipAlters'}</h1>
        <p class="subtitle">{text.subtitle}</p>
        
        <!-- Search Box -->
        <div class="search-box">
          <div class="search-wrapper">
            <span class="search-icon">🔍</span>
            <input 
              type="text" 
              id="chip-search" 
              class="search-input" 
              placeholder={text.placeholder}
              autofocus
            />
            <button class="search-btn" id="search-btn">{text.search}</button>
          </div>
        </div>

        <!-- Language Toggle -->
        <div class="lang-toggle">
          <a href="?locale=zh" class={locale === 'zh' ? 'active' : ''}>中文</a>
          <span>|</span>
          <a href="?locale=en" class={locale === 'en' ? 'active' : ''}>English</a>
        </div>

        <!-- Popular Searches -->
        <div class="popular">
          <span class="popular-label">{text.popular}:</span>
          {popularChips.map(chip => (
            <a href={`/search?q=${chip}&locale=${locale}`} class="popular-chip">{chip}</a>
          ))}
        </div>
      </div>
    </section>

    <!-- Stats Section -->
    <section class="stats">
      <div class="container">
        <div class="stat-item">
          <span class="stat-number">500+</span>
          <span class="stat-label">{text.stats.chips}</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">1500+</span>
          <span class="stat-label">{text.stats.alternatives}</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">50+</span>
          <span class="stat-label">{text.stats.manufacturers}</span>
        </div>
      </div>
    </section>

    <!-- Categories -->
    <section class="categories">
      <div class="container">
        <h2 class="section-title">{text.categories}</h2>
        <div class="category-grid">
          {categories.map(cat => (
            <a href={`/category/${cat.key}?locale=${locale}`} class="category-card">
              <span class="cat-icon">{cat.icon}</span>
              <span class="cat-name">{locale === 'zh' ? cat.labelZh : cat.labelEn}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Features -->
    <section class="features">
      <div class="container">
        <h2 class="section-title">{text.features}</h2>
        <div class="feature-grid">
          {text.featureTitles.map((title, i) => (
            <div class="feature-card">
              <div class="feature-icon">{['🎯', '📋', '🛡️'][i]}</div>
              <h3>{title}</h3>
              <p>{text.featureDescs[i]}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  const searchInput = document.getElementById('chip-search') as HTMLInputElement;
  const searchBtn = document.getElementById('search-btn');
  
  function doSearch() {
    const query = searchInput.value.trim();
    if (query) {
      const locale = new URLSearchParams(window.location.search).get('locale') || 'zh';
      window.location.href = `/search?q=${encodeURIComponent(query)}&locale=${locale}`;
    }
  }
  
  searchBtn?.addEventListener('click', doSearch);
  searchInput?.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') doSearch();
  });
</script>

<style>
  .home {
    min-height: 100vh;
  }
  
  .hero {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 80px 20px;
    text-align: center;
  }
  
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
  
  .title {
    font-size: 3rem;
    margin-bottom: 20px;
    font-weight: 700;
  }
  
  .subtitle {
    font-size: 1.25rem;
    margin-bottom: 40px;
    opacity: 0.9;
  }
  
  .search-box {
    max-width: 700px;
    margin: 0 auto 30px;
  }
  
  .search-wrapper {
    display: flex;
    background: white;
    border-radius: 50px;
    padding: 8px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.2);
  }
  
  .search-icon {
    padding: 15px 20px;
    font-size: 1.25rem;
  }
  
  .search-input {
    flex: 1;
    border: none;
    outline: none;
    font-size: 1.1rem;
    padding: 15px 10px;
    color: #333;
  }
  
  .search-btn {
    background: #667eea;
    color: white;
    border: none;
    padding: 15px 35px;
    border-radius: 40px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.3s;
  }
  
  .search-btn:hover {
    background: #5a6fd6;
  }
  
  .lang-toggle {
    margin-bottom: 30px;
  }
  
  .lang-toggle a {
    color: white;
    text-decoration: none;
    padding: 5px 15px;
    opacity: 0.8;
    transition: opacity 0.3s;
  }
  
  .lang-toggle a:hover,
  .lang-toggle a.active {
    opacity: 1;
    font-weight: 600;
  }
  
  .popular {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
  }
  
  .popular-label {
    font-weight: 500;
  }
  
  .popular-chip {
    background: rgba(255,255,255,0.2);
    color: white;
    padding: 8px 18px;
    border-radius: 20px;
    text-decoration: none;
    font-size: 0.95rem;
    transition: background 0.3s;
  }
  
  .popular-chip:hover {
    background: rgba(255,255,255,0.3);
  }
  
  .stats {
    background: white;
    padding: 50px 20px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
  }
  
  .stats .container {
    display: flex;
    justify-content: center;
    gap: 80px;
  }
  
  .stat-item {
    text-align: center;
  }
  
  .stat-number {
    display: block;
    font-size: 2.5rem;
    font-weight: 700;
    color: #667eea;
  }
  
  .stat-label {
    color: #666;
    font-size: 1rem;
  }
  
  .categories,
  .features {
    padding: 60px 20px;
  }
  
  .section-title {
    text-align: center;
    font-size: 2rem;
    margin-bottom: 40px;
    color: #333;
  }
  
  .category-grid,
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 25px;
    max-width: 1000px;
    margin: 0 auto;
  }
  
  .category-card,
  .feature-card {
    background: white;
    border-radius: 16px;
    padding: 30px;
    text-align: center;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    transition: transform 0.3s, box-shadow 0.3s;
    text-decoration: none;
    color: inherit;
  }
  
  .category-card:hover,
  .feature-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 30px rgba(0,0,0,0.12);
  }
  
  .cat-icon {
    font-size: 2.5rem;
    display: block;
    margin-bottom: 15px;
  }
  
  .cat-name {
    font-size: 1.1rem;
    font-weight: 600;
    color: #333;
  }
  
  .feature-icon {
    font-size: 2.5rem;
    margin-bottom: 15px;
  }
  
  .feature-card h3 {
    margin-bottom: 10px;
    color: #333;
  }
  
  .feature-card p {
    color: #666;
    line-height: 1.6;
  }
  
  .features {
    background: #f8f9fa;
  }
  
  @media (max-width: 768px) {
    .title {
      font-size: 2rem;
    }
    
    .stats .container {
      flex-direction: column;
      gap: 30px;
    }
    
    .search-wrapper {
      flex-direction: column;
      border-radius: 20px;
    }
    
    .search-btn {
      width: 100%;
    }
  }
</style>
