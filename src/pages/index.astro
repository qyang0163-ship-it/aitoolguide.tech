---
import Layout from '../layouts/Layout.astro';
const enterprises = (await import('../data/enterprises.json')).default;
const chips = (await import('../data/chips.json')).default;
const policies = (await import('../data/policies.json')).default;
const stats = [
{ label: '覆盖芯片', value: chips.length },
{ label: '政策条目', value: policies.length },
{ label: '受限追踪', value: 9 },
{ label: '受制裁企业', value: enterprises.length }
];
const keywords = ['STM32替代', '电源芯片', 'RISC-V', 'AI芯片', '车规级', '光刻胶'];
---
<Layout title="国产芯片替代指南 | 追踪管制·验证替代" description="追踪芯片管制政策，验证国产替代进展。每一条信息都有官方出处：BIS联邦公报、企业公告、海关总署。">
<!-- Hero区域 -->
<section class="bg-gradient-to-br from-[#0F4C81] via-[#1a5a9e] to-[#0d3d6e] text-white py-16 px-4">
<div class="max-w-4xl mx-auto text-center">
<h1 class="text-4xl md:text-5xl font-bold mb-4">追踪芯片管制，验证国产替代</h1>
<p class="text-xl md:text-2xl text-blue-100 mb-8">每一条信息都有官方出处</p>
<!-- 搜索框 -->
<div class="max-w-2xl mx-auto mb-6">
<div class="relative">
<svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
<input type="text" id="searchInput" placeholder="输入型号或ECCN编码，如 STM32F103C8T6 / 3A001" class="w-full pl-12 pr-4 py-4 rounded-full bg-white text-slate-800 placeholder-slate-400 border-0 focus:outline-none focus:ring-4 focus:ring-blue-300/50">
</div>
</div>
<!-- 关键词标签 -->
<div class="flex flex-wrap justify-center gap-2 mb-6">
{keywords.map(k => (
<button class="px-4 py-1.5 bg-white/10 hover:bg-white/20 rounded-full text-sm transition-colors">{k}</button>
))}
</div>
<!-- 信任标识 -->
<div class="flex items-center justify-center gap-2 text-blue-100 text-sm">
<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
<span>数据来源：BIS联邦公报 · 企业官方公告 · 中国海关总署</span>
</div>
</div>
</section>
<div class="max-w-7xl mx-auto px-4 py-8">
<!-- 数据看板 -->
<section class="py-8 mb-8">
<div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
{stats.map(s => (
<div>
<div class="text-4xl md:text-5xl font-bold text-[#0F4C81] mb-1">{s.value}</div>
<div class="text-sm text-slate-500">{s.label}</div>
</div>
))}
</div>
</section>
<!-- 热门芯片矩阵 -->
<section class="mb-12">
<div class="flex justify-between items-center mb-6">
<h2 class="text-2xl font-bold text-slate-800">热门国产替代方案</h2>
<a href="/chips" class="text-[#0F4C81] hover:underline text-sm">查看全部 {chips.length} 款 →</a>
</div>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
{chips.slice(0,8).map(chip => (
<a href={`/chip/${chip.id}`} class="bg-white rounded-xl p-5 hover:shadow-lg transition-shadow border border-slate-100">
<div class="flex justify-between items-start mb-3">
<div class="w-10 h-10 rounded-lg bg-gradient-to-br from-[#0F4C81] to-[#2B6CB0] flex items-center justify-center text-white font-bold text-sm">
{chip.manufacturer.slice(0,2)}
</div>
<span class={`text-xs px-2 py-1 rounded-full ${chip.substituteLevel==='pin2pin'?'bg-green-100 text-green-700':'bg-blue-100 text-blue-700'}`}>
{chip.substituteLevel==='pin2pin'?'P2P':'功能替代'}
</span>
</div>
<h3 class="font-bold text-lg text-slate-800 mb-1">{chip.name}</h3>
<p class="text-sm text-slate-500 mb-2">{chip.manufacturer}</p>
<p class="text-xs text-slate-400 mb-3">替代 {chip.originalEquivalent}</p>
<div class="flex justify-between items-center">
<span class="text-[#E48736] font-bold text-lg">{chip.price}</span>
<span class="text-xs text-slate-400">{Object.entries(chip.specs || {}).slice(0,2).map(([k,v]) => `${k}:${v}`).join(' · ')}</span>
</div>
</a>
))}
</div>
</section>
<!-- 最新管制动态 -->
<section class="mb-12">
<div class="flex justify-between items-center mb-6">
<h2 class="text-2xl font-bold text-slate-800">最新管制动态</h2>
<a href="/policy" class="text-[#0F4C81] hover:underline text-sm">查看全部 →</a>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
{policies.slice(0,4).map(p => (
<a href="/policy" class="flex items-center gap-4 bg-white rounded-xl p-4 hover:shadow-lg transition-shadow border border-slate-100">
<div class="text-sm text-slate-400 whitespace-nowrap">{p.date}</div>
<div class="flex-1">
<h3 class="font-semibold text-slate-800">{p.title}</h3>
</div>
<span class={`text-xs px-2 py-1 rounded-full whitespace-nowrap ${p.impactLevel==='high'?'bg-red-100 text-red-700':p.impactLevel==='medium'?'bg-yellow-100 text-yellow-700':'bg-green-100 text-green-700'}`}>
{p.impactLevel==='high'?'高影响':p.impactLevel==='medium'?'中影响':'低影响'}
</span>
</a>
))}
</div>
</section>
<!-- 产业链导航 -->
<section class="mb-12">
<h2 class="text-2xl font-bold text-slate-800 mb-6">产业链全景</h2>
<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
<a href="/equipment" class="bg-white rounded-xl p-6 text-center hover:shadow-lg transition-shadow border border-slate-100">
<div class="text-3xl mb-2">🔧</div>
<h3 class="font-bold text-slate-800">设备</h3>
<p class="text-sm text-slate-500">12大类</p>
</a>
<a href="/materials" class="bg-white rounded-xl p-6 text-center hover:shadow-lg transition-shadow border border-slate-100">
<div class="text-3xl mb-2">💎</div>
<h3 class="font-bold text-slate-800">材料</h3>
<p class="text-sm text-slate-500">10大类</p>
</a>
<a href="/eda-ip" class="bg-white rounded-xl p-6 text-center hover:shadow-lg transition-shadow border border-slate-100">
<div class="text-3xl mb-2">💻</div>
<h3 class="font-bold text-slate-800">EDA/IP</h3>
<p class="text-sm text-slate-500">8大类</p>
</a>
<a href="/chips" class="bg-white rounded-xl p-6 text-center hover:shadow-lg transition-shadow border border-slate-100">
<div class="text-3xl mb-2">🧩</div>
<h3 class="font-bold text-slate-800">芯片</h3>
<p class="text-sm text-slate-500">{chips.length}款</p>
</a>
</div>
</section>
</div>
</Layout>