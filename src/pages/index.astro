---
import Layout from '../layouts/Layout.astro';
import chips from '../data/chips.json';

const featuredChips = chips.slice(0, 8);

const categories = [
  { id: 'mcu', name: 'MCU', count: 2456, icon: '⚡' },
  { id: 'adc', name: 'ADC', count: 892, icon: '📊' },
  { id: 'analog', name: '模拟芯片', count: 1567, icon: '🔧' },
  { id: 'power', name: '电源管理', count: 1234, icon: '🔋' },
  { id: 'interface', name: '接口芯片', count: 789, icon: '🔌' },
  { id: 'sensor', name: '传感器', count: 1023, icon: '🌡️' },
];

const stats = {
  totalChips: 15847,
  domesticChips: 10617,
  alternativeCount: 12456,
  docsCount: 2800,
  totalOriginal: 15847,
  totalAlternatives: 12456,
  p2pCompatible: 3847,
  vipManuals: 2800
};

const categoryIcons: Record<string, string> = {
  mcu: '⚡',
  adc: '📊',
  analog: '🔧',
  power: '🔋',
  interface: '🔌',
  sensor: '🌡️',
  memory: '💾',
  logic: '🔲',
  rf: '📡'
};
---

<Layout title="ChipAltDB — 国产芯片替代数据库" description="专业芯片国产替代方案查询平台，覆盖 MCU、ADC、电源管理、接口芯片等全品类。P2P兼容性评估、替代难度分析、技术手册下载。">

  <main class="bg-slate-50 min-h-screen">
    <!-- Top Navigation Bar -->
    <nav class="sticky top-0 z-50 bg-white border-b border-slate-200 shadow-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-14">
          <a href="/" class="flex items-center gap-2.5">
            <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/>
              </svg>
            </div>
            <div>
              <h1 class="text-base font-semibold text-slate-800 leading-tight">ChipAltDB</h1>
              <p class="text-[10px] text-slate-500 leading-tight">国产芯片替代数据库</p>
            </div>
          </a>

          <div class="flex-1 max-w-lg mx-8">
            <div class="relative">
              <input type="text" placeholder="搜索型号，如 STM32F103C8T6" class="w-full bg-slate-50 border border-slate-200 rounded-lg pl-9 pr-4 py-2 text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/10" />
              <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <a href="/compare" class="text-sm text-slate-600 hover:text-blue-600 font-medium transition-colors">对比</a>
            <a href="/contact" class="bg-blue-600 hover:bg-blue-500 text-white text-sm px-4 py-2 rounded-lg font-medium transition-colors shadow-sm">联系原厂</a>
          </div>
        </div>
      </div>
    </nav>

    <!-- Hero Section -->
    <section class="bg-white border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <div class="text-center max-w-3xl mx-auto mb-10">
          <span class="inline-block text-xs font-medium text-blue-600 bg-blue-50 border border-blue-100 px-3 py-1 rounded-full mb-4">国产芯片替代方案 · P2P兼容评估</span>
          <h1 class="text-3xl font-bold text-slate-900 mb-3 leading-tight">让每一款<span class="text-blue-600">美国受限芯片</span><br />都有清晰的<span class="text-blue-600">国产替代路径</span></h1>
          <p class="text-slate-600 text-lg leading-relaxed">覆盖 MCU、ADC/DAC、电源管理、接口芯片等多个品类，提供原厂规格对比、P2P 兼容性评估与替代难度分级。</p>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-3xl mx-auto">
          <div class="bg-slate-50 rounded-xl border border-slate-200 p-5 text-center">
            <div class="text-2xl font-bold text-slate-900">{stats.totalOriginal.toLocaleString()}</div>
            <div class="text-sm text-slate-500 mt-1">原厂型号收录</div>
          </div>
          <div class="bg-slate-50 rounded-xl border border-slate-200 p-5 text-center">
            <div class="text-2xl font-bold text-emerald-600">{stats.totalAlternatives.toLocaleString()}</div>
            <div class="text-sm text-slate-500 mt-1">替代方案</div>
          </div>
          <div class="bg-slate-50 rounded-xl border border-slate-200 p-5 text-center">
            <div class="text-2xl font-bold text-blue-600">{stats.p2pCompatible.toLocaleString()}</div>
            <div class="text-sm text-slate-500 mt-1">P2P 兼容</div>
          </div>
          <div class="bg-slate-50 rounded-xl border border-slate-200 p-5 text-center">
            <div class="text-2xl font-bold text-amber-600">{stats.vipManuals}</div>
            <div class="text-sm text-slate-500 mt-1">VIP 技术手册</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Category Navigation -->
    <section class="bg-white border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <h2 class="text-lg font-semibold text-slate-800 mb-5">按品类浏览</h2>
        <div class="grid grid-cols-3 sm:grid-cols-5 md:grid-cols-9 gap-3">
          {categories.map(cat => (
            <a href={`/category/${cat.id}`} class="group flex flex-col items-center gap-2 p-4 bg-slate-50 rounded-xl border border-slate-200 hover:border-blue-300 hover:bg-blue-50 transition-all">
              <span class="text-2xl group-hover:scale-110 transition-transform">{categoryIcons[cat.id] || '🔹'}</span>
              <span class="text-sm font-medium text-slate-700 group-hover:text-blue-700 transition-colors">{cat.name}</span>
              <span class="text-xs text-slate-400">{cat.count} 款</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Featured Chips -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-bold text-slate-800">热门替代方案</h2>
        <a href="/chip" class="text-sm text-blue-600 hover:text-blue-700 font-medium transition-colors">查看全部 →</a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
        {featuredChips.map(chip => (
          <a href={`/chip/${chip.id}`} class="group bg-white rounded-xl border border-slate-200 p-5 hover:border-blue-300 hover:shadow-md transition-all">
            <div class="flex items-start justify-between mb-3">
              <span class="text-xs text-slate-500 uppercase tracking-wide">{chip.manufacturer}</span>
              <span class="btn-info-xs bg-blue-50 text-blue-700 border border-blue-200 px-2 py-0.5 rounded text-xs font-medium"><a>查看</a></span>
            </div>
            <h3 class="text-base font-bold text-slate-900 mb-1 group-hover:text-blue-600 transition-colors">{chip.id}</h3>
            <p class="text-sm text-slate-500 mb-4 line-clamp-2">{chip.description}</p>
            <div class="flex flex-wrap gap-1.5">
              {Object.entries(chip.specs).slice(0, 3).map(([k, v]) => (
                <span class="text-xs text-slate-600 bg-slate-50 border border-slate-100 px-2 py-1 rounded">
                  <span class="text-slate-400">{k}:</span> {v}
                </span>
              ))}
            </div>
            {chip.alternatives.length > 0 && (
              <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-sm">
                <span class="text-emerald-700 font-medium">{chip.alternatives.filter(a => a.p2pCompatible).length} 个 P2P 兼容替代</span>
                <span class="text-slate-400">{chip.alternatives.length} 个方案</span>
              </div>
            )}
          </a>
        ))}
      </div>
    </section>

    <!-- VIP CTA Section -->
    <section class="bg-slate-800 border-y border-slate-700">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <div class="bg-gradient-to-br from-slate-700 to-slate-800 rounded-2xl border border-slate-600 p-8 md:p-10 text-center">
          <span class="inline-block text-xs font-semibold text-amber-400 bg-amber-500/10 border border-amber-500/20 px-3 py-1 rounded-full mb-4">VIP 会员专属</span>
          <h2 class="text-2xl font-bold text-white mb-3">获取原厂级替代评估报告</h2>
          <p class="text-slate-400 text-base max-w-xl mx-auto mb-6">50+ 页深度技术报告，包含引脚差异分析、底层寄存器兼容性映射、BOM 成本对比。一对一技术支持，助力国产化替代项目。</p>
          <div class="flex items-center justify-center gap-3 flex-wrap">
            <button class="bg-blue-600 hover:bg-blue-500 text-white px-6 py-2.5 rounded-lg font-medium transition-colors shadow-lg shadow-blue-600/20 flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
              申请 VIP 订阅
            </button>
            <a href="/vip-methods" class="bg-slate-600 hover:bg-slate-500 text-white px-6 py-2.5 rounded-lg font-medium transition-colors">了解权益</a>
          </div>
        </div>
      </div>
    </section>

    <!-- OEM Partnership CTA -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <div class="bg-gradient-to-r from-blue-50 to-indigo-50 rounded-2xl border border-blue-200 p-8">
        <div class="flex flex-col md:flex-row items-center justify-between gap-6">
          <div>
            <h3 class="text-xl font-bold text-slate-800 mb-2">国产原厂直供通道</h3>
            <p class="text-slate-600 leading-relaxed">兆易创新、极海半导体、沁恒微等原厂认证代理，批量采购专属折扣，提供完整的国产替代技术支持。</p>
          </div>
          <a href="/contact" class="flex-shrink-0 bg-amber-500 hover:bg-amber-600 text-white px-6 py-3 rounded-lg font-medium transition-colors shadow-sm">
            联系原厂销售
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="bg-white border-t border-slate-200 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/>
            </svg>
          </div>
          <div>
            <p class="text-sm font-semibold text-slate-800">ChipAltDB</p>
            <p class="text-xs text-slate-500">国产芯片替代数据库平台</p>
          </div>
        </div>
        <div class="flex items-center gap-6 text-sm">
          <a href="/chip" class="text-slate-500 hover:text-slate-800 transition-colors">芯片数据库</a>
          <a href="/categories" class="text-slate-500 hover:text-slate-800 transition-colors">品类</a>
          <a href="/compare" class="text-slate-500 hover:text-slate-800 transition-colors">对比</a>
          <a href="/contact" class="text-slate-500 hover:text-slate-800 transition-colors">联系我们</a>
          <a href="https://github.com/qyang0163-ship-it/aitoolguide.tech" target="_blank" class="text-slate-500 hover:text-slate-800 transition-colors">GitHub</a>
        </div>
        <p class="text-xs text-slate-400">© 2026 ChipAltDB. 专注国产芯片替代方案。</p>
      </div>
    </div>
  </footer>
</Layout>
