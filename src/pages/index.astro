---
import Layout from '../layouts/Layout.astro';
const enterprises = (await import('../data/enterprises.json')).default;
const chips = (await import('../data/chips.json')).default;
const policies = (await import('../data/policies.json')).default;
---
<Layout title="国产芯片替代指南 | 追踪管制·验证替代" description="追踪芯片管制政策，验证国产替代进展。每一条信息都有官方出处：BIS联邦公报、企业公告、海关总署。">
<div class="max-w-7xl mx-auto px-4 py-8">
<!-- Hero -->
<section class="text-center py-12 mb-8">
<h1 class="text-4xl md:text-5xl font-bold text-slate-900 mb-4 leading-tight">追踪芯片管制，验证国产替代</h1>
<h2 class="text-2xl md:text-3xl font-bold text-[#0F4C81] mb-6">每一条信息都有官方出处</h2>
<p class="text-sm text-slate-500 mb-8">数据来源：美国BIS联邦公报 | 企业官方数据手册 | 中国海关总署公告 | WSTS/SIA行业统计</p>
<div class="max-w-2xl mx-auto">
<input type="text" id="searchInput" placeholder="输入型号或ECCN编码，如 STM32F103C8T6 / 3A001" class="search-input w-full">
</div>
</section>
<!-- 数据看板 -->
<section class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
<div class="card border-l-4 border-red-500">
<div class="flex items-center gap-2 mb-3">
<svg class="w-6 h-6 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
<h2 class="text-xl font-bold text-slate-800">管制利剑</h2>
</div>
<p class="text-4xl font-bold text-[#0F4C81] mb-2">{enterprises.length}<span class="text-lg text-slate-500 ml-1">家</span></p>
<p class="text-slate-600 mb-3">实体清单企业</p>
<div class="pt-3 border-t border-slate-100">
<p class="text-xs text-slate-500">MATCH法案参议院审议中 · 日本ArF光刻胶零进口</p>
</div>
</div>
<div class="card border-l-4 border-green-500">
<div class="flex items-center gap-2 mb-3">
<svg class="w-6 h-6 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
<h2 class="text-xl font-bold text-slate-800">替代时钟</h2>
</div>
<p class="text-4xl font-bold text-[#0F4C81] mb-2">{chips.length}<span class="text-lg text-slate-500 ml-1">款</span></p>
<p class="text-slate-600 mb-3">国产替代芯片</p>
<div class="pt-3 border-t border-slate-100">
<p class="text-xs text-slate-500">昇腾910B持续放量 · 鼎龙光刻胶已投产</p>
</div>
</div>
<div class="card border-l-4 border-blue-500">
<div class="flex items-center gap-2 mb-3">
<svg class="w-6 h-6 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
<h2 class="text-xl font-bold text-slate-800">贸易动态</h2>
</div>
<p class="text-4xl font-bold text-green-600 mb-2">↑3.8%</p>
<p class="text-slate-600 mb-3">2026年4月芯片出口</p>
<div class="pt-3 border-t border-slate-100">
<p class="text-xs text-slate-500">海关总署月度数据</p>
</div>
</div>
</section>
<!-- 最新管制政策 -->
<section class="mb-12">
<div class="flex justify-between items-center mb-6">
<h2 class="text-2xl font-bold text-slate-800">最新管制政策</h2>
<a href="/policy" class="text-[#0F4C81] hover:underline text-sm">查看全部 →</a>
</div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
{policies.slice(0,3).map(p => (
<a href="/policy" class="card block hover:shadow-lg transition-shadow">
<div class="flex justify-between items-start mb-3">
<span class="text-xs text-slate-400">{p.date}</span>
<span class={`badge ${p.impactLevel==='high'?'bg-red-100 text-red-700':p.impactLevel==='medium'?'bg-orange-100 text-orange-700':'bg-green-100 text-green-700'}`}>
{p.impactLevel==='high'?'高影响':p.impactLevel==='medium'?'中影响':'低影响'}
</span>
</div>
<h3 class="font-bold text-slate-800 mb-2">{p.title}</h3>
<p class="text-sm text-slate-600 line-clamp-2">{p.summary}</p>
</a>
))}
</div>
</section>
<!-- 热门替代芯片 -->
<section class="mb-12">
<div class="flex justify-between items-center mb-6">
<h2 class="text-2xl font-bold text-slate-800">热门国产替代方案</h2>
<a href="/chips" class="text-[#0F4C81] hover:underline text-sm">查看全部 {chips.length} 款 →</a>
</div>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
{chips.slice(0,6).map(chip => (
<a href={`/chip/${chip.id}`} class="card block hover:shadow-lg transition-shadow">
<div class="flex justify-between items-start mb-2">
<h3 class="font-bold text-lg text-slate-800">{chip.name}</h3>
<span class="badge badge-green">{chip.substituteLevel==='pin2pin'?'P2P':'功能'}</span>
</div>
<p class="text-sm text-slate-500 mb-3">替代 {chip.originalEquivalent}</p>
<div class="flex justify-between items-center">
<span class="text-[#E48736] font-bold">{chip.price}</span>
<span class="text-xs text-slate-400">{chip.manufacturer}</span>
</div>
</a>
))}
</div>
</section>
<!-- 权威信任区域 -->
<section class="bg-slate-50 rounded-xl p-8 mb-12">
<div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
<div>
<div class="text-3xl mb-3">📋</div>
<h3 class="font-bold text-slate-800 mb-2">可信来源</h3>
<p class="text-sm text-slate-600">每一条数据都链接到BIS官方文件或企业公告</p>
</div>
<div>
<div class="text-3xl mb-3">⚡</div>
<h3 class="font-bold text-slate-800 mb-2">动态追踪</h3>
<p class="text-sm text-slate-600">政策变化24小时内更新</p>
</div>
<div>
<div class="text-3xl mb-3">🎯</div>
<h3 class="font-bold text-slate-800 mb-2">决策支撑</h3>
<p class="text-sm text-slate-600">提供替代成熟度评估，真实差距说明</p>
</div>
</div>
</section>
</div>
</Layout>