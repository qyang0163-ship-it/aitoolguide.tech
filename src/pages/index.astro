---
import Layout from '../layouts/Layout.astro';
const chips = (await import('../data/chips.json')).default;
const policies = (await import('../data/policies.json')).default;
const restricted = (await import('../data/restricted.json')).default;
const latestPolicies = policies.sort((a,b) => new Date(b.date) - new Date(a.date)).slice(0,3);
---
<Layout title="国产芯片替代指南 | P2P兼容参数对比" description="收录国产替代芯片，引脚兼容、性能对比，快速找到平替方案。">
<section class="text-center py-16 px-4">
<h1 class="text-5xl font-bold text-slate-900 mb-4">国产芯片替代<span class="text-[#0F4C81]">智能选型平台</span></h1>
<p class="text-xl text-slate-600 max-w-2xl mx-auto mb-8">收录<span class="font-bold">{chips.length}</span>款国产替代芯片</p>
<div class="grid grid-cols-3 gap-4 max-w-2xl mx-auto mb-8">
<div class="card text-center py-4"><p class="text-3xl font-bold text-[#0F4C81]">{chips.length}</p><p class="text-sm text-slate-500">收录芯片</p></div>
<div class="card text-center py-4"><p class="text-3xl font-bold text-[#0F4C81]">{policies.length}</p><p class="text-sm text-slate-500">政策条目</p></div>
<div class="card text-center py-4"><p class="text-3xl font-bold text-[#0F4C81]">{restricted.length}</p><p class="text-sm text-slate-500">受限追踪</p></div>
</div>
<div class="flex justify-center gap-4 flex-wrap mb-6">
<a href="/chips" class="btn-primary">浏览芯片库</a>
<a href="/policy" class="btn-secondary">查看管制政策</a>
</div>
<input type="text" placeholder="输入型号如 STM32F103C8T6" class="search-input" onkeydown="if(event.key==='Enter')window.location.href='/chips?search='+this.value">
<p class="text-xs text-slate-400 mt-4">数据来源：BIS联邦公报、企业官方公告、中国海关总署</p>
</section>
<section class="max-w-7xl mx-auto px-4 mb-12">
<h2 class="text-2xl font-bold mb-4 flex items-center gap-2">
<span class="w-2 h-2 bg-red-500 rounded-full"></span>
本月新增政策速览
</h2>
<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
{latestPolicies.map(p => (
<a href="/policy" class="card block hover:shadow-md transition-shadow">
<div class="flex justify-between items-start mb-2">
<span class="text-xs text-slate-400">{p.date}</span>
<span class={`badge ${p.impactLevel==='high'?'bg-red-100 text-red-700':'bg-yellow-100 text-yellow-700'}`}>
{p.impactLevel==='high'?'高影响':'中影响'}
</span>
</div>
<h3 class="font-bold text-slate-800 mb-1">{p.title}</h3>
<p class="text-sm text-slate-600 line-clamp-2">{p.summary}</p>
</a>
))}
</div>
</section>
<section class="max-w-7xl mx-auto px-4 mb-16">
<h2 class="text-3xl font-bold mb-6">热门替代芯片</h2>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
{chips.slice(0,6).map(chip=>(<a href={`/chip/${chip.id}`} class="card block"><div class="flex justify-between"><h3 class="font-bold text-lg">{chip.name}</h3><span class="badge badge-green">P2P</span></div><p class="text-sm text-slate-500">替代 {chip.originalEquivalent}</p><div class="mt-3 flex justify-between"><span class="text-[#E48736] font-bold">{chip.price}</span><span class="text-xs text-slate-400">{chip.manufacturer}</span></div></a>))}
</div>
</section>
</Layout>