---
import Layout from '../layouts/Layout.astro';
const enterprises = (await import('../data/enterprises.json')).default;
const chips = (await import('../data/chips.json')).default;
const policies = (await import('../data/policies.json')).default;
const keywords = ['STM32替代', '电源芯片', 'RISC-V', 'AI芯片'];
---
<Layout title="国产芯片替代指南" description="追踪芯片管制，验证国产替代。数据来源：BIS联邦公报、企业公告、海关总署。">
<!-- 搜索区 -->
<section class="bg-white py-16 px-4">
<div class="max-w-3xl mx-auto text-center">
<!-- 搜索框 -->
<div class="relative mb-4">
<svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
<input type="text" placeholder="搜索芯片型号，如STM32F103C8T6" class="w-full pl-12 pr-4 py-4 text-lg border border-gray-200 rounded-lg focus:outline-none focus:border-gray-400 focus:ring-1 focus:ring-gray-200">
</div>
<!-- 关键词标签 -->
<div class="flex justify-center gap-3 mb-4">
{keywords.map(k => (
<button class="px-3 py-1.5 text-sm text-gray-500 bg-gray-50 rounded hover:bg-gray-100">{k}</button>
))}
</div>
<!-- 数据来源 -->
<p class="text-xs text-gray-400">数据来源：BIS联邦公报 · 企业公告 · 海关总署</p>
</div>
</section>
<!-- 数据看板 -->
<section class="py-8 border-t border-gray-100">
<div class="max-w-4xl mx-auto">
<div class="grid grid-cols-4 gap-8 text-center">
<div>
<div class="text-3xl font-semibold text-gray-900">{chips.length}</div>
<div class="text-xs text-gray-400 mt-1">收录芯片数</div>
</div>
<div>
<div class="text-3xl font-semibold text-gray-900">{policies.length}</div>
<div class="text-xs text-gray-400 mt-1">政策数</div>
</div>
<div>
<div class="text-3xl font-semibold text-gray-900">9</div>
<div class="text-xs text-gray-400 mt-1">受限项数</div>
</div>
<div>
<div class="text-3xl font-semibold text-gray-900">{enterprises.length}</div>
<div class="text-xs text-gray-400 mt-1">制裁企业数</div>
</div>
</div>
</div>
</section>
<div class="max-w-5xl mx-auto px-4">
<!-- 热门芯片 -->
<section class="py-10">
<h2 class="text-sm font-medium text-gray-500 mb-6">热门替代方案</h2>
<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
{chips.slice(0,3).map(chip => (
<a href={`/chip/${chip.id}`} class="block bg-white border border-gray-100 rounded-lg p-4 hover:border-gray-200">
<div class="flex justify-between items-start mb-2">
<div>
<div class="text-base font-medium text-gray-900">{chip.name}</div>
<div class="text-xs text-gray-400">{chip.manufacturer}</div>
</div>
<span class="text-sm font-medium text-orange-500">{chip.price}</span>
</div>
<div class="flex items-center gap-2">
<span class={`text-xs px-1.5 py-0.5 rounded ${chip.substituteLevel==='pin2pin'?'bg-green-50 text-green-600':'bg-blue-50 text-blue-600'}`}>
{chip.substituteLevel==='pin2pin'?'P2P':'功能'}
</span>
<span class="text-xs text-gray-400">替代 {chip.originalEquivalent}</span>
</div>
</a>
))}
</div>
</section>
<!-- 最新管制动态 -->
<section class="py-10 border-t border-gray-100">
<h2 class="text-sm font-medium text-gray-500 mb-6">最新管制动态</h2>
<div class="space-y-3">
{policies.slice(0,3).map(p => (
<a href="/policy" class="flex items-center gap-4 py-3 hover:bg-gray-50 rounded-lg -mx-2 px-2">
<span class="text-xs text-gray-400 w-20">{p.date}</span>
<span class="flex-1 text-sm text-gray-700">{p.title}</span>
<span class={`text-xs px-2 py-1 rounded ${p.impactLevel==='high'?'bg-red-50 text-red-600':p.impactLevel==='medium'?'bg-yellow-50 text-yellow-600':'bg-green-50 text-green-600'}`}>
{p.impactLevel==='high'?'高影响':p.impactLevel==='medium'?'中影响':'低影响'}
</span>
</a>
))}
</div>
</section>
</div>
<!-- 底部 -->
<footer class="py-8 text-center text-xs text-gray-400 border-t border-gray-100 mt-8">
<p>AI芯片替代指南，数据可追溯</p>
</footer>
</Layout>