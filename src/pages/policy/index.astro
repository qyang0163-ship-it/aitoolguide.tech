---
import Layout from '../../layouts/Layout.astro';

// 读取政策数据
let policies = [];
try {
  const data = await import('../../data/policies.json');
  policies = data.default || [];
} catch (e) {
  console.log('[DATA] 使用备用数据');
}

// 备用数据
if (policies.length === 0) {
  policies = [
    { id: 'bis-2024-001', title: 'BIS 先进计算芯片出口管制新规', source: '美国商务部', date: '2024-10-17', status: '生效', risk: '极高', summary: '限制向中国出口先进AI芯片及制造设备' },
    { id: 'eu-2024-002', title: '欧盟芯片法案实施细则', source: '欧盟委员会', date: '2024-09-01', status: '生效', risk: '中', summary: '建立欧洲半导体供应链安全框架' },
    { id: 'cn-2024-003', title: '中国半导体产业促进条例', source: '国务院', date: '2024-08-15', status: '生效', risk: '低', summary: '支持国产半导体产业发展' },
    { id: 'jp-2024-004', title: '日本半导体设备出口管制', source: '经产省', date: '2024-07-23', status: '生效', risk: '高', summary: '限制23类半导体设备对华出口' },
    { id: 'kr-2024-005', title: '韩国芯片产业安全法案', source: '产业通商部', date: '2024-06-10', status: '审议', risk: '中', summary: '加强半导体供应链安全管理' },
    { id: 'tw-2024-006', title: '台湾芯片产业保护条例', source: '经济部', date: '2024-05-20', status: '生效', risk: '高', summary: '限制核心技术外流' },
  ];
}

const hasData = policies.length > 0;
const categories = ['全部', '出口管制', '产业促进', '供应链安全', '技术封锁'];
const sources = ['全部', '美国', '欧盟', '中国', '日本', '韩国', '台湾'];
---
<Layout title="政策追踪 | SCIP MONITOR" description="半导体政策监控数据库">
<div style="min-height: 100vh; background: #020617; font-family: 'JetBrains Mono', monospace; padding-top: 80px;">
  <div style="max-width: 1400px; margin: 0 auto; padding: 0 24px;">
    
    <div style="font-size: 12px; color: #64748b; margin-bottom: 24px; padding: 12px 16px; background: rgba(15, 23, 42, 0.6); border: 1px solid #1e293b; border-radius: 8px;">
      <span style="color: #22c55e;">root@ai2424</span><span style="color: #64748b;">:</span><span style="color: #22d3ee;">~</span><span style="color: #64748b;">/</span><span style="color: #fbbf24;">policy</span><span style="color: #22c55e; margin-left: 4px;">_</span>
    </div>
    
    <div style="margin-bottom: 32px;">
      <div style="display: flex; align-items: center; gap: 16px;">
        <div style="width: 56px; height: 56px; background: linear-gradient(135deg, #ef4444, #dc2626); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 28px;">📋</div>
        <div>
          <h1 style="font-size: 32px; color: #e2e8f0; margin: 0; font-weight: 700;">POLICY TRACKER</h1>
          <p style="font-size: 14px; color: #64748b; margin: 8px 0 0 0;">全球半导体政策监控中心 · 已收录 {policies.length} 条政策</p>
        </div>
      </div>
    </div>
    
    {hasData ? (
      <>
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 32px;">
          <div style="background: rgba(15, 23, 42, 0.8); border: 1px solid #334155; border-radius: 12px; padding: 24px;">
            <div style="font-size: 32px; font-weight: bold; color: #ef4444; text-shadow: 0 0 20px rgba(239, 68, 68, 0.4);">{policies.length}</div>
            <div style="font-size: 12px; color: #64748b; margin-top: 8px;">监控政策</div>
          </div>
          <div style="background: rgba(15, 23, 42, 0.8); border: 1px solid #334155; border-radius: 12px; padding: 24px;">
            <div style="font-size: 32px; font-weight: bold; color: #fbbf24; text-shadow: 0 0 20px rgba(251, 191, 36, 0.4);">1,247</div>
            <div style="font-size: 12px; color: #64748b; margin-top: 8px;">生效中</div>
          </div>
          <div style="background: rgba(15, 23, 42, 0.8); border: 1px solid #334155; border-radius: 12px; padding: 24px;">
            <div style="font-size: 32px; font-weight: bold; color: #22d3ee; text-shadow: 0 0 20px rgba(34, 211, 238, 0.4);">89</div>
            <div style="font-size: 12px; color: #64748b; margin-top: 8px;">审议中</div>
          </div>
          <div style="background: rgba(15, 23, 42, 0.8); border: 1px solid #334155; border-radius: 12px; padding: 24px;">
            <div style="font-size: 32px; font-weight: bold; color: #a78bfa; text-shadow: 0 0 20px rgba(167, 139, 250, 0.4);">5,800</div>
            <div style="font-size: 12px; color: #64748b; margin-top: 8px;">受限项</div>
          </div>
        </div>
        
        <div style="background: rgba(15, 23, 42, 0.8); border: 1px solid #334155; border-radius: 12px; padding: 20px; margin-bottom: 24px;">
          <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 12px;">
            {categories.map(cat => (
              <button style="padding: 8px 16px; font-size: 12px; border: 1px solid #334155; background: transparent; color: #94a3b8; border-radius: 6px; cursor: pointer;">{cat}</button>
            ))}
          </div>
          <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 16px;">
            {sources.map(src => (
              <button style="padding: 6px 14px; font-size: 11px; border: 1px solid #334155; background: transparent; color: #64748b; border-radius: 4px; cursor: pointer;">{src}</button>
            ))}
          </div>
          <div style="display: flex; gap: 12px;">
            <div style="flex: 1; display: flex; align-items: center; background: #020617; border: 1px solid #334155; border-radius: 8px; padding: 0 16px;">
              <span style="color: #ef4444; margin-right: 12px;">$</span>
              <input type="text" placeholder="search --title 芯片 --source BIS --status 生效" style="flex: 1; background: transparent; border: none; color: #e2e8f0; padding: 14px 0; font-family: inherit; font-size: 14px; outline: none;" />
            </div>
            <button style="padding: 14px 28px; background: rgba(239, 68, 68, 0.2); border: 1px solid rgba(239, 68, 68, 0.4); color: #ef4444; border-radius: 8px; font-size: 12px; font-weight: 600; cursor: pointer;">EXECUTE</button>
          </div>
        </div>
        
        <div style="display: flex; flex-direction: column; gap: 16px;">
          {policies.map(item => (
            <a href={`/policy/${item.id}`} style="background: rgba(15, 23, 42, 0.8); border: 1px solid #334155; border-radius: 12px; padding: 24px; text-decoration: none; transition: all 0.2s;" onmouseenter="this.style.borderColor='#ef4444'; this.style.transform='translateX(4px)'" onmouseleave="this.style.borderColor='#334155'; this.style.transform='translateX(0)'">
              <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
                <div style="display: flex; align-items: center; gap: 16px;">
                  <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #ef4444, #dc2626); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 24px;">📋</div>
                  <div>
                    <div style="font-size: 17px; color: #e2e8f0; font-weight: 600;">{item.title}</div>
                    <div style="font-size: 12px; color: #64748b; margin-top: 4px;">{item.source} · {item.date}</div>
                  </div>
                </div>
                <div style="display: flex; flex-direction: column; gap: 6px; align-items: flex-end;">
                  <span style={`padding: 6px 12px; font-size: 11px; border-radius: 4px; ${item.status === '生效' ? 'background: rgba(239, 68, 68, 0.15); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3)' : 'background: rgba(34, 211, 238, 0.15); color: #22d3ee; border: 1px solid rgba(34, 211, 238, 0.3)'};`}>{item.status}</span>
                  <span style="padding: 4px 10px; font-size: 10px; border-radius: 4px; background: rgba(100, 116, 139, 0.2); color: #94a3b8;">风险: {item.risk}</span>
                </div>
              </div>
              <div style="background: rgba(30, 41, 59, 0.6); border-radius: 8px; padding: 16px;">
                <div style="font-size: 11px; color: #64748b; margin-bottom: 6px;">政策摘要</div>
                <div style="font-size: 14px; color: #e2e8f0; line-height: 1.6;">{item.summary}</div>
              </div>
            </a>
          ))}
        </div>
      </>
    ) : (
      <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 120px 24px; text-align: center;">
        <div style="width: 80px; height: 80px; border: 3px solid #334155; border-top-color: #ef4444; border-radius: 50%; animation: spin 1s linear infinite; margin-bottom: 32px;"></div>
        <h2 style="font-size: 24px; color: #e2e8f0; margin-bottom: 12px;">数据正在由 P100 算力节点同步中...</h2>
        <p style="font-size: 14px; color: #64748b;">政策数据库正在从 F:\mined_data\policies 同步到云端</p>
      </div>
    )}
    
  </div>
</div>

<style>
@keyframes spin {
  to { transform: rotate(360deg); }
}
</style>
</Layout>