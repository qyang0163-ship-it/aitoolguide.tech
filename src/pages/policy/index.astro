---
import Layout from '../../layouts/Layout.astro';

// 读取政策数据
let policies = [];
try {
  const data = await import('../../data/policies.json');
  policies = data.default || [];
} catch (e) {
  console.log('[DATA] 使用备用数据');
}

// 备用数据
if (policies.length === 0) {
  policies = [
    { id: 'bis-2024-001', title: 'BIS 新增 14 家中国实体至实体清单', source: 'BIS联邦公报', date: '2024-12-02', type: '实体清单', severity: 'critical', status: '生效' },
    { id: 'bis-2024-002', title: '更新先进计算芯片出口管制规则', source: 'BIS联邦公报', date: '2024-10-17', type: '出口管制', severity: 'high', status: '生效' },
    { id: 'eu-2024-001', title: '欧盟芯片法案对华投资审查条款', source: '欧盟委员会', date: '2024-09-21', type: '投资审查', severity: 'medium', status: '审议中' },
    { id: 'jp-2024-001', title: '日本半导体设备出口管制清单更新', source: '日本经产省', date: '2024-08-23', type: '出口管制', severity: 'high', status: '生效' },
    { id: 'us-2024-003', title: '美国对华半导体投资禁令实施细则', source: '美国财政部', date: '2024-06-28', type: '投资禁令', severity: 'high', status: '生效' },
    { id: 'cn-2024-001', title: '中国半导体产业促进政策 2.0', source: '国务院', date: '2024-05-15', type: '产业支持', severity: 'info', status: '生效' },
    { id: 'tw-2024-001', title: '台湾地区对大陆芯片出口限制', source: '台湾经济部', date: '2024-04-10', type: '出口限制', severity: 'medium', status: '生效' },
    { id: 'kr-2024-001', title: '韩国对华半导体设备出口许可要求', source: '韩国产业部', date: '2024-03-22', type: '出口管制', severity: 'medium', status: '生效' },
  ];
}

const hasData = policies.length > 0;
const types = ['全部', '实体清单', '出口管制', '投资审查', '投资禁令', '产业支持', '出口限制'];
---
<Layout title="政策追踪 | SCIP MONITOR" description="半导体管制政策数据库">
<div style="min-height: 100vh; background: #020617; font-family: 'JetBrains Mono', monospace; padding-top: 80px;">
  <div style="max-width: 1400px; margin: 0 auto; padding: 0 24px;">
    
    <div style="font-size: 12px; color: #64748b; margin-bottom: 24px; padding: 12px 16px; background: rgba(15, 23, 42, 0.6); border: 1px solid #1e293b; border-radius: 8px;">
      <span style="color: #22c55e;">root@ai2424</span><span style="color: #64748b;">:</span><span style="color: #22d3ee;">~</span><span style="color: #64748b;">/</span><span style="color: #fbbf24;">policy</span><span style="color: #22c55e; margin-left: 4px;">_</span>
    </div>
    
    <div style="margin-bottom: 32px;">
      <div style="display: flex; align-items: center; gap: 16px;">
        <div style="width: 56px; height: 56px; background: linear-gradient(135deg, #ef4444, #dc2626); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 28px;">📋</div>
        <div>
          <h1 style="font-size: 32px; color: #e2e8f0; margin: 0; font-weight: 700;">POLICY TRACKER</h1>
          <p style="font-size: 14px; color: #64748b; margin: 8px 0 0 0;">全球半导体管制政策情报中心 · 已追踪 {policies.length} 条政策</p>
        </div>
      </div>
    </div>
    
    {hasData ? (
      <>
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 32px;">
          <div style="background: rgba(15, 23, 42, 0.8); border: 1px solid #334155; border-radius: 12px; padding: 24px;">
            <div style="font-size: 32px; font-weight: bold; color: #ef4444; text-shadow: 0 0 20px rgba(239, 68, 68, 0.4);">{policies.length}</div>
            <div style="font-size: 12px; color: #64748b; margin-top: 8px;">追踪政策</div>
          </div>
          <div style="background: rgba(15, 23, 42, 0.8); border: 1px solid #334155; border-radius: 12px; padding: 24px;">
            <div style="font-size: 32px; font-weight: bold; color: #ef4444; text-shadow: 0 0 20px rgba(239, 68, 68, 0.4);">23</div>
            <div style="font-size: 12px; color: #64748b; margin-top: 8px;">严重级别</div>
          </div>
          <div style="background: rgba(15, 23, 42, 0.8); border: 1px solid #334155; border-radius: 12px; padding: 24px;">
            <div style="font-size: 32px; font-weight: bold; color: #fbbf24; text-shadow: 0 0 20px rgba(251, 191, 36, 0.4);">67</div>
            <div style="font-size: 12px; color: #64748b; margin-top: 8px;">高风险</div>
          </div>
          <div style="background: rgba(15, 23, 42, 0.8); border: 1px solid #334155; border-radius: 12px; padding: 24px;">
            <div style="font-size: 32px; font-weight: bold; color: #22d3ee; text-shadow: 0 0 20px rgba(34, 211, 238, 0.4);">66</div>
            <div style="font-size: 12px; color: #64748b; margin-top: 8px;">监控中</div>
          </div>
        </div>
        
        <div style="background: rgba(15, 23, 42, 0.8); border: 1px solid #334155; border-radius: 12px; padding: 20px; margin-bottom: 24px;">
          <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 16px;">
            {types.map(type => (
              <button style="padding: 8px 16px; font-size: 12px; border: 1px solid #334155; background: transparent; color: #94a3b8; border-radius: 6px; cursor: pointer;">{type}</button>
            ))}
          </div>
          <div style="display: flex; gap: 12px;">
            <div style="flex: 1; display: flex; align-items: center; background: #020617; border: 1px solid #334155; border-radius: 8px; padding: 0 16px;">
              <span style="color: #ef4444; margin-right: 12px;">$</span>
              <input type="text" placeholder="search --source BIS --type 实体清单 --severity critical" style="flex: 1; background: transparent; border: none; color: #e2e8f0; padding: 14px 0; font-family: inherit; font-size: 14px; outline: none;" />
            </div>
            <button style="padding: 14px 28px; background: rgba(239, 68, 68, 0.2); border: 1px solid rgba(239, 68, 68, 0.4); color: #ef4444; border-radius: 8px; font-size: 12px; font-weight: 600; cursor: pointer;">EXECUTE</button>
          </div>
        </div>
        
        <div style="display: flex; flex-direction: column; gap: 12px;">
          {policies.map(item => (
            <a href={`/policy/${item.id}`} style="background: rgba(15, 23, 42, 0.8); border: 1px solid #334155; border-radius: 12px; padding: 24px; text-decoration: none; transition: all 0.2s;" onmouseenter="this.style.borderColor='#ef4444'; this.style.transform='translateX(8px)'" onmouseleave="this.style.borderColor='#334155'; this.style.transform='translateX(0)'">
              <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
                <div style="flex: 1;">
                  <div style="font-size: 16px; color: #e2e8f0; font-weight: 600; margin-bottom: 12px; line-height: 1.5;">{item.title}</div>
                  <div style="display: flex; gap: 16px; flex-wrap: wrap;">
                    <span style="font-size: 12px; color: #64748b;">📅 {item.date}</span>
                    <span style="font-size: 12px; color: #64748b;">📰 {item.source}</span>
                  </div>
                </div>
                <div style="display: flex; flex-direction: column; gap: 8px; align-items: flex-end;">
                  <span style={`padding: 6px 12px; font-size: 11px; border-radius: 4px; font-weight: 600; ${item.severity === 'critical' ? 'background: rgba(239, 68, 68, 0.2); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.4)' : item.severity === 'high' ? 'background: rgba(251, 191, 36, 0.2); color: #fbbf24; border: 1px solid rgba(251, 191, 36, 0.4)' : 'background: rgba(34, 211, 238, 0.2); color: #22d3ee; border: 1px solid rgba(34, 211, 238, 0.4)'};`}>
                    {item.severity.toUpperCase()}
                  </span>
                  <span style="padding: 6px 12px; font-size: 11px; border-radius: 4px; background: rgba(100, 116, 139, 0.2); color: #94a3b8; border: 1px solid rgba(100, 116, 139, 0.4);">{item.type}</span>
                </div>
              </div>
              <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 16px; border-top: 1px solid #334155;">
                <span style={`font-size: 12px; padding: 6px 12px; border-radius: 4px; font-weight: 500; ${item.status === '生效' ? 'background: rgba(34, 197, 94, 0.15); color: #22c55e' : 'background: rgba(251, 191, 36, 0.15); color: #fbbf24'};`}>● {item.status}</span>
                <span style="font-size: 12px; color: #64748b;">查看详情 →</span>
              </div>
            </a>
          ))}
        </div>
      </>
    ) : (
      <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 120px 24px; text-align: center;">
        <div style="width: 80px; height: 80px; border: 3px solid #334155; border-top-color: #ef4444; border-radius: 50%; animation: spin 1s linear infinite; margin-bottom: 32px;"></div>
        <h2 style="font-size: 24px; color: #e2e8f0; margin-bottom: 12px;">数据正在由 P100 算力节点同步中...</h2>
        <p style="font-size: 14px; color: #64748b;">政策数据库正在从 F:\mined_data\policies 同步到云端</p>
      </div>
    )}
    
  </div>
</div>

<style>
@keyframes spin {
  to { transform: rotate(360deg); }
}
</style>
</Layout>