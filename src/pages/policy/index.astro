---
import Layout from '../../layouts/Layout.astro';
import TerminalBreadcrumb from '../../components/TerminalBreadcrumb.astro';

const policies = [
  { id: 'bis-2024-001', title: 'BIS 新增 14 家中国实体至实体清单', source: 'BIS联邦公报', date: '2024-12-02', type: '实体清单', severity: 'critical', status: '生效' },
  { id: 'bis-2024-002', title: '更新先进计算芯片出口管制规则', source: 'BIS联邦公报', date: '2024-10-17', type: '出口管制', severity: 'high', status: '生效' },
  { id: 'eu-2024-001', title: '欧盟芯片法案对华投资审查条款', source: '欧盟委员会', date: '2024-09-21', type: '投资审查', severity: 'medium', status: '审议中' },
  { id: 'jp-2024-001', title: '日本半导体设备出口管制清单更新', source: '日本经产省', date: '2024-08-23', type: '出口管制', severity: 'high', status: '生效' },
  { id: 'us-2024-003', title: '美国对华半导体投资禁令实施细则', source: '美国财政部', date: '2024-06-28', type: '投资禁令', severity: 'high', status: '生效' },
  { id: 'cn-2024-001', title: '中国半导体产业促进政策 2.0', source: '国务院', date: '2024-05-15', type: '产业支持', severity: 'info', status: '生效' },
  { id: 'tw-2024-001', title: '台湾地区对大陆芯片出口限制', source: '台湾经济部', date: '2024-04-10', type: '出口限制', severity: 'medium', status: '生效' },
  { id: 'kr-2024-001', title: '韩国对华半导体设备出口许可要求', source: '韩国产业部', date: '2024-03-22', type: '出口管制', severity: 'medium', status: '生效' },
];

const types = ['全部', '实体清单', '出口管制', '投资审查', '投资禁令', '产业支持', '出口限制'];
const stats = { total: 156, critical: 23, high: 67, monitoring: 66 };
---
<Layout title="政策追踪 | SCIP MONITOR" description="半导体管制政策数据库">
<div style="min-height: 100vh; background: #020617; font-family: 'JetBrains Mono', monospace; padding-top: 80px;">
  <div style="max-width: 1400px; margin: 0 auto; padding: 0 24px;">
    
    <TerminalBreadcrumb path={[{label: 'policy'}]} />
    
    <div style="margin-bottom: 32px;">
      <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 12px;">
        <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #ef4444, #dc2626); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 24px;">📋</div>
        <div>
          <h1 style="font-size: 24px; color: #e2e8f0; margin: 0; font-weight: 600;">POLICY TRACKER</h1>
          <p style="font-size: 12px; color: #64748b; margin: 4px 0 0 0;">全球半导体管制政策情报中心</p>
        </div>
      </div>
    </div>
    
    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 32px;">
      <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid #1e293b; border-radius: 12px; padding: 20px;">
        <div style="font-size: 28px; font-weight: bold; color: #ef4444; text-shadow: 0 0 10px rgba(239, 68, 68, 0.3);">{stats.total}</div>
        <div style="font-size: 12px; color: #64748b; margin-top: 4px;">追踪政策</div>
      </div>
      <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid #1e293b; border-radius: 12px; padding: 20px;">
        <div style="font-size: 28px; font-weight: bold; color: #ef4444; text-shadow: 0 0 10px rgba(239, 68, 68, 0.3);">{stats.critical}</div>
        <div style="font-size: 12px; color: #64748b; margin-top: 4px;">严重级别</div>
      </div>
      <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid #1e293b; border-radius: 12px; padding: 20px;">
        <div style="font-size: 28px; font-weight: bold; color: #fbbf24; text-shadow: 0 0 10px rgba(251, 191, 36, 0.3);">{stats.high}</div>
        <div style="font-size: 12px; color: #64748b; margin-top: 4px;">高风险</div>
      </div>
      <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid #1e293b; border-radius: 12px; padding: 20px;">
        <div style="font-size: 28px; font-weight: bold; color: #22d3ee; text-shadow: 0 0 10px rgba(34, 211, 238, 0.3);">{stats.monitoring}</div>
        <div style="font-size: 12px; color: #64748b; margin-top: 4px;">监控中</div>
      </div>
    </div>
    
    <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid #1e293b; border-radius: 12px; padding: 20px; margin-bottom: 24px;">
      <div style="display: flex; gap: 12px; flex-wrap: wrap;">
        {types.map(type => (
          <button style={`padding: 8px 16px; font-size: 12px; border: 1px solid ${type === '全部' ? '#ef4444' : '#334155'}; background: ${type === '全部' ? 'rgba(239, 68, 68, 0.1)' : 'transparent'}; color: ${type === '全部' ? '#ef4444' : '#94a3b8'}; border-radius: 6px; cursor: pointer;`}>{type}</button>
        ))}
      </div>
      <div style="margin-top: 16px; display: flex; gap: 12px;">
        <div style="flex: 1; display: flex; align-items: center; background: #020617; border: 1px solid #334155; border-radius: 8px; padding: 0 16px;">
          <span style="color: #ef4444; margin-right: 12px;">$</span>
          <input type="text" placeholder="search --source BIS --type 实体清单 --severity critical" style="flex: 1; background: transparent; border: none; color: #e2e8f0; padding: 12px 0; font-family: inherit; outline: none;" />
        </div>
        <button style="padding: 12px 24px; background: rgba(239, 68, 68, 0.2); border: 1px solid rgba(239, 68, 68, 0.3); color: #ef4444; border-radius: 8px; font-size: 12px; cursor: pointer;">EXECUTE</button>
      </div>
    </div>
    
    <div style="display: flex; flex-direction: column; gap: 12px;">
      {policies.map(item => (
        <a href={`/policy/${item.id}`} style="background: rgba(15, 23, 42, 0.6); border: 1px solid #1e293b; border-radius: 12px; padding: 20px; text-decoration: none; transition: all 0.2s;" onmouseenter="this.style.borderColor='#ef4444'; this.style.transform='translateX(4px)'" onmouseleave="this.style.borderColor='#1e293b'; this.style.transform='translateX(0)'">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
            <div style="flex: 1;">
              <div style="font-size: 14px; color: #e2e8f0; font-weight: 500; margin-bottom: 8px; line-height: 1.4;">{item.title}</div>
              <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                <span style="font-size: 11px; color: #64748b;">📅 {item.date}</span>
                <span style="font-size: 11px; color: #64748b;">📰 {item.source}</span>
              </div>
            </div>
            <div style="display: flex; flex-direction: column; gap: 6px; align-items: flex-end;">
              <span style={`padding: 4px 10px; font-size: 10px; border-radius: 4px; ${item.severity === 'critical' ? 'background: rgba(239, 68, 68, 0.15); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.4)' : item.severity === 'high' ? 'background: rgba(251, 191, 36, 0.15); color: #fbbf24; border: 1px solid rgba(251, 191, 36, 0.4)' : 'background: rgba(34, 211, 238, 0.15); color: #22d3ee; border: 1px solid rgba(34, 211, 238, 0.4)'};`}>
                {item.severity.toUpperCase()}
              </span>
              <span style={`padding: 4px 10px; font-size: 10px; border-radius: 4px; background: rgba(100, 116, 139, 0.2); color: #94a3b8; border: 1px solid rgba(100, 116, 139, 0.3);`}>{item.type}</span>
            </div>
          </div>
          <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 12px; border-top: 1px solid #1e293b;">
            <span style={`font-size: 11px; padding: 4px 10px; border-radius: 4px; ${item.status === '生效' ? 'background: rgba(34, 197, 94, 0.1); color: #22c55e' : 'background: rgba(251, 191, 36, 0.1); color: #fbbf24'};`}>● {item.status}</span>
            <span style="font-size: 11px; color: #64748b;">查看详情 →</span>
          </div>
        </a>
      ))}
    </div>
    
  </div>
</div>
</Layout>