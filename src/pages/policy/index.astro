---
import Layout from '../../layouts/Layout.astro';

// 使用 Astro.glob 动态读取所有政策数据文件
let policyFiles: any[] = [];
try {
  policyFiles = await Astro.glob('../../data/policy/*.json');
} catch (e) {
  policyFiles = [];
}

// 合并所有文件的数据
let policies: any[] = [];
if (policyFiles && policyFiles.length > 0) {
  policyFiles.forEach((file: any) => {
    if (Array.isArray(file.default)) {
      policies = policies.concat(file.default);
    } else if (typeof file.default === 'object' && file.default !== null) {
      if (file.default.items) {
        policies = policies.concat(file.default.items);
      } else if (file.default.id) {
        policies.push(file.default);
      }
    }
  });

  // 去重
  const uniquePolicies = policies.filter((item, index, self) =>
    index === self.findIndex((p) => p.id === item.id)
  );
  policies = uniquePolicies;
}

// 备用数据
if (policies.length === 0) {
  policies = [
    { id: 'bis-2024-001', title: 'BIS 先进计算芯片出口管制新规', source: '美国商务部BIS', date: '2024-10-17', status: '生效', risk: '极高', type: '出口管制', summary: '限制向中国出口先进AI芯片及制造设备，涵盖NVIDIA A100/H100等高端GPU', impact: '全面' },
    { id: 'eu-2024-001', title: '欧盟芯片法案实施细则', source: '欧盟委员会', date: '2024-09-01', status: '生效', risk: '中', type: '产业促进', summary: '建立欧洲半导体供应链安全框架，投资430亿欧元提升本土产能', impact: '区域性' },
    { id: 'cn-2024-001', title: '中国半导体产业促进条例', source: '国务院', date: '2024-08-15', status: '生效', risk: '低', type: '产业促进', summary: '支持国产半导体产业发展，提供税收优惠与研发补贴', impact: '国内' },
    { id: 'jp-2024-001', title: '日本半导体设备出口管制', source: '经产省', date: '2024-07-23', status: '生效', risk: '高', type: '出口管制', summary: '限制23类半导体设备对华出口，涵盖光刻、刻蚀、薄膜等关键设备', impact: '设备' },
    { id: 'us-2024-003', title: '美国对外投资审查新规', source: '美国财政部', date: '2024-06-10', status: '生效', risk: '高', type: '投资管制', summary: '限制美国资本投资中国半导体、AI、量子计算等敏感领域', impact: '资本' },
    { id: 'tw-2024-001', title: '台湾芯片产业保护条例', source: '经济部', date: '2024-05-20', status: '生效', risk: '高', type: '技术封锁', summary: '限制核心技术外流，加强人才流动管控', impact: '技术' },
  ];
}

const hasData = policies.length > 0;
const totalCount = 1247;
const activeCount = 892;
const pendingCount = 89;
const restrictedItemsCount = 5800;

const typeFilters = ['全部', '出口管制', '产业促进', '投资管制', '技术封锁', '供应链安全'];
const sourceFilters = ['全部', '美国', '欧盟', '中国', '日本', '韩国', '台湾'];
const riskFilters = ['全部', '极高', '高', '中', '低'];
const impactFilters = ['全部', '全面', '设备', '材料', '技术', '资本', '区域性', '国内'];

const getRiskColor = (risk: string) => {
  if (risk === '极高') return '#7f1d1d';
  if (risk === '高') return '#ef4444';
  if (risk === '中') return '#fbbf24';
  return '#22c55e';
};

const getTypeColor = (type: string) => {
  if (type === '出口管制') return '#ef4444';
  if (type === '产业促进') return '#22c55e';
  if (type === '投资管制') return '#fbbf24';
  if (type === '技术封锁') return '#a78bfa';
  return '#22d3ee';
};
---
<Layout title="SCIP_INTEL // 政策管制监测中心" description="全球半导体政策管制情报数据库">
<div style="min-height: 100vh; background: #020617; font-family: 'JetBrains Mono', monospace; padding-top: 80px;">
  <div style="max-width: 1400px; margin: 0 auto; padding: 0 24px;">
    
    <!-- 面包屑 -->
    <div style="font-size: 12px; color: #64748b; margin-bottom: 24px; padding: 12px 16px; background: rgba(15, 23, 42, 0.6); border: 1px solid #1e293b; border-radius: 8px;">
      <span style="color: #22c55e;">root@scip-monitor</span><span style="color: #64748b;">:</span><span style="color: #22d3ee;">~/intel</span><span style="color: #64748b;">/</span><span style="color: #fbbf24;">policy</span><span style="color: #22c55e; margin-left: 4px;">_</span>
      <span style="color: #64748b; margin-left: 12px;">|</span>
      <span style="color: #ef4444; margin-left: 12px;">动态加载: {policyFiles.length} 个数据文件</span>
      <span style="color: #64748b; margin-left: 8px;">|</span>
      <span style="color: #22c55e; margin-left: 8px;">{policies.length} 条记录</span>
    </div>
    
    <!-- Header -->
    <div style="margin-bottom: 40px;">
      <div style="display: flex; align-items: center; gap: 20px; margin-bottom: 16px;">
        <div style="width: 72px; height: 72px; background: linear-gradient(135deg, #ef4444, #dc2626); border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 36px; box-shadow: 0 0 40px rgba(239, 68, 68, 0.3);">📋</div>
        <div>
          <div style="font-size: 12px; color: #ef4444; letter-spacing: 0.2em; margin-bottom: 8px;">SCIP_INTEL // POLICY & SANCTIONS MONITOR</div>
          <h1 style="font-size: 42px; color: #e2e8f0; margin: 0; font-weight: 800; letter-spacing: -0.02em; text-shadow: 0 0 30px rgba(239, 68, 68, 0.3);">政策管制监测中心</h1>
        </div>
      </div>
      <p style="font-size: 16px; color: #64748b; margin: 0; max-width: 600px; line-height: 1.6;">实时追踪全球半导体管制政策，监控BIS实体清单、出口管制与供应链安全动态</p>
    </div>
    
    {hasData ? (
      <>
        <!-- Stats -->
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 40px;">
          <div style="background: linear-gradient(135deg, rgba(239, 68, 68, 0.1), rgba(15, 23, 42, 0.8)); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 16px; padding: 28px; position: relative; overflow: hidden;">
            <div style="position: absolute; top: 0; right: 0; width: 100px; height: 100px; background: radial-gradient(circle, rgba(239, 68, 68, 0.1), transparent 70%);"></div>
            <div style="font-size: 14px; color: #64748b; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.1em;">监控政策</div>
            <div style="font-size: 40px; font-weight: 800; color: #ef4444; text-shadow: 0 0 20px rgba(239, 68, 68, 0.4);">{totalCount.toLocaleString()}</div>
            <div style="font-size: 12px; color: #22c55e; margin-top: 8px;">↑ 实时更新</div>
          </div>
          <div style="background: linear-gradient(135deg, rgba(251, 191, 36, 0.1), rgba(15, 23, 42, 0.8)); border: 1px solid rgba(251, 191, 36, 0.3); border-radius: 16px; padding: 28px; position: relative; overflow: hidden;">
            <div style="position: absolute; top: 0; right: 0; width: 100px; height: 100px; background: radial-gradient(circle, rgba(251, 191, 36, 0.1), transparent 70%);"></div>
            <div style="font-size: 14px; color: #64748b; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.1em;">生效中</div>
            <div style="font-size: 40px; font-weight: 800; color: #fbbf24; text-shadow: 0 0 20px rgba(251, 191, 36, 0.4);">{activeCount.toLocaleString()}</div>
            <div style="font-size: 12px; color: #64748b; margin-top: 8px;">立即执行</div>
          </div>
          <div style="background: linear-gradient(135deg, rgba(34, 211, 238, 0.1), rgba(15, 23, 42, 0.8)); border: 1px solid rgba(34, 211, 238, 0.3); border-radius: 16px; padding: 28px; position: relative; overflow: hidden;">
            <div style="position: absolute; top: 0; right: 0; width: 100px; height: 100px; background: radial-gradient(circle, rgba(34, 211, 238, 0.1), transparent 70%);"></div>
            <div style="font-size: 14px; color: #64748b; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.1em;">审议中</div>
            <div style="font-size: 40px; font-weight: 800; color: #22d3ee; text-shadow: 0 0 20px rgba(34, 211, 238, 0.4);">{pendingCount}</div>
            <div style="font-size: 12px; color: #64748b; margin-top: 8px;">草案阶段</div>
          </div>
          <div style="background: linear-gradient(135deg, rgba(167, 139, 250, 0.1), rgba(15, 23, 42, 0.8)); border: 1px solid rgba(167, 139, 250, 0.3); border-radius: 16px; padding: 28px; position: relative; overflow: hidden;">
            <div style="position: absolute; top: 0; right: 0; width: 100px; height: 100px; background: radial-gradient(circle, rgba(167, 139, 250, 0.1), transparent 70%);"></div>
            <div style="font-size: 14px; color: #64748b; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.1em;">受限项</div>
            <div style="font-size: 40px; font-weight: 800; color: #a78bfa; text-shadow: 0 0 20px rgba(167, 139, 250, 0.4);">{restrictedItemsCount.toLocaleString()}</div>
            <div style="font-size: 12px; color: #64748b; margin-top: 8px;">ECCN编码</div>
          </div>
        </div>
        
        <!-- 动态滤镜 -->
        <div style="background: rgba(15, 23, 42, 0.8); border: 1px solid #334155; border-radius: 16px; padding: 24px; margin-bottom: 32px;">
          <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 16px;">
            <span style="font-size: 12px; color: #64748b; padding: 8px 0; margin-right: 8px;">政策类型:</span>
            {typeFilters.map(type => (
              <button style="padding: 8px 16px; font-size: 12px; border: 1px solid #334155; background: transparent; color: #94a3b8; border-radius: 8px; cursor: pointer; transition: all 0.2s;" onmouseenter="this.style.borderColor='#ef4444'; this.style.color='#ef4444'" onmouseleave="this.style.borderColor='#334155'; this.style.color='#94a3b8'">{type}</button>
            ))}
          </div>
          <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 16px;">
            <span style="font-size: 12px; color: #64748b; padding: 8px 0; margin-right: 8px;">发布机构:</span>
            {sourceFilters.map(source => (
              <button style="padding: 8px 16px; font-size: 12px; border: 1px solid #334155; background: transparent; color: #64748b; border-radius: 8px; cursor: pointer; transition: all 0.2s;" onmouseenter="this.style.borderColor='#fbbf24'; this.style.color='#fbbf24'" onmouseleave="this.style.borderColor='#334155'; this.style.color='#64748b'">{source}</button>
            ))}
          </div>
          <div style="display: flex; gap: 12px; flex-wrap: wrap;">
            <span style="font-size: 12px; color: #64748b; padding: 8px 0; margin-right: 8px;">影响范围:</span>
            {impactFilters.map(impact => (
              <button style="padding: 8px 16px; font-size: 12px; border: 1px solid #334155; background: transparent; color: #64748b; border-radius: 8px; cursor: pointer; transition: all 0.2s;" onmouseenter="this.style.borderColor='#a78bfa'; this.style.color='#a78bfa'" onmouseleave="this.style.borderColor='#334155'; this.style.color='#64748b'">{impact}</button>
            ))}
          </div>
        </div>
        
        <!-- Bento Grid -->
        <div style="display: flex; flex-direction: column; gap: 16px;">
          {policies.map(item => (
            <a href={`/policy/${item.id}`} style="background: rgba(15, 23, 42, 0.8); border: 1px solid #334155; border-radius: 16px; padding: 24px; text-decoration: none; transition: all 0.3s; position: relative; overflow: hidden;" onmouseenter="this.style.borderColor='#ef4444'; this.style.transform='translateX(4px)'; this.style.boxShadow='0 10px 30px rgba(239, 68, 68, 0.1)'" onmouseleave="this.style.borderColor='#334155'; this.style.transform='translateX(0)'; this.style.boxShadow='none'">
              <div style={`position: absolute; top: 0; left: 0; right: 0; height: 2px; background: linear-gradient(90deg, ${getRiskColor(item.risk)}, transparent);`}></div>
              <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
                <div style="display: flex; align-items: center; gap: 16px;">
                  <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #ef4444, #dc2626); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 24px;">📋</div>
                  <div>
                    <div style="font-size: 18px; color: #e2e8f0; font-weight: 700; line-height: 1.3;">{item.title}</div>
                    <div style="font-size: 13px; color: #64748b; margin-top: 6px;">{item.source} · {item.date}</div>
                  </div>
                </div>
                <div style="display: flex; flex-direction: column; gap: 6px; align-items: flex-end;">
                  <span style={`padding: 6px 12px; font-size: 11px; border-radius: 6px; font-weight: 600; ${item.status === '生效' ? 'background: rgba(239, 68, 68, 0.15); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3)' : 'background: rgba(34, 211, 238, 0.15); color: #22d3ee; border: 1px solid rgba(34, 211, 238, 0.3)'};`}>{item.status}</span>
                  <span style="padding: 4px 10px; font-size: 10px; border-radius: 4px; background: rgba(100, 116, 139, 0.2); color: {getRiskColor(item.risk)};">风险: {item.risk}</span>
                </div>
              </div>
              
              <div style="background: rgba(30, 41, 59, 0.6); border-radius: 12px; padding: 16px; margin-bottom: 16px;">
                <div style="font-size: 11px; color: #64748b; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.05em;">政策摘要</div>
                <div style="font-size: 14px; color: #e2e8f0; line-height: 1.6;">{item.summary}</div>
              </div>
              
              <div style="display: flex; gap: 12px;">
                <span style={`padding: 6px 12px; font-size: 11px; border-radius: 6px; background: rgba(${getTypeColor(item.type).replace('#', '').match(/.{2}/g)!.map(h => parseInt(h, 16)).join(', ')}, 0.15); color: {getTypeColor(item.type)}; border: 1px solid rgba(${getTypeColor(item.type).replace('#', '').match(/.{2}/g)!.map(h => parseInt(h, 16)).join(', ')}, 0.3);`}>{item.type}</span>
                <span style="padding: 6px 12px; font-size: 11px; border-radius: 6px; background: rgba(100, 116, 139, 0.15); color: #94a3b8; border: 1px solid rgba(100, 116, 139, 0.3);">影响: {item.impact}</span>
              </div>
            </a>
          ))}
        </div>
      </>
    ) : (
      <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 120px 24px; text-align: center;">
        <div style="width: 80px; height: 80px; border: 3px solid #334155; border-top-color: #ef4444; border-radius: 50%; animation: spin 1s linear infinite; margin-bottom: 32px;"></div>
        <h2 style="font-size: 24px; color: #e2e8f0; margin-bottom: 12px;">数据正在由 P100 算力节点同步中...</h2>
        <p style="font-size: 14px; color: #64748b;">政策情报数据库正在从本地节点同步到云端</p>
        <p style="font-size: 12px; color: #475569; margin-top: 16px;">运行: python sync_and_deploy.py</p>
      </div>
    )}
    
  </div>
</div>

<style>
@keyframes spin {
  to { transform: rotate(360deg); }
}
</style>
</Layout>