---
import Layout from '../../layouts/Layout.astro';

// 使用 Astro.glob 动态读取所有企业数据文件
let enterpriseFiles: any[] = [];
try {
  enterpriseFiles = await Astro.glob('../../data/enterprise/*.json');
} catch (e) {
  enterpriseFiles = [];
}

// 合并所有文件的数据
let enterprises: any[] = [];
if (enterpriseFiles && enterpriseFiles.length > 0) {
  enterpriseFiles.forEach((file: any) => {
    if (Array.isArray(file.default)) {
      enterprises = enterprises.concat(file.default);
    } else if (typeof file.default === 'object' && file.default !== null) {
      if (file.default.items) {
        enterprises = enterprises.concat(file.default.items);
      } else if (file.default.id) {
        enterprises.push(file.default);
      }
    }
  });

  // 去重
  const uniqueEnterprises = enterprises.filter((item, index, self) =>
    index === self.findIndex((e) => e.id === item.id)
  );
  enterprises = uniqueEnterprises;
}

// 备用数据
if (enterprises.length === 0) {
  enterprises = [
    { id: 'naura', name: '北方华创', category: '设备制造', status: '监控中', risk: '高', revenue: '¥146亿', employees: '8,500+', marketCap: '¥1,200亿', location: '北京' },
    { id: 'amec', name: '中微公司', category: '设备制造', status: '正常', risk: '中', revenue: '¥47亿', employees: '1,200+', marketCap: '¥800亿', location: '上海' },
    { id: 'smic', name: '中芯国际', category: '晶圆代工', status: '受限', risk: '极高', revenue: '¥452亿', employees: '18,000+', marketCap: '¥2,800亿', location: '上海' },
    { id: 'hgrace', name: '华虹半导体', category: '晶圆代工', status: '正常', risk: '低', revenue: '¥168亿', employees: '6,500+', marketCap: '¥600亿', location: '上海' },
    { id: 'gigadevice', name: '兆易创新', category: '芯片设计', status: '正常', risk: '低', revenue: '¥81亿', employees: '1,100+', marketCap: '¥900亿', location: '北京' },
    { id: 'gpixel', name: '格科微', category: '芯片设计', status: '监控中', risk: '中', revenue: '¥69亿', employees: '1,800+', marketCap: '¥400亿', location: '上海' },
  ];
}

const hasData = enterprises.length > 0;
const totalCount = 1247;
const entityListCount = 34;
const restrictedTradeCount = 124;

const categories = ['全部', '设备制造', '晶圆代工', '芯片设计', '材料供应', 'EDA工具', '封测服务'];
const statusFilters = ['全部', '正常', '监控中', '受限'];
const riskFilters = ['全部', '极高', '高', '中', '低'];

const getStatusColor = (status: string) => {
  if (status === '受限') return '#ef4444';
  if (status === '监控中') return '#22d3ee';
  return '#22c55e';
};

const getRiskColor = (risk: string) => {
  if (risk === '极高') return '#7f1d1d';
  if (risk === '高') return '#ef4444';
  if (risk === '中') return '#fbbf24';
  return '#22c55e';
};
---
<Layout title="SCIP_INTEL // 企业情报监测中心" description="半导体企业监控情报数据库">
<div style="min-height: 100vh; background: #020617; font-family: 'JetBrains Mono', monospace; padding-top: 80px;">
  <div style="max-width: 1400px; margin: 0 auto; padding: 0 24px;">
    
    <!-- 面包屑 -->
    <div style="font-size: 12px; color: #64748b; margin-bottom: 24px; padding: 12px 16px; background: rgba(15, 23, 42, 0.6); border: 1px solid #1e293b; border-radius: 8px;">
      <span style="color: #22c55e;">root@scip-monitor</span><span style="color: #64748b;">:</span><span style="color: #22d3ee;">~/intel</span><span style="color: #64748b;">/</span><span style="color: #fbbf24;">enterprise</span><span style="color: #22c55e; margin-left: 4px;">_</span>
      <span style="color: #64748b; margin-left: 12px;">|</span>
      <span style="color: #fbbf24; margin-left: 12px;">动态加载: {enterpriseFiles.length} 个数据文件</span>
      <span style="color: #64748b; margin-left: 8px;">|</span>
      <span style="color: #22c55e; margin-left: 8px;">{enterprises.length} 条记录</span>
    </div>
    
    <!-- Header -->
    <div style="margin-bottom: 40px;">
      <div style="display: flex; align-items: center; gap: 20px; margin-bottom: 16px;">
        <div style="width: 72px; height: 72px; background: linear-gradient(135deg, #fbbf24, #f59e0b); border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 36px; box-shadow: 0 0 40px rgba(251, 191, 36, 0.3);">🏢</div>
        <div>
          <div style="font-size: 12px; color: #fbbf24; letter-spacing: 0.2em; margin-bottom: 8px;">SCIP_INTEL // CORPORATE INTELLIGENCE</div>
          <h1 style="font-size: 42px; color: #e2e8f0; margin: 0; font-weight: 800; letter-spacing: -0.02em; text-shadow: 0 0 30px rgba(251, 191, 36, 0.3);">企业情报监测中心</h1>
        </div>
      </div>
      <p style="font-size: 16px; color: #64748b; margin: 0; max-width: 600px; line-height: 1.6;">实时监控半导体企业动态，追踪实体清单、制裁状态与供应链风险</p>
    </div>
    
    {hasData ? (
      <>
        <!-- Stats -->
        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 40px;">
          <div style="background: linear-gradient(135deg, rgba(251, 191, 36, 0.1), rgba(15, 23, 42, 0.8)); border: 1px solid rgba(251, 191, 36, 0.3); border-radius: 16px; padding: 28px; position: relative; overflow: hidden;">
            <div style="position: absolute; top: 0; right: 0; width: 100px; height: 100px; background: radial-gradient(circle, rgba(251, 191, 36, 0.1), transparent 70%);"></div>
            <div style="font-size: 14px; color: #64748b; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.1em;">监控企业</div>
            <div style="font-size: 40px; font-weight: 800; color: #fbbf24; text-shadow: 0 0 20px rgba(251, 191, 36, 0.4);">{totalCount.toLocaleString()}</div>
            <div style="font-size: 12px; color: #22c55e; margin-top: 8px;">↑ 实时更新</div>
          </div>
          <div style="background: linear-gradient(135deg, rgba(34, 211, 238, 0.1), rgba(15, 23, 42, 0.8)); border: 1px solid rgba(34, 211, 238, 0.3); border-radius: 16px; padding: 28px; position: relative; overflow: hidden;">
            <div style="position: absolute; top: 0; right: 0; width: 100px; height: 100px; background: radial-gradient(circle, rgba(34, 211, 238, 0.1), transparent 70%);"></div>
            <div style="font-size: 14px; color: #64748b; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.1em;">重点监控</div>
            <div style="font-size: 40px; font-weight: 800; color: #22d3ee; text-shadow: 0 0 20px rgba(34, 211, 238, 0.4);">{enterprises.length}</div>
            <div style="font-size: 12px; color: #64748b; margin-top: 8px;">头部企业</div>
          </div>
          <div style="background: linear-gradient(135deg, rgba(239, 68, 68, 0.1), rgba(15, 23, 42, 0.8)); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 16px; padding: 28px; position: relative; overflow: hidden;">
            <div style="position: absolute; top: 0; right: 0; width: 100px; height: 100px; background: radial-gradient(circle, rgba(239, 68, 68, 0.1), transparent 70%);"></div>
            <div style="font-size: 14px; color: #64748b; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.1em;">实体清单</div>
            <div style="font-size: 40px; font-weight: 800; color: #ef4444; text-shadow: 0 0 20px rgba(239, 68, 68, 0.4);">{entityListCount}</div>
            <div style="font-size: 12px; color: #ef4444; margin-top: 8px;">BIS制裁</div>
          </div>
          <div style="background: linear-gradient(135deg, rgba(167, 139, 250, 0.1), rgba(15, 23, 42, 0.8)); border: 1px solid rgba(167, 139, 250, 0.3); border-radius: 16px; padding: 28px; position: relative; overflow: hidden;">
            <div style="position: absolute; top: 0; right: 0; width: 100px; height: 100px; background: radial-gradient(circle, rgba(167, 139, 250, 0.1), transparent 70%);"></div>
            <div style="font-size: 14px; color: #64748b; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.1em;">受限交易</div>
            <div style="font-size: 40px; font-weight: 800; color: #a78bfa; text-shadow: 0 0 20px rgba(167, 139, 250, 0.4);">{restrictedTradeCount}</div>
            <div style="font-size: 12px; color: #64748b; margin-top: 8px;">供应链阻断</div>
          </div>
        </div>
        
        <!-- 动态滤镜 -->
        <div style="background: rgba(15, 23, 42, 0.8); border: 1px solid #334155; border-radius: 16px; padding: 24px; margin-bottom: 32px;">
          <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 16px;">
            <span style="font-size: 12px; color: #64748b; padding: 8px 0; margin-right: 8px;">行业分类:</span>
            {categories.map(cat => (
              <button style="padding: 8px 16px; font-size: 12px; border: 1px solid #334155; background: transparent; color: #94a3b8; border-radius: 8px; cursor: pointer; transition: all 0.2s;" onmouseenter="this.style.borderColor='#fbbf24'; this.style.color='#fbbf24'" onmouseleave="this.style.borderColor='#334155'; this.style.color='#94a3b8'">{cat}</button>
            ))}
          </div>
          <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 16px;">
            <span style="font-size: 12px; color: #64748b; padding: 8px 0; margin-right: 8px;">监控状态:</span>
            {statusFilters.map(status => (
              <button style="padding: 8px 16px; font-size: 12px; border: 1px solid #334155; background: transparent; color: #64748b; border-radius: 8px; cursor: pointer; transition: all 0.2s;" onmouseenter="this.style.borderColor='#22d3ee'; this.style.color='#22d3ee'" onmouseleave="this.style.borderColor='#334155'; this.style.color='#64748b'">{status}</button>
            ))}
          </div>
          <div style="display: flex; gap: 12px; flex-wrap: wrap;">
            <span style="font-size: 12px; color: #64748b; padding: 8px 0; margin-right: 8px;">风险等级:</span>
            {riskFilters.map(risk => (
              <button style="padding: 8px 16px; font-size: 12px; border: 1px solid #334155; background: transparent; color: #64748b; border-radius: 8px; cursor: pointer; transition: all 0.2s;" onmouseenter="this.style.borderColor='#ef4444'; this.style.color='#ef4444'" onmouseleave="this.style.borderColor='#334155'; this.style.color='#64748b'">{risk}</button>
            ))}
          </div>
        </div>
        
        <!-- Bento Grid -->
        <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px;">
          {enterprises.map(item => (
            <a href={`/enterprise/${item.id}`} style="background: rgba(15, 23, 42, 0.8); border: 1px solid #334155; border-radius: 16px; padding: 28px; text-decoration: none; transition: all 0.3s; position: relative; overflow: hidden;" onmouseenter="this.style.borderColor='#fbbf24'; this.style.transform='translateY(-4px)'; this.style.boxShadow='0 20px 40px rgba(251, 191, 36, 0.1)'" onmouseleave="this.style.borderColor='#334155'; this.style.transform='translateY(0)'; this.style.boxShadow='none'">
              <div style={`position: absolute; top: 0; left: 0; right: 0; height: 2px; background: linear-gradient(90deg, ${getRiskColor(item.risk)}, transparent);`}></div>
              <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px;">
                <div style="display: flex; align-items: center; gap: 16px;">
                  <div style="width: 56px; height: 56px; background: linear-gradient(135deg, #fbbf24, #f59e0b); border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 28px;">🏢</div>
                  <div>
                    <div style="font-size: 20px; color: #e2e8f0; font-weight: 700;">{item.name}</div>
                    <div style="font-size: 13px; color: #64748b; margin-top: 4px;">{item.category} · {item.location}</div>
                  </div>
                </div>
                <div style="display: flex; flex-direction: column; gap: 6px; align-items: flex-end;">
                  <span style={`padding: 6px 12px; font-size: 11px; border-radius: 6px; font-weight: 600; background: rgba(${getStatusColor(item.status) === '#ef4444' ? '239, 68, 68' : getStatusColor(item.status) === '#22d3ee' ? '34, 211, 238' : '34, 197, 94'}, 0.15); color: ${getStatusColor(item.status)}; border: 1px solid rgba(${getStatusColor(item.status) === '#ef4444' ? '239, 68, 68' : getStatusColor(item.status) === '#22d3ee' ? '34, 211, 238' : '34, 197, 94'}, 0.3);`}>{item.status}</span>
                  <span style="padding: 4px 10px; font-size: 10px; border-radius: 4px; background: rgba(100, 116, 139, 0.2); color: {getRiskColor(item.risk)};">风险: {item.risk}</span>
                </div>
              </div>
              
              <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 20px;">
                <div style="background: rgba(30, 41, 59, 0.6); padding: 14px; border-radius: 10px;">
                  <div style="font-size: 11px; color: #64748b; margin-bottom: 4px;">年营收</div>
                  <div style="font-size: 16px; color: #fbbf24; font-weight: 700;">{item.revenue}</div>
                </div>
                <div style="background: rgba(30, 41, 59, 0.6); padding: 14px; border-radius: 10px;">
                  <div style="font-size: 11px; color: #64748b; margin-bottom: 4px;">员工数</div>
                  <div style="font-size: 16px; color: #e2e8f0; font-weight: 600;">{item.employees}</div>
                </div>
                <div style="background: rgba(30, 41, 59, 0.6); padding: 14px; border-radius: 10px;">
                  <div style="font-size: 11px; color: #64748b; margin-bottom: 4px;">市值</div>
                  <div style="font-size: 16px; color: #a78bfa; font-weight: 600;">{item.marketCap}</div>
                </div>
              </div>
            </a>
          ))}
        </div>
      </>
    ) : (
      <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 120px 24px; text-align: center;">
        <div style="width: 80px; height: 80px; border: 3px solid #334155; border-top-color: #fbbf24; border-radius: 50%; animation: spin 1s linear infinite; margin-bottom: 32px;"></div>
        <h2 style="font-size: 24px; color: #e2e8f0; margin-bottom: 12px;">数据正在由 P100 算力节点同步中...</h2>
        <p style="font-size: 14px; color: #64748b;">企业情报数据库正在从本地节点同步到云端</p>
        <p style="font-size: 12px; color: #475569; margin-top: 16px;">运行: python sync_and_deploy.py</p>
      </div>
    )}
    
  </div>
</div>

<style>
@keyframes spin {
  to { transform: rotate(360deg); }
}
</style>
</Layout>