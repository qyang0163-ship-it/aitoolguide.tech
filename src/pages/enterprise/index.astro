---
import Layout from '../../layouts/Layout.astro';
import TerminalBreadcrumb from '../../components/TerminalBreadcrumb.astro';

const enterprises = [
  { id: 'naura', name: '北方华创', category: '设备制造', status: '监控中', risk: '高', revenue: '¥146亿', employees: '8,500+' },
  { id: 'amec', name: '中微公司', category: '设备制造', status: '正常', risk: '中', revenue: '¥47亿', employees: '1,200+' },
  { id: 'smic', name: '中芯国际', category: '晶圆代工', status: '受限', risk: '极高', revenue: '¥452亿', employees: '18,000+' },
  { id: 'hgrace', name: '华虹半导体', category: '晶圆代工', status: '正常', risk: '低', revenue: '¥168亿', employees: '6,500+' },
  { id: 'gigadevice', name: '兆易创新', category: '芯片设计', status: '正常', risk: '低', revenue: '¥81亿', employees: '1,100+' },
  { id: 'gpixel', name: '格科微', category: '芯片设计', status: '监控中', risk: '中', revenue: '¥69亿', employees: '1,800+' },
  { id: 'nata', name: '南大光电', category: '材料供应', status: '正常', risk: '低', revenue: '¥15亿', employees: '800+' },
  { id: 'jsmc', name: '沪硅产业', category: '材料供应', status: '正常', risk: '低', revenue: '¥36亿', employees: '2,100+' },
];

const categories = ['全部', '设备制造', '晶圆代工', '芯片设计', '材料供应', 'EDA工具', '封测服务'];
const stats = { total: 247, monitored: 89, sanctioned: 34, restricted: 124 };
---
<Layout title="企业全景 | SCIP MONITOR" description="半导体企业监控数据库">
<div style="min-height: 100vh; background: #020617; font-family: 'JetBrains Mono', monospace; padding-top: 80px;">
  <div style="max-width: 1400px; margin: 0 auto; padding: 0 24px;">
    
    <TerminalBreadcrumb path={[{label: 'enterprise'}]} />
    
    <div style="margin-bottom: 32px;">
      <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 12px;">
        <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #fbbf24, #f59e0b); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 24px;">🏢</div>
        <div>
          <h1 style="font-size: 24px; color: #e2e8f0; margin: 0; font-weight: 600;">ENTERPRISE MONITOR</h1>
          <p style="font-size: 12px; color: #64748b; margin: 4px 0 0 0;">半导体企业监控全景</p>
        </div>
      </div>
    </div>
    
    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 32px;">
      <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid #1e293b; border-radius: 12px; padding: 20px;">
        <div style="font-size: 28px; font-weight: bold; color: #fbbf24; text-shadow: 0 0 10px rgba(251, 191, 36, 0.3);">{stats.total}</div>
        <div style="font-size: 12px; color: #64748b; margin-top: 4px;">监控企业</div>
      </div>
      <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid #1e293b; border-radius: 12px; padding: 20px;">
        <div style="font-size: 28px; font-weight: bold; color: #22d3ee; text-shadow: 0 0 10px rgba(34, 211, 238, 0.3);">{stats.monitored}</div>
        <div style="font-size: 12px; color: #64748b; margin-top: 4px;">重点监控</div>
      </div>
      <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid #1e293b; border-radius: 12px; padding: 20px;">
        <div style="font-size: 28px; font-weight: bold; color: #ef4444; text-shadow: 0 0 10px rgba(239, 68, 68, 0.3);">{stats.sanctioned}</div>
        <div style="font-size: 12px; color: #64748b; margin-top: 4px;">实体清单</div>
      </div>
      <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid #1e293b; border-radius: 12px; padding: 20px;">
        <div style="font-size: 28px; font-weight: bold; color: #a78bfa; text-shadow: 0 0 10px rgba(167, 139, 250, 0.3);">{stats.restricted}</div>
        <div style="font-size: 12px; color: #64748b; margin-top: 4px;">受限交易</div>
      </div>
    </div>
    
    <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid #1e293b; border-radius: 12px; padding: 20px; margin-bottom: 24px;">
      <div style="display: flex; gap: 12px; flex-wrap: wrap;">
        {categories.map(cat => (
          <button style={`padding: 8px 16px; font-size: 12px; border: 1px solid ${cat === '全部' ? '#fbbf24' : '#334155'}; background: ${cat === '全部' ? 'rgba(251, 191, 36, 0.1)' : 'transparent'}; color: ${cat === '全部' ? '#fbbf24' : '#94a3b8'}; border-radius: 6px; cursor: pointer;`}>{cat}</button>
        ))}
      </div>
      <div style="margin-top: 16px; display: flex; gap: 12px;">
        <div style="flex: 1; display: flex; align-items: center; background: #020617; border: 1px solid #334155; border-radius: 8px; padding: 0 16px;">
          <span style="color: #fbbf24; margin-right: 12px;">$</span>
          <input type="text" placeholder="search --name 中芯国际 --category 晶圆代工" style="flex: 1; background: transparent; border: none; color: #e2e8f0; padding: 12px 0; font-family: inherit; outline: none;" />
        </div>
        <button style="padding: 12px 24px; background: rgba(251, 191, 36, 0.2); border: 1px solid rgba(251, 191, 36, 0.3); color: #fbbf24; border-radius: 8px; font-size: 12px; cursor: pointer;">EXECUTE</button>
      </div>
    </div>
    
    <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px;">
      {enterprises.map(item => (
        <a href={`/enterprise/${item.id}`} style="background: rgba(15, 23, 42, 0.6); border: 1px solid #1e293b; border-radius: 12px; padding: 20px; text-decoration: none; transition: all 0.2s;" onmouseenter="this.style.borderColor='#fbbf24'; this.style.transform='translateY(-2px)'" onmouseleave="this.style.borderColor='#1e293b'; this.style.transform='translateY(0)'">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
            <div style="display: flex; align-items: center; gap: 12px;">
              <div style="width: 44px; height: 44px; background: linear-gradient(135deg, #fbbf24, #f59e0b); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 20px;">🏢</div>
              <div>
                <div style="font-size: 15px; color: #e2e8f0; font-weight: 500;">{item.name}</div>
                <div style="font-size: 11px; color: #64748b;">{item.category}</div>
              </div>
            </div>
            <div style="display: flex; flex-direction: column; gap: 4px; align-items: flex-end;">
              <span style={`padding: 4px 8px; font-size: 10px; border-radius: 4px; ${item.status === '受限' ? 'background: rgba(239, 68, 68, 0.1); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3)' : item.status === '监控中' ? 'background: rgba(34, 211, 238, 0.1); color: #22d3ee; border: 1px solid rgba(34, 211, 238, 0.3)' : 'background: rgba(34, 197, 94, 0.1); color: #22c55e; border: 1px solid rgba(34, 197, 94, 0.3)'};`}>{item.status}</span>
              <span style={`padding: 4px 8px; font-size: 10px; border-radius: 4px; background: rgba(100, 116, 139, 0.2); color: #94a3b8;`}>风险: {item.risk}</span>
            </div>
          </div>
          <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px;">
            <div style="background: rgba(30, 41, 59, 0.5); padding: 12px; border-radius: 6px;">
              <div style="font-size: 10px; color: #64748b; margin-bottom: 4px;">年营收</div>
              <div style="font-size: 14px; color: #fbbf24; font-weight: 600;">{item.revenue}</div>
            </div>
            <div style="background: rgba(30, 41, 59, 0.5); padding: 12px; border-radius: 6px;">
              <div style="font-size: 10px; color: #64748b; margin-bottom: 4px;">员工数</div>
              <div style="font-size: 14px; color: #e2e8f0; font-weight: 600;">{item.employees}</div>
            </div>
          </div>
        </a>
      ))}
    </div>
    
  </div>
</div>
</Layout>