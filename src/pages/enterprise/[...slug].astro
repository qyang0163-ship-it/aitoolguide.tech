---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  let items = [];
  try {
    const imported = await import('../../data/enterprises.json');
    items = imported.default || imported;
  } catch (e) {
    console.error(`[DATA ERROR] 无法加载企业数据: ${e.message}`);
  }
  
  if (!Array.isArray(items) || items.length === 0) {
    return [{ params: { slug: 'no-data' }, props: { item: {}, isValid: false }}];
  }
  
  return items.map((item) => ({
    params: { slug: item.id || 'unknown' },
    props: { item, isValid: true }
  }));
}

const { item, isValid } = Astro.props;
---
<Layout title={isValid ? `${item.name} | 企业详情` : '企业详情'} description="半导体企业详细信息">
<div style="min-height: 100vh; background: #020617; font-family: 'JetBrains Mono', monospace; padding-top: 80px;">
  <div style="max-width: 1200px; margin: 0 auto; padding: 0 24px;">
    
    <div style="font-size: 12px; color: #64748b; margin-bottom: 24px; padding: 12px 16px; background: rgba(15, 23, 42, 0.6); border: 1px solid #1e293b; border-radius: 8px;">
      <span style="color: #22c55e;">root@ai2424</span><span style="color: #64748b;">:</span><span style="color: #22d3ee;">~</span><span style="color: #64748b;">/</span><span style="color: #fbbf24;">enterprise</span><span style="color: #64748b;">/</span><span style="color: #fbbf24;">{isValid ? item.id : 'unknown'}</span><span style="color: #22c55e; margin-left: 4px;">_</span>
    </div>
    
    {isValid ? (
      <>
        <div style="display: flex; align-items: center; gap: 24px; margin-bottom: 32px;">
          <div style="width: 80px; height: 80px; background: linear-gradient(135deg, #fbbf24, #f59e0b); border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 40px;">🏢</div>
          <div>
            <h1 style="font-size: 36px; color: #e2e8f0; margin: 0; font-weight: 700;">{item.name}</h1>
            <p style="font-size: 16px; color: #64748b; margin: 8px 0 0 0;">{item.category}</p>
          </div>
          <div style="margin-left: auto; display: flex; flex-direction: column; gap: 8px; align-items: flex-end;">
            <span style={`padding: 8px 16px; font-size: 14px; border-radius: 8px; ${item.status === '受限' ? 'background: rgba(239, 68, 68, 0.15); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3)' : item.status === '监控中' ? 'background: rgba(34, 211, 238, 0.15); color: #22d3ee; border: 1px solid rgba(34, 211, 238, 0.3)' : 'background: rgba(34, 197, 94, 0.15); color: #22c55e; border: 1px solid rgba(34, 197, 94, 0.3)'};`}>{item.status}</span>
            <span style="padding: 4px 12px; font-size: 12px; border-radius: 4px; background: rgba(100, 116, 139, 0.2); color: #94a3b8;">风险: {item.risk}</span>
          </div>
        </div>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 32px;">
          <div style="background: rgba(15, 23, 42, 0.8); border: 1px solid #334155; border-radius: 12px; padding: 24px;">
            <h3 style="font-size: 14px; color: #64748b; margin: 0 0 16px 0; text-transform: uppercase; letter-spacing: 0.1em;">财务数据</h3>
            <div style="margin-bottom: 16px;">
              <div style="font-size: 12px; color: #64748b; margin-bottom: 4px;">年营收</div>
              <div style="font-size: 32px; color: #fbbf24; font-weight: 700;">{item.revenue}</div>
            </div>
            <div>
              <div style="font-size: 12px; color: #64748b; margin-bottom: 4px;">员工数</div>
              <div style="font-size: 24px; color: #e2e8f0; font-weight: 600;">{item.employees}</div>
            </div>
          </div>
          
          <div style="background: rgba(15, 23, 42, 0.8); border: 1px solid #334155; border-radius: 12px; padding: 24px;">
            <h3 style="font-size: 14px; color: #64748b; margin: 0 0 16px 0; text-transform: uppercase; letter-spacing: 0.1em;">监控信息</h3>
            <div style="margin-bottom: 16px;">
              <div style="font-size: 12px; color: #64748b; margin-bottom: 4px;">企业ID</div>
              <div style="font-size: 14px; color: #e2e8f0; font-family: monospace;">{item.id}</div>
            </div>
            <div>
              <div style="font-size: 12px; color: #64748b; margin-bottom: 4px;">行业分类</div>
              <div style="font-size: 14px; color: #e2e8f0;">{item.category}</div>
            </div>
          </div>
        </div>
        
        <a href="/enterprise" style="display: inline-flex; align-items: center; gap: 8px; padding: 12px 24px; background: rgba(251, 191, 36, 0.2); border: 1px solid rgba(251, 191, 36, 0.4); color: #fbbf24; border-radius: 8px; text-decoration: none; font-size: 14px;">← 返回企业全景</a>
      </>
    ) : (
      <div style="text-align: center; padding: 80px 24px;">
        <div style="font-size: 64px; margin-bottom: 24px;">⚠️</div>
        <h2 style="font-size: 24px; color: #e2e8f0; margin-bottom: 12px;">企业数据未找到</h2>
        <p style="font-size: 14px; color: #64748b; margin-bottom: 24px;">该企业ID不存在或数据正在同步中</p>
        <a href="/enterprise" style="display: inline-flex; align-items: center; gap: 8px; padding: 12px 24px; background: rgba(251, 191, 36, 0.2); border: 1px solid rgba(251, 191, 36, 0.4); color: #fbbf24; border-radius: 8px; text-decoration: none; font-size: 14px;">← 返回企业全景</a>
      </div>
    )}
    
  </div>
</div>
</Layout>