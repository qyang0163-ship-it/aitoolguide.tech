---
const { chipId, chipCategory } = Astro.props;

// 导入关联数据
const equipment = (await import('../data/equipment.json')).default;
const materials = (await import('../data/materials.json')).default;

// 查找关联设备
const relatedEquipment = equipment.filter(e => 
  e.relatedChips?.includes(chipId)
).slice(0, 2);

// 查找关联材料
const relatedMaterials = materials.filter(m => 
  m.relatedChips?.includes(chipId)
).slice(0, 2);

// 产业链穿透数据
const hasLinks = relatedEquipment.length > 0 || relatedMaterials.length > 0;
---
{hasLinks && (
<div style="background: rgba(15, 23, 42, 0.6); border: 1px solid #334155; border-radius: 12px; padding: 20px; margin-bottom: 24px;">
  <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 16px;">
    <span style="width: 6px; height: 6px; background: #22d3ee; border-radius: 50%;"></span>
    <span style="font-size: 13px; color: #22d3ee; font-weight: 600;">产业链穿透关联</span>
    <span style="font-size: 10px; color: #64748b; margin-left: auto;">SUPPLY CHAIN</span>
  </div>
  
  <!-- 上游设备 -->
  {relatedEquipment.length > 0 && (
    <div style="margin-bottom: 16px;">
      <div style="font-size: 11px; color: #64748b; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.05em;">
        🔧 制造该芯片所需设备
      </div>
      <div style="display: flex; flex-direction: column; gap: 8px;">
        {relatedEquipment.map(item => (
          <a href={`/equipment/${item.id}`} style="display: flex; align-items: center; gap: 12px; padding: 12px; background: rgba(30, 41, 59, 0.5); border: 1px solid #1e293b; border-radius: 8px; text-decoration: none; transition: all 0.2s;" onmouseenter="this.style.borderColor='#22d3ee'; this.style.background='rgba(34, 211, 238, 0.05)'" onmouseleave="this.style.borderColor='#1e293b'; this.style.background='rgba(30, 41, 59, 0.5)'">
            <div style="width: 40px; height: 40px; background: linear-gradient(135deg, #06b6d4, #2563eb); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 16px;">
              ⚙️
            </div>
            <div style="flex: 1;">
              <div style="font-size: 13px; color: #e2e8f0; margin-bottom: 2px;">{item.name}</div>
              <div style="font-size: 10px; color: #64748b;">{item.manufacturer} · {item.category}</div>
            </div>
            <div style="font-size: 11px; color: #fbbf24; font-weight: 500;">{item.price}</div>
          </a>
        ))}
      </div>
    </div>
  )}
  
  <!-- 配套材料 -->
  {relatedMaterials.length > 0 && (
    <div>
      <div style="font-size: 11px;