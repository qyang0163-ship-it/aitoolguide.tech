---
const { manufacturer, chipName, chipId } = Astro.props;

// 加载关联数据
const relations = await import('../data/relations.json');
const relData = relations.default || relations;

// 获取关联设备
const equipment = relData.equipment?.[manufacturer] || [];
const materials = relData.materials?.[manufacturer] || [];
const eda = relData.eda?.[manufacturer] || [];
const upstream = relData.upstream?.[chipName] || [];
const downstream = relData.downstream?.[chipName] || [];

const hasRelations = equipment.length > 0 || materials.length > 0 || eda.length > 0 || upstream.length > 0 || downstream.length > 0;
---
{hasRelations && (
<div style="background: rgba(15, 23, 42, 0.6); border: 1px solid #334155; border-radius: 12px; padding: 20px; margin-top: 24px;">
<div style="display: flex; align-items: center; gap: 8px; margin-bottom: 16px;">
<span style="font-size: 16px;">🔗</span>
<span style="font-size: 14px; color: #22d3ee; font-weight: 600;">产业链穿透关联</span>
<span style="font-size: 11px; color: #64748b; margin-left: auto;">自动推荐</span>
</div>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px;">

{/* 制造设备 */}
{equipment.length > 0 && (
<div style="background: rgba(30, 41, 59, 0.5); border: 1px solid #1e293b; border-radius: 8px; padding: 16px;">
<div style="font-size: 11px; color: #64748b; margin-bottom: 12px; display: flex; align-items: center; gap: 6px;">
<span>🏭</span>
<span>制造该芯片所需设备</span>
</div>
<div style="display: flex; flex-direction: column; gap: 8px;">
{equipment.map((item, i) => (
<a href={`/equipment/${item.toLowerCase().replace(/[^a-z0-9-]/g, '-')}`} style="display: flex; align-items: center; gap: 8px; padding: 8px; background: rgba(15, 23, 42, 0.5); border-radius: 6px; text-decoration: none; transition: all 0.15s; border: 1px solid transparent;" onmouseenter="this.style.borderColor='#22d3ee'; this.style.background='rgba(34, 211, 238, 0.05)'" onmouseleave="this.style.borderColor='transparent'; this.style.background='rgba(15, 23, 42, 0.5)'">
<span style="font-size: 14px;">⚙️</span>
<span style="font-size: 12px; color: #e2e8f0; flex: 1;">{item}</span>
<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2">
<path d="M9 18l6-6-6-6"/>
</svg>
</a>
))}
</div>
</div>
)}

{/* 配套材料 */}
{materials.length > 0 && (
<div style="background: rgba(30, 41, 59, 0.5); border: 1px solid #1e293b; border-radius: 8px; padding: 16px;">
<div style="font-size: 11px; color: #64748b; margin-bottom: 12px; display: flex; align-items: center; gap: 6px;">
<span>🧪</span>
<span>配套国产材料</span>
</div>
<div style="display: flex; flex-direction: column; gap: 8px;">
{materials.map((item, i) => (
<a href={`/materials/${item.toLowerCase().replace(/[^a-z0-9-]/g, '-')}`} style="display: flex; align-items: center; gap: 8px; padding: 8px; background: rgba(15, 23, 42, 0.5); border-radius: 6px; text-decoration: none; transition: all 0.15s; border: 1px solid transparent;" onmouseenter="this.style.borderColor='#22d3ee'; this.style.background='rgba(34, 211, 238, 0.05)'" onmouseleave="this.style.borderColor='transparent'; this.style.background='rgba(15, 23, 42, 0.5)'">
<span style="font-size: 14px;">💎</span>
<span style="font-size: 12px; color: #e2e8f0; flex: 1;">{item}</span>
<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2">
<path d="M9 18l6-6-6-6"/>
</svg>
</a>
))}
</div>
</div>
)}

{/* EDA工具 */}
{eda.length > 0 && (
<div style="background: rgba(30, 41, 59, 0.5); border: 1px solid #1e293b; border-radius: 8px; padding: 16px;">
<div style="font-size: 11px; color: #64748b; margin-bottom: 12px; display: flex; align-items: center; gap: 6px;">
<span>💻</span>
<span>设计工具链</span>
</div>
<div style="display: flex; flex-direction: column; gap: 8px;">
{eda.map((item, i) => (
<a href={`/eda-ip/${item.toLowerCase().replace(/[^a-z0-9-]/g, '-')}`} style="display: flex; align-items: center; gap: 8px; padding: 8px; background: rgba(15, 23, 42, 0.5); border-radius: 6px; text-decoration: none; transition: all 0.15s; border: 1px solid transparent;" onmouseenter="this.style.borderColor='#22d3ee'; this.style.background='rgba(34, 211, 238, 0.05)'" onmouseleave="this.style.borderColor='transparent'; this.style.background='rgba(15, 23, 42, 0.5)'">
<span style="font-size: 14px;">🔧</span>
<span style="font-size: 12px; color: #e2e8f0; flex: 1;">{item}</span>
<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2">
<path d="M9 18l6-6-6-6"/>
</svg>
</a>
))}
</div>
</div>
)}

{/* 上游替代 */}
{upstream.length > 0 && (
<div style="background: rgba(30, 41, 59, 0.5); border: 1px solid #1e293b; border-radius: 8px; padding: 16px;">
<div style="font-size: 11px; color: #64748b; margin-bottom: 12px; display: flex; align-items: center; gap: 6px;">
<span>⬆️</span>
<span>上游替代方案</span>
</div>
<div style="display: flex; flex-direction: column; gap: 8px;">
{upstream.map((item, i) => (
<a href={`/chips/${item.toLowerCase().replace(/[^a-z0-9-]/g, '-')}`} style="display: flex; align-items: center; gap: 8px; padding: 8px; background: rgba(15, 23, 42, 0.5); border-radius: 6px; text-decoration: none; transition: all 0.15s; border: 1px solid transparent;" onmouseenter="this.style.borderColor='#22d3ee'; this.style.background='rgba(34, 211, 238, 0.05)'" onmouseleave="this.style.borderColor='transparent'; this.style.background='rgba(15, 23, 42, 0.5)'">
<span style="font-size: 14px;">🔀</span>
<span style="font-size: 12px; color: #e2e8f0; flex: 1;">{item}</span>
<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2">
<path d="M9 18l6-6-6-6"/>
</svg>
</a>
))}
</div>
</div>
)}

{/* 下游应用 */}
{downstream.length > 0 && (
<div style="background: rgba(30, 41, 59, 0.5); border: 1px solid #1e293b; border-radius: 8px; padding: 16px;">
<div style="font-size: 11px; color: #64748b; margin-bottom: 12px; display: flex; align-items: center; gap: 6px;">
<span>⬇️</span>
<span>典型应用场景</span>
</div>
<div style="display: flex; flex-wrap: wrap; gap: 8px;">
{downstream.map((item, i) => (
<span style="padding: 6px 12px; background: rgba(34, 197, 94, 0.1); border: 1px solid rgba(34, 197, 94, 0.2); border-radius: 4px; font-size: 11px; color: #22c55e;">
{item}
</span>
))}
</div>
</div>
)}

</div>
</div>
)}