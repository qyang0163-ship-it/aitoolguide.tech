---
const chips = (await import('../data/chips.json')).default;

// 预处理搜索数据
const searchIndex = chips.map(chip => ({
  id: chip.id,
  name: chip.name,
  manufacturer: chip.manufacturer,
  original: chip.originalEquivalent,
  category: chip.processNode?.includes('AI') ? 'AI芯片' : 
            chip.processNode?.includes('模拟') ? '模拟' : 'MCU',
  icon: getManufacturerIcon(chip.manufacturer),
  highlight: getHighlightText(chip)
}));

function getManufacturerIcon(manufacturer) {
  const iconMap = {
    '极海半导体': '🔷',
    '兆易创新': '🔶',
    '华为海思': '🔴',
    '寒武纪': '🟣',
    '摩尔线程': '🟢',
    '圣邦微': '🟡',
    '雅特力': '🔵',
    '乐鑫科技': '📶',
    '沁恒微': '⚡',
    '灵动微': '💫'
  };
  return iconMap[manufacturer] || '💠';
}

function getHighlightText(chip) {
  if (chip.substituteLevel === 'pin2pin') {
    return { text: 'P2P完美替代', color: '#22c55e' };
  } else if (chip.substituteLevel === 'functional') {
    return { text: '功能级替代', color: '#22d3ee' };
  }
  return { text: '替代方案', color: '#fbbf24' };
}
---
<div class="smart-search-container" style="position: relative; width: 100%; max-width: 600px;">
<div style="position: relative;">
<span style="position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: #22d3ee; font-size: 14px;">$</span>
<input 
      type="text" 
      id="smartSearchInput"
      placeholder="输入型号、厂商或设备，检索国产替代路径..."
      style="width: 100%; padding: 14px 16px 14px 40px; background: rgba(15, 23, 42, 0.8); border: 1px solid #334155; border-radius: 8px; color: #e2e8f0; font-family: 'JetBrains Mono', monospace; font-size: 14px; outline: none; transition: all 0.2s;"
      onfocus="this.style.borderColor='#22d3ee'; this.style.boxShadow='0 0 20px rgba(34, 211, 238, 0.1)'; showSearchSuggestions();"
      onblur="hideSearchSuggestions();"
      oninput="filterSearchSuggestions(this.value)"
    />
<button style="position: absolute; right: 8px; top: 50%; transform: translateY(-50%); padding: 8px 16px; background: linear-gradient(135deg, #22d3ee, #0ea5e9); color: #020617; border: none; border-radius: 6px; font-size: 12px; font-weight: bold; cursor: pointer;">
      EXECUTE
    </button>
</div>

<!-- 智能联想下拉 -->
<div id="searchSuggestions" style="display: none; position: absolute; top: 100%; left: 0; right: 0; margin-top: 8px; background: rgba(15, 23, 42, 0.98); border: 1px solid #334155; border-radius: 8px; padding: 8px; z-index: 100; max-height: 320px; overflow-y: auto; box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);">
{searchIndex.slice(0, 8).map(item => (
<div class="search-suggestion-item" style="padding: 12px; border-radius: 6px; cursor: pointer; display: flex; align-items: center; gap: 12px; transition: all 0.15s;" onmouseenter="this.style.background='rgba(34, 211, 238, 0.1)'; this.style.borderLeft='3px solid #22d3ee'; this.style.paddingLeft='9px';" onmouseleave="this.style.background='transparent'; this.style.borderLeft='none'; this.style.paddingLeft='12px';" onclick={`window.location.href='/chips/${item.id}'`}>
<div style="width: 36px; height: 36px; background: rgba(30, 41, 59, 0.8); border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 16px;">
{item.icon}
</div>
<div style="flex: 1;">
<div style="display: flex; align-items: center; gap: 8px; margin-bottom: 2px;">
<span style="color: #e2e8f0; font-size: 13px; font-weight: 500;">{item.name}</span>
<span style={`font-size: 10px; padding: 2px 6px; border-radius: 3px; background: ${item.highlight.color}20; color: ${item.highlight.color}; border: 1px solid ${item.highlight.color}40;`}>
{item.highlight.text}
</span>
</div>
<div style="color: #64748b; font-size: 11px;">
{item.manufacturer} · 替代 {item.original}
</div>
</div>
<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2">
<path d="M9 18l6-6-6-6"/>
</svg>
</div>
))}
<div style="padding: 12px; border-top: 1px solid #1e293b; margin-top: 8px;">
<div style="color: #64748b; font-size: 11px; margin-bottom: 8px;">热门搜索</div>
<div style="display: flex; gap: 8px; flex-wrap: wrap;">
{['#STM32替代', '#昇腾910B', '#P100解锁', '#实体清单'].map(tag => (
<span style="padding: 4px 10px; background: rgba(30, 41, 59, 0.5); border: 1px solid #334155; border-radius: 4px; font-size: 11px; color: #94a3b8; cursor: pointer; transition: all 0.15s;" onmouseenter="this.style.borderColor='#22d3ee'; this.style.color='#22d3ee'" onmouseleave="this.style.borderColor='#334155'; this.style.color='#94a3b8'">{tag}</span>
))}
</div>
</div>
</div>
</div>

<script is:inline>
  const searchData = JSON.parse(document.getElementById('searchData')?.textContent || '[]');
  
  function showSearchSuggestions() {
    const suggestions = document.getElementById('searchSuggestions');
    if (suggestions) {
      suggestions.style.display = 'block';
    }
  }
  
  function hideSearchSuggestions() {
    // 延迟隐藏，允许点击建议项
    setTimeout(() => {
      const input = document.getElementById('smartSearchInput');
      const suggestions = document.getElementById('searchSuggestions');
      if (suggestions && input && input !== document.activeElement) {
        suggestions.style.display = 'none';
      }
    }, 200);
  }
  
  function filterSearchSuggestions(query) {
    // 实际项目中这里会过滤 searchData
    console.log('Filtering:', query);
  }
  
  // 键盘导航
  document.getElementById('smartSearchInput')?.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      document.getElementById('searchSuggestions').style.display = 'none';
    }
  });
</script>

<script type="application/json" id="searchData" set:html={JSON.stringify(searchIndex)}></script>