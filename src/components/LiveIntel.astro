---
const intelItems = [
  { time: '16:14', content: '某国产 14nm 刻蚀机通过中芯验证', type: 'success', source: '产线' },
  { time: '16:08', content: '华为昇腾 910C 完成与 DeepSeek V4 全栈适配', type: 'info', source: '厂商' },
  { time: '15:52', content: 'BIS 新增 3 家实体清单企业，涉及光刻胶材料', type: 'alert', source: '管制' },
  { time: '15:35', content: '长江存储 232 层 NAND 良率突破 92%', type: 'success', source: '产线' },
  { time: '15:21', content: '中微公司 5nm 刻蚀设备获头部晶圆厂订单', type: 'info', source: '厂商' },
  { time: '14:48', content: '国产 ArF 光刻胶通过客户验证，预计 Q3 量产', type: 'success', source: '材料' },
  { time: '14:32', content: '海关总署更新半导体设备进口管制清单', type: 'alert', source: '政策' },
  { time: '14:15', content: '寒武纪思元 590 芯片性能对标 H100', type: 'info', source: '厂商' },
];
---
<div style="background: #0f172a; border: 1px solid #1e293b; border-radius: 12px; padding: 16px; height: 280px; overflow: hidden; position: relative;">
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; padding-bottom: 12px; border-bottom: 1px solid #1e293b;">
<div style="display: flex; align-items: center; gap: 8px;">
<span style="width: 6px; height: 6px; background: #22c55e; border-radius: 50%; animation: pulse 2s infinite;"></span>
<span style="color: #22c55e; font-size: 11px; font-weight: 600; letter-spacing: 0.1em;">LIVE INTEL</span>
</div>
<span style="font-size: 10px; color: #64748b;">实时情报流</span>
</div>
<div style="display: flex; flex-direction: column; gap: 10px;">
{intelItems.map((item, i) => (
<div style="display: flex; align-items: flex-start; gap: 12px; padding: 8px; border-radius: 6px; transition: background 0.2s;" onmouseenter="this.style.background='rgba(30, 41, 59, 0.5)'" onmouseleave="this.style.background='transparent'">
<div style="display: flex; flex-direction: column; align-items: center; gap: 4px;">
<span style="font-size: 10px; color: #64748b; font-family: 'JetBrains Mono', monospace;">{item.time}</span>
<span style={`width: 2px; flex: 1; min-height: 20px; background: ${item.type === 'success' ? 'rgba(34, 197, 94, 0.3)' : item.type === 'alert' ? 'rgba(244, 63, 94, 0.3)' : 'rgba(34, 211, 238, 0.3)'}; border-radius: 1px;`}></span>
</div>
<div style="flex: 1;">
<div style="font-size: 12px; color: #e2e8f0; line-height: 1.4; margin-bottom: 4px;">{item.content}</div>
<div style="display: flex; gap: 8px;">
<span style={`font-size: 9px; padding: 2px 6px; border-radius: 3px; ${item.type === 'success' ? 'background: rgba(34, 197, 94, 0.1); color: #22c55e; border: 1px solid rgba(34, 197, 94, 0.2);' : item.type === 'alert' ? 'background: rgba(244, 63, 94, 0.1); color: #f43f5e; border: 1px solid rgba(244, 63, 94, 0.2);' : 'background: rgba(34, 211, 238, 0.1); color: #22d3ee; border: 1px solid rgba(34, 211, 238, 0.2);'}`}>
{item.type === 'success' ? '替代进展' : item.type === 'alert' ? '管制预警' : '厂商动态'}
</span>
<span style="font-size: 9px; color: #64748b;">{item.source}</span>
</div>
</div>
</div>
))}
</div>
<style>
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}
</style>
</div>