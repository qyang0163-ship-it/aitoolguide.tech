---
export interface Props { title: string; description: string; keywords?: string; }
const { title, description, keywords } = Astro.props;
---
<!DOCTYPE html><html lang="zh-CN">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title><meta name="description" content={description}>
{keywords && <meta name="keywords" content={keywords}>}
<script src="https://cdn.tailwindcss.com"></script>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
body{font-family:'Inter',system-ui,sans-serif;background:#F8FAFC;color:#1E293B;line-height:1.7;font-size:18px;margin:0}
.nav-gradient{background:linear-gradient(135deg,#0F4C81,#2B6CB0)}
.card{background:#fff;border-radius:12px;border:1px solid #E2E8F0;box-shadow:0 1px 3px rgba(0,0,0,.04);padding:24px;transition:box-shadow .2s}
.card:hover{box-shadow:0 4px 12px rgba(0,0,0,.06)}
.btn-primary{background:#E48736;color:#fff;font-weight:600;padding:12px 24px;border-radius:8px;border:none;display:inline-block;text-decoration:none}
.btn-primary:hover{background:#C96E2C}
.btn-secondary{border:2px solid #0F4C81;color:#0F4C81;font-weight:600;padding:10px 22px;border-radius:8px;display:inline-block;text-decoration:none}
.btn-secondary:hover{background:#0F4C81;color:#fff}
.badge{display:inline-block;padding:2px 10px;border-radius:12px;font-size:.75rem;font-weight:600}
.badge-green{background:#DEF7EC;color:#03543F}
.badge-blue{background:#E0F2FE;color:#075985}
table{width:100%;border-collapse:collapse}
th{text-align:left;font-weight:600;color:#475569;padding:12px 8px;border-bottom:2px solid #E2E8F0}
td{padding:12px 8px;border-bottom:1px solid #F1F5F9}
tr:nth-child(even){background:#F8FAFC}tr:hover{background:#F1F5F9}
.breadcrumb{font-size:.875rem;color:#64748B}.breadcrumb a{color:#0F4C81;text-decoration:none}
.progress-bar{height:8px;background:#E2E8F0;border-radius:4px;overflow:hidden}.progress-fill{height:100%;border-radius:4px}
.search-input{max-width:480px;padding:12px 20px;border:1px solid #CBD5E1;border-radius:8px;font-size:16px}
.search-input:focus{outline:none;border-color:#0F4C81;box-shadow:0 0 0 3px rgba(15,76,129,.1)}
</style>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"Organization","name":"AI芯片替代指南","url":"https://www.ai2424.com"}</script>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"WebSite","url":"https://www.ai2424.com","potentialAction":{"@type":"SearchAction","target":"https://www.ai2424.com/search?q={search_term_string}","query-input":"required name=search_term_string"}}</script>
</head>
<body>
<nav class="nav-gradient text-white fixed top-0 w-full z-50 shadow-md" style="height:60px"><div class="max-w-7xl mx-auto flex justify-between items-center h-full px-4">
<a href="/" class="text-2xl font-bold">AI替代指南</a>
<div class="space-x-6 text-sm font-medium hidden md:flex">
<a href="/" class="hover:text-orange-200">首页</a><a href="/chips" class="hover:text-orange-200">芯片库</a><a href="/timeline" class="hover:text-orange-200">时间线</a><a href="/policy" class="hover:text-orange-200">政策库</a><a href="/restricted" class="hover:text-orange-200">受限追踪</a>
</div></div></nav>
<main style="padding-top:80px;min-height:calc(100vh - 60px)"><slot /></main>
<footer class="bg-white border-t mt-12 py-6 text-center text-sm text-slate-500"><p>© 2026 AI芯片替代指南 · 数据仅供参考</p></footer>
</body></html>