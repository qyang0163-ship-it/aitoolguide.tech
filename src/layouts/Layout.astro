---
interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const { title, description = "国产芯片替代数据库平台 - 专业级元器件替代方案查询系统", lang = 'zh-CN' } = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang={lang} dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="description" content={description} />
  <meta name="keywords" content="国产芯片替代,芯片国产化,P2P兼容,元器件替代,兆易创新,STM32替代,国产MCU,国产ADC,国产电源芯片" />
  <meta name="author" content="ChipAltDB Team" />
  <meta name="robots" content="index, follow" />
  <meta name="googlebot" content="index, follow" />
  <meta name="bingbot" content="index, follow" />
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={`https://www.ai2424.com${currentPath}`} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://www.ai2424.com/chip-alt-og.jpg" />
  <meta property="og:locale" content="zh_CN" />
  
  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={`https://www.ai2424.com${currentPath}`} />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />
  <meta property="twitter:image" content="https://www.ai2424.com/chip-alt-og.jpg" />
  
  <!-- Canonical URL -->
  <link rel="canonical" href={`https://www.ai2424.com${currentPath}`} />
  
  <!-- Structured Data -->
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "ChipAltDB",
    "url": "https://www.ai2424.com",
    "description": "国产芯片替代数据库平台 - 专业级元器件替代方案查询系统",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://www.ai2424.com/search?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  }
  </script>
  
  <meta name="viewport" content="width=device-width" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com" is:inline></script>
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            space: {
              900: '#0a0e14',
              800: '#111827',
              700: '#1a2234',
              600: '#243044',
              500: '#3d4f6f',
            },
            industrial: {
              500: '#2563eb',
              400: '#3b82f6',
              300: '#60a5fa',
              600: '#1d4ed8',
            },
            oem: {
              500: '#059669',
              400: '#10b981',
              300: '#34d399',
              600: '#047857',
            },
            alert: {
              amber: '#f59e0b',
              red: '#dc2626',
              orange: '#ea580c',
            }
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'],
            mono: ['JetBrains Mono', 'Consolas', 'monospace'],
          }
        }
      }
    }
  </script>
  
  <!-- Google Analytics (GA4) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-14213142037" is:inline></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-14213142037');
  </script>
  
  <style is:global>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
    .font-mono {
      font-family: 'JetBrains Mono', Consolas, monospace;
    }
  </style>
</head>
<body class="bg-gray-900 text-gray-100 antialiased min-h-screen">
  <slot />
</body>
</html>
